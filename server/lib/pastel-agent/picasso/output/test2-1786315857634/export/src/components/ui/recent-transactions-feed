// RecentTransactionsFeed.tsx — Scrollable money activity feed for reviewing recent Wavelength spending. Use on dashboard surfaces where transaction history needs a quick, scannable view.
import React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const recentTransactionsFeedVariants = cva(
  "w-full overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] font-[var(--font-body)] text-[var(--color-text-primary)]",
  {
    variants: {
      layout: {
        list: "max-w-full",
        compact: "max-w-full",
      },
      sortOrder: {
        newest: "",
        oldest: "",
      },
    },
    defaultVariants: {
      layout: "list",
      sortOrder: "newest",
    },
  }
);

const transactionRowVariants = cva(
  "group flex w-full items-center gap-[var(--space-3)] border-b border-[var(--color-border-subtle)] text-left transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-raised)] disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      layout: {
        list: "min-h-[var(--control-lg)] px-[var(--space-4)] py-[var(--space-3)] hover:bg-[var(--color-neutral-50)] active:bg-[var(--color-neutral-100)]",
        compact:
          "min-h-[var(--control-md)] px-[var(--space-3)] py-[var(--space-2)] hover:bg-[var(--color-neutral-50)] active:bg-[var(--color-neutral-100)]",
      },
    },
    defaultVariants: {
      layout: "list",
    },
  }
);

export interface RecentTransaction {
  id: string;
  merchant: string;
  category: string;
  amount: number;
  timestamp: Date;
  icon: string;
}

export interface RecentTransactionsFeedProps
  extends React.HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof recentTransactionsFeedVariants> {
  transactions: RecentTransaction[];
  currency?: string;
  onTransactionClick?: (transactionId: string) => void;
  isLoading?: boolean;
  maxItems?: number;
}

function formatTransactionDate(timestamp: Date) {
  return new Intl.DateTimeFormat(undefined, {
    month: "short",
    day: "numeric",
    hour: "numeric",
    minute: "2-digit",
  }).format(timestamp);
}

function formatTransactionAmount(amount: number, currency: string) {
  const formattedAmount = new Intl.NumberFormat(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(Math.abs(amount));

  return `${amount < 0 ? "-" : "+"}${currency ? `${currency} ` : ""}${formattedAmount}`;
}

export default function RecentTransactionsFeed({
  className,
  layout,
  sortOrder,
  transactions,
  currency = "",
  onTransactionClick,
  isLoading = false,
  maxItems = 8,
  ...props
}: RecentTransactionsFeedProps) {
  const visibleTransactions = [...transactions]
    .sort((first, second) => {
      const difference =
        first.timestamp.getTime() - second.timestamp.getTime();

      return sortOrder === "oldest" ? difference : -difference;
    })
    .slice(0, maxItems);

  return (
    <section
      className={cn(
        recentTransactionsFeedVariants({ layout, sortOrder }),
        className
      )}
      aria-busy={isLoading}
      aria-label="Recent transactions"
      {...props}
    >
      <div className="flex items-center justify-between gap-[var(--space-3)] border-b border-[var(--color-border-default)] px-[var(--space-4)] py-[var(--space-3)]">
        <div>
          <h2 className="font-[var(--font-display)] text-[var(--text-lg)] font-[var(--weight-semibold)]">
            Recent transactions
          </h2>
          <p className="mt-[var(--space-1)] text-[var(--text-sm)] text-[var(--color-text-muted)]">
            Your latest money moves
          </p>
        </div>
        {isLoading && (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin [animation-duration:var(--duration-slow)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-label="Loading transactions"
            role="status"
          >
            <circle
              cx="12"
              cy="12"
              r="9"
              stroke="var(--color-border-default)"
              strokeWidth="3"
            />
            <path
              d="M12 3a9 9 0 0 1 9 9"
              stroke="var(--color-accent-500)"
              strokeWidth="3"
              strokeLinecap="round"
            />
          </svg>
        )}
      </div>

      {isLoading ? (
        <div className="space-y-[var(--space-2)] px-[var(--space-4)] py-[var(--space-4)]">
          {[1, 2, 3].map((item) => (
            <div
              key={item}
              className="flex items-center gap-[var(--space-3)] py-[var(--space-2)]"
              aria-hidden="true"
            >
              <div className="h-[var(--control-md)] w-[var(--control-md)] rounded-[var(--radius-md)] bg-[var(--color-neutral-100)]" />
              <div className="min-w-0 flex-1 space-y-[var(--space-1)]">
                <div className="h-[var(--space-2)] w-2/5 rounded-[var(--radius-sm)] bg-[var(--color-neutral-100)]" />
                <div className="h-[var(--space-2)] w-1/3 rounded-[var(--radius-sm)] bg-[var(--color-neutral-100)]" />
              </div>
              <div className="h-[var(--space-2)] w-1/5 rounded-[var(--radius-sm)] bg-[var(--color-neutral-100)]" />
            </div>
          ))}
        </div>
      ) : visibleTransactions.length === 0 ? (
        <div className="px-[var(--space-4)] py-[var(--space-6)]">
          <p className="text-[var(--text-base)] font-[var(--weight-medium)] text-[var(--color-text-secondary)]">
            No transactions recorded yet
          </p>
          <p className="mt-[var(--space-1)] text-[var(--text-sm)] text-[var(--color-text-muted)]">
            Transactions will show up here as you spend.
          </p>
        </div>
      ) : (
        <div>
          {visibleTransactions.map((transaction) => {
            const isIncome = transaction.amount >= 0;

            return (
              <button
                key={transaction.id}
                type="button"
                className={cn(transactionRowVariants({ layout }))}
                onClick={() => onTransactionClick?.(transaction.id)}
                disabled={!onTransactionClick}
                aria-label={`${transaction.merchant}, ${formatTransactionAmount(
                  transaction.amount,
                  currency
                )}, ${formatTransactionDate(transaction.timestamp)}`}
              >
                <span
                  className="flex h-[var(--control-md)] w-[var(--control-md)] shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-accent-50)] text-[var(--text-lg)]"
                  aria-hidden="true"
                >
                  {transaction.icon}
                </span>

                <span className="min-w-0 flex-1">
                  <span className="block truncate text-[var(--text-base)] font-[var(--weight-medium)]">
                    {transaction.merchant}
                  </span>
                  <span className="mt-[var(--space-1)] block truncate text-[var(--text-sm)] text-[var(--color-text-muted)]">
                    {transaction.category} ·{" "}
                    {formatTransactionDate(transaction.timestamp)}
                  </span>
                </span>

                <span
                  className={cn(
                    "shrink-0 font-[var(--font-mono)] text-[var(--text-sm)] font-[var(--weight-semibold)] tabular-nums",
                    isIncome
                      ? "text-[var(--color-success-500)]"
                      : "text-[var(--color-text-primary)]"
                  )}
                >
                  {formatTransactionAmount(transaction.amount, currency)}
                </span>
              </button>
            );
          })}
        </div>
      )}
    </section>
  );
}