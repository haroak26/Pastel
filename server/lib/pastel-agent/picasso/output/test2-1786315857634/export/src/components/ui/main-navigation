// MainNavigation.tsx — Primary Wavelength navigation for moving between budgeting views. Use in the app sidebar or top-level navigation shell.
import * as React from "react";
import * as NavigationMenu from "@radix-ui/react-navigation-menu";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const navigationItemVariants = cva(
  "group inline-flex h-[var(--control-md)] w-full items-center gap-[var(--space-3)] rounded-[var(--radius-md)] px-[var(--space-3)] font-[var(--font-body)] text-[var(--weight-medium)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:scale-[0.98] disabled:pointer-events-none disabled:opacity-50 data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50",
  {
    variants: {
      active: {
        true: "bg-[var(--color-accent-50)] text-[var(--color-accent-900)] hover:bg-[var(--color-accent-100)] active:bg-[var(--color-accent-100)]",
        false:
          "text-[var(--color-text-secondary)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)]",
      },
    },
    defaultVariants: {
      active: false,
    },
  }
);

export interface MainNavigationItem {
  id: string;
  label: string;
  href: string;
  icon: string;
}

export interface MainNavigationProps
  extends VariantProps<typeof navigationItemVariants> {
  items: MainNavigationItem[];
  activeItemId: string;
  onItemClick: (itemId: string) => void;
  loading?: boolean;
  className?: string;
}

export default function MainNavigation({
  items,
  activeItemId,
  onItemClick,
  loading = false,
  className,
}: MainNavigationProps) {
  return (
    <nav
      aria-label="Primary navigation"
      aria-busy={loading}
      className={cn("w-full font-[var(--font-body)]", className)}
    >
      <NavigationMenu.Root orientation="vertical" className="w-full">
        <NavigationMenu.List className="flex w-full flex-col gap-[var(--space-1)]">
          {items.map((item) => {
            const isActive = item.id === activeItemId;

            return (
              <NavigationMenu.Item key={item.id} className="w-full">
                <NavigationMenu.Link
                  href={item.href}
                  active={isActive}
                  aria-current={isActive ? "page" : undefined}
                  aria-disabled={loading}
                  data-disabled={loading}
                  className={cn(
                    navigationItemVariants({ active: isActive })
                  )}
                  onClick={(event) => {
                    if (loading) {
                      event.preventDefault();
                      return;
                    }

                    onItemClick(item.id);
                  }}
                >
                  {loading ? (
                    <svg
                      className="h-4 w-4 animate-spin"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <circle
                        className="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        strokeWidth="4"
                      />
                      <path
                        className="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                      />
                    </svg>
                  ) : (
                    <span
                      aria-hidden="true"
                      className="inline-flex h-5 w-5 items-center justify-center text-base leading-none"
                    >
                      {item.icon}
                    </span>
                  )}
                  <span>{item.label}</span>
                </NavigationMenu.Link>
              </NavigationMenu.Item>
            );
          })}
        </NavigationMenu.List>
      </NavigationMenu.Root>
    </nav>
  );
}