// ModalHeader.tsx — Modal title row with a branded close action. Use at the top of Wavelength dialogs that need a clear title and dismiss control.
import * as Dialog from "@radix-ui/react-dialog";
import { cva, type VariantProps } from "class-variance-authority";
import type { ButtonHTMLAttributes } from "react";
import { cn } from "../lib/cn";

const modalHeaderVariants = cva(
  "flex items-center justify-between gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] px-[var(--space-6)] py-[var(--space-4)]",
  {}
);

const closeButtonVariants = cva(
  "inline-flex h-[var(--control-sm)] w-[var(--control-sm)] items-center justify-center rounded-[var(--radius-md)] text-[var(--color-text-muted)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {}
);

export interface ModalHeaderProps
  extends VariantProps<typeof modalHeaderVariants> {
  title: string;
  onClose: () => void;
  loading?: boolean;
  className?: string;
  closeButtonProps?: Omit<
    ButtonHTMLAttributes<HTMLButtonElement>,
    "onClick" | "children" | "aria-label"
  >;
}

export default function ModalHeader({
  title,
  onClose,
  loading = false,
  className,
  closeButtonProps,
}: ModalHeaderProps) {
  return (
    <Dialog.Header className={cn(modalHeaderVariants(), className)}>
      <Dialog.Title className="font-[var(--font-display)] text-xl font-[var(--weight-semibold)] leading-[var(--space-6)] text-[var(--color-text-primary)]">
        {title}
      </Dialog.Title>

      <Dialog.Close asChild>
        <button
          type="button"
          className={cn(closeButtonVariants(), closeButtonProps?.className)}
          onClick={onClose}
          disabled={loading || closeButtonProps?.disabled}
          aria-label={`Close ${title}`}
          aria-busy={loading}
          {...closeButtonProps}
        >
          {loading ? (
            <svg
              className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                className="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                strokeWidth="4"
              />
              <path
                className="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
              />
            </svg>
          ) : (
            <svg
              className="h-[var(--space-4)] w-[var(--space-4)]"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
              strokeLinejoin="round"
              aria-hidden="true"
            >
              <path d="M6 6l12 12" />
              <path d="M18 6L6 18" />
            </svg>
          )}
        </button>
      </Dialog.Close>
    </Dialog.Header>
  );
}