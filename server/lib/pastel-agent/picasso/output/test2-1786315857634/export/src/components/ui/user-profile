// UserProfile.tsx — Sidebar identity control for opening a user's profile and account settings.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const userProfileVariants = cva(
  "inline-flex items-center rounded-[var(--radius-md)] font-[var(--font-body)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      slot: {
        profile:
          "min-w-0 flex-1 gap-[var(--space-3)] px-[var(--space-2)] py-[var(--space-2)] text-left text-[var(--color-text-primary)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)]",
        settings:
          "h-[var(--control-md)] w-[var(--control-md)] justify-center text-[var(--color-text-secondary)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)]",
      },
    },
    defaultVariants: {
      slot: "profile",
    },
  }
);

export interface UserProfileProps
  extends React.HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof userProfileVariants> {
  avatar: string;
  name: string;
  onSettingsClick: () => void;
  onProfileClick?: () => void;
  loading?: boolean;
}

export default function UserProfile({
  avatar,
  name,
  onSettingsClick,
  onProfileClick,
  loading = false,
  className,
  ...props
}: UserProfileProps) {
  return (
    <div
      className={cn(
        "flex items-center gap-[var(--space-2)] border-t border-[var(--color-border-subtle)] pt-[var(--space-3)]",
        className
      )}
      {...props}
    >
      <button
        type="button"
        className={cn(
          userProfileVariants({ slot: "profile" }),
          loading && "pointer-events-none opacity-50"
        )}
        onClick={onProfileClick}
        disabled={loading || !onProfileClick}
        aria-busy={loading}
        aria-label={`Open ${name}'s profile`}
      >
        <img
          src={avatar}
          alt={`${name}'s avatar`}
          className="h-[var(--control-md)] w-[var(--control-md)] shrink-0 rounded-[var(--radius-full)] object-cover"
        />
        <span
          className="min-w-0 truncate font-[var(--weight-semibold)]"
          style={{ font: "var(--text-sm) var(--font-body)" }}
        >
          {name}
        </span>
      </button>

      <button
        type="button"
        className={cn(
          userProfileVariants({ slot: "settings" }),
          loading && "pointer-events-none opacity-50"
        )}
        onClick={onSettingsClick}
        disabled={loading}
        aria-busy={loading}
        aria-label={`Open ${name}'s settings`}
      >
        {loading ? (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        ) : (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)]"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="1.8"
            strokeLinecap="round"
            strokeLinejoin="round"
            aria-hidden="true"
          >
            <path d="M12 15.25a3.25 3.25 0 1 0 0-6.5 3.25 3.25 0 0 0 0 6.5Z" />
            <path d="m19.4 15 .05.05a2 2 0 1 1-2.83 2.83l-.05-.05a2 2 0 0 0-3.41 1.41V19.3a2 2 0 1 1-4 0v-.07a2 2 0 0 0-3.41-1.41l-.05.05a2 2 0 1 1-2.83-2.83l.05-.05A2 2 0 0 0 1.5 11.58H1.4a2 2 0 1 1 0-4h.07a2 2 0 0 0 1.41-3.41l-.05-.05a2 2 0 1 1 2.83-2.83l.05.05A2 2 0 0 0 9.12 0h.07a2 2 0 1 1 4 0v.07a2 2 0 0 0 3.41 1.41l.05-.05a2 2 0 1 1 2.83 2.83l-.05.05a2 2 0 0 0 1.41 3.41h.07a2 2 0 1 1 0 4h-.07A2 2 0 0 0 19.4 15Z" />
          </svg>
        )}
      </button>
    </div>
  );
}