// NotificationPreferencesForm.tsx — Lets Wavelength users control the money moments they want to hear about.
import * as React from "react";
import { cva } from "class-variance-authority";
import * as Switch from "@radix-ui/react-switch";
import { cn } from "../lib/cn";

const preferenceSwitchVariants = cva(
  "relative inline-flex shrink-0 cursor-pointer items-center rounded-[var(--radius-full)] border border-[var(--color-border-default)] bg-[var(--color-neutral-200)] p-[var(--space-1)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-300)] active:scale-[0.96] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 data-[state=checked]:border-[var(--color-accent-500)] data-[state=checked]:bg-[var(--color-accent-500)] data-[state=checked]:hover:bg-[var(--color-accent-600)] disabled:pointer-events-none disabled:opacity-50"
);

export interface NotificationPreferencesFormProps {
  budgetAlerts: boolean;
  onBudgetAlertsChange: (enabled: boolean) => void;
  goalReminders: boolean;
  onGoalRemindersChange: (enabled: boolean) => void;
  streakNotifications: boolean;
  onStreakNotificationsChange: (enabled: boolean) => void;
  weeklySummary: boolean;
  onWeeklySummaryChange: (enabled: boolean) => void;
  isLoading?: boolean;
}

export default function NotificationPreferencesForm({
  budgetAlerts,
  onBudgetAlertsChange,
  goalReminders,
  onGoalRemindersChange,
  streakNotifications,
  onStreakNotificationsChange,
  weeklySummary,
  onWeeklySummaryChange,
  isLoading = false,
}: NotificationPreferencesFormProps) {
  const preferences = [
    {
      id: "budget-alerts",
      label: "Budget alerts",
      description: "Get a heads-up before a spending category runs low.",
      checked: budgetAlerts,
      onCheckedChange: onBudgetAlertsChange,
    },
    {
      id: "goal-reminders",
      label: "Goal reminders",
      description: "Stay on track with timely nudges for your savings goals.",
      checked: goalReminders,
      onCheckedChange: onGoalRemindersChange,
    },
    {
      id: "streak-notifications",
      label: "Streak notifications",
      description: "Celebrate budget streak milestones as you reach them.",
      checked: streakNotifications,
      onCheckedChange: onStreakNotificationsChange,
    },
    {
      id: "weekly-summary",
      label: "Weekly summary",
      description: "Review your spending rhythm in one weekly email.",
      checked: weeklySummary,
      onCheckedChange: onWeeklySummaryChange,
    },
  ];

  return (
    <form
      className={cn(
        "w-full max-w-[var(--space-24)] rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] p-[var(--space-6)] shadow-[var(--shadow-sm)]"
      )}
      aria-busy={isLoading}
      onSubmit={(event) => event.preventDefault()}
    >
      <div className="mb-[var(--space-4)] flex items-start justify-between gap-[var(--space-4)]">
        <div>
          <h2
            className="font-[var(--font-display)] font-[var(--weight-semibold)] text-[var(--color-text-primary)]"
            style={{ font: "var(--text-xl) var(--font-display)" }}
          >
            Notification preferences
          </h2>
          <p
            className="mt-[var(--space-1)] text-[var(--color-text-secondary)]"
            style={{ font: "var(--text-sm) var(--font-body)" }}
          >
            Choose the money moments Wavelength should send your way.
          </p>
        </div>

        {isLoading && (
          <svg
            className="mt-[var(--space-1)] h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-label="Saving notification preferences"
            role="status"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}
      </div>

      <div className="divide-y divide-[var(--color-border-subtle)]">
        {preferences.map((preference) => (
          <div
            key={preference.id}
            className="flex min-h-[var(--control-lg)] items-center justify-between gap-[var(--space-4)] py-[var(--space-4)] first:pt-[var(--space-2)] last:pb-[var(--space-2)]"
          >
            <div className="min-w-0">
              <label
                htmlFor={preference.id}
                className="block cursor-pointer font-[var(--weight-medium)] text-[var(--color-text-primary)]"
                style={{ font: "var(--text-base) var(--font-body)" }}
              >
                {preference.label}
              </label>
              <p
                className="mt-[var(--space-1)] text-[var(--color-text-muted)]"
                style={{ font: "var(--text-sm) var(--font-body)" }}
              >
                {preference.description}
              </p>
            </div>

            <Switch.Root
              id={preference.id}
              checked={preference.checked}
              onCheckedChange={preference.onCheckedChange}
              disabled={isLoading}
              aria-label={preference.label}
              className={cn(
                preferenceSwitchVariants(),
                "h-[var(--control-sm)] w-[var(--control-lg)]"
              )}
            >
              <Switch.Thumb className="pointer-events-none block h-[var(--space-6)] w-[var(--space-6)] rounded-[var(--radius-full)] bg-[var(--color-surface-raised)] transition-transform duration-[var(--duration-fast)] ease-[var(--easing-standard)] data-[state=checked]:translate-x-[var(--space-4)]" />
            </Switch.Root>
          </div>
        ))}
      </div>
    </form>
  );
}