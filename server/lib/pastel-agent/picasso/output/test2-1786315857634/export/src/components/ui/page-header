// PageHeader.tsx — Dashboard header for greeting users, showing today’s date, and changing the month used for budget data.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const pageHeaderVariants = cva(
  "flex flex-col gap-[var(--space-4)] rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-4)] font-[var(--font-body)] transition-colors duration-[var(--duration-base)] ease-[var(--easing-standard)] sm:flex-row sm:items-center sm:justify-between sm:p-[var(--space-6)]",
  {
    variants: {
      greeting: {
        streak:
          "border-[var(--color-success-500)] bg-[var(--color-success-50)]",
        standard:
          "border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)]",
        milestone:
          "border-[var(--color-warning-500)] bg-[var(--color-warning-50)]",
      },
    },
    defaultVariants: {
      greeting: "standard",
    },
  }
);

export interface PageHeaderProps
  extends React.HTMLAttributes<HTMLElement>,
    VariantProps<typeof pageHeaderVariants> {
  currentDate: Date;
  selectedMonth: Date;
  onMonthChange: (date: Date) => void;
  greetingText: string;
  userName?: string;
  loading?: boolean;
}

function monthKey(date: Date) {
  return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`;
}

function monthFromKey(value: string) {
  const [year, month] = value.split("-").map(Number);
  return new Date(year, month - 1, 1);
}

function shiftMonth(date: Date, amount: number) {
  return new Date(date.getFullYear(), date.getMonth() + amount, 1);
}

export default function PageHeader({
  className,
  greeting = "standard",
  currentDate,
  selectedMonth,
  onMonthChange,
  greetingText,
  userName,
  loading = false,
  ...props
}: PageHeaderProps) {
  const monthOptions = React.useMemo(
    () =>
      Array.from({ length: 13 }, (_, index) => {
        const date = shiftMonth(selectedMonth, index - 6);

        return {
          value: monthKey(date),
          label: new Intl.DateTimeFormat("en-US", {
            month: "long",
            year: "numeric",
          }).format(date),
        };
      }),
    [selectedMonth]
  );

  const formattedCurrentDate = new Intl.DateTimeFormat("en-US", {
    weekday: "long",
    month: "long",
    day: "numeric",
    year: "numeric",
  }).format(currentDate);

  const greetingLabel = userName
    ? `${greetingText}, ${userName}`
    : greetingText;

  return (
    <header
      className={cn(pageHeaderVariants({ greeting }), className)}
      aria-busy={loading}
      {...props}
    >
      <div className="min-w-0">
        <p
          className="font-[var(--font-display)] text-[length:var(--text-xl)] font-[var(--weight-semibold)] leading-tight text-[var(--color-text-primary)]"
        >
          {greetingLabel}
        </p>
        <p
          className="mt-[var(--space-1)] text-[length:var(--text-sm)] text-[var(--color-text-secondary)]"
        >
          {formattedCurrentDate}
        </p>
      </div>

      <div className="flex items-center gap-[var(--space-2)]">
        {loading && (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-text-muted)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-label="Loading"
            role="status"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}

        <button
          type="button"
          className="inline-flex h-[var(--control-sm)] w-[var(--control-sm)] items-center justify-center rounded-[var(--radius-md)] text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
          onClick={() => onMonthChange(shiftMonth(selectedMonth, -1))}
          disabled={loading}
          aria-label="Previous month"
        >
          <span aria-hidden="true">←</span>
        </button>

        <label className="sr-only" htmlFor="page-header-month">
          Select month
        </label>
        <select
          id="page-header-month"
          className="h-[var(--control-sm)] min-w-[var(--space-16)] rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-overlay)] px-[var(--space-3)] font-[var(--font-body)] text-[length:var(--text-sm)] text-[var(--color-text-primary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-accent-500)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:border-[var(--color-accent-600)] disabled:pointer-events-none disabled:opacity-50"
          value={monthKey(selectedMonth)}
          onChange={(event) => onMonthChange(monthFromKey(event.target.value))}
          disabled={loading}
        >
          {monthOptions.map((month) => (
            <option key={month.value} value={month.value}>
              {month.label}
            </option>
          ))}
        </select>

        <button
          type="button"
          className="inline-flex h-[var(--control-sm)] w-[var(--control-sm)] items-center justify-center rounded-[var(--radius-md)] text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
          onClick={() => onMonthChange(shiftMonth(selectedMonth, 1))}
          disabled={loading}
          aria-label="Next month"
        >
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </header>
  );
}