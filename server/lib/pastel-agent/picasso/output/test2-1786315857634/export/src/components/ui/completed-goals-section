// CompletedGoalsSection.tsx — Collapsible history of finished Wavelength savings goals. Use on the goals view to keep completed wins visible without competing with active goals.
import * as React from "react";
import * as Accordion from "@radix-ui/react-accordion";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const completedGoalsSectionVariants = cva(
  "overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] shadow-[var(--shadow-sm)]",
  {
    variants: {
      expanded: {
        true: "border-[var(--color-accent-500)]",
        false: "border-[var(--color-border-default)]",
      },
    },
    defaultVariants: {
      expanded: false,
    },
  }
);

export interface CompletedGoal {
  id: string;
  name: string;
  targetAmount: number;
  completedDate: Date;
  emoji: string;
}

export interface CompletedGoalsSectionProps
  extends VariantProps<typeof completedGoalsSectionVariants> {
  completedGoals: CompletedGoal[];
  isExpanded?: boolean;
  onToggle?: (expanded: boolean) => void;
  isLoading?: boolean;
  className?: string;
}

function formatTargetAmount(amount: number) {
  return new Intl.NumberFormat(undefined, {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(amount);
}

function formatCompletedDate(date: Date) {
  return new Intl.DateTimeFormat(undefined, {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);
}

export default function CompletedGoalsSection({
  completedGoals,
  isExpanded,
  onToggle,
  isLoading = false,
  className,
}: CompletedGoalsSectionProps) {
  const [internalExpanded, setInternalExpanded] = React.useState(false);
  const isControlled = isExpanded !== undefined;
  const expanded = isControlled ? isExpanded : internalExpanded;

  const handleValueChange = (value: string) => {
    const nextExpanded = value === "completed";

    if (!isControlled) {
      setInternalExpanded(nextExpanded);
    }

    onToggle?.(nextExpanded);
  };

  return (
    <Accordion.Root
      type="single"
      collapsible
      value={expanded ? "completed" : ""}
      onValueChange={handleValueChange}
      className={cn(
        completedGoalsSectionVariants({ expanded }),
        className
      )}
    >
      <Accordion.Item value="completed" className="border-0">
        <Accordion.Header>
          <Accordion.Trigger
            disabled={isLoading}
            aria-busy={isLoading}
            className={cn(
              "flex h-[var(--control-lg)] w-full items-center justify-between gap-[var(--space-4)] px-[var(--space-4)] text-left font-[var(--weight-medium)] text-[var(--color-text-primary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-50)] active:bg-[var(--color-neutral-100)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-inset disabled:pointer-events-none disabled:opacity-50"
            )}
          >
            <span className="flex min-w-0 items-center gap-[var(--space-3)]">
              <span
                aria-hidden="true"
                className="flex h-[var(--space-8)] w-[var(--space-8)] shrink-0 items-center justify-center rounded-[var(--radius-full)] bg-[var(--color-success-50)] text-[var(--color-success-900)]"
              >
                {isLoading ? (
                  <svg
                    className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
                    style={{ animationDuration: "var(--duration-slow)" }}
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                  >
                    <circle
                      className="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      strokeWidth="3"
                    />
                    <path
                      className="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"
                    />
                  </svg>
                ) : (
                  <svg
                    className="h-[var(--space-4)] w-[var(--space-4)]"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    strokeWidth="2.5"
                    strokeLinecap="round"
                    strokeLinejoin="round"
                  >
                    <path d="m5 12 4 4L19 6" />
                  </svg>
                )}
              </span>

              <span
                className="truncate font-[var(--weight-semibold)]"
                style={{ font: "var(--text-base) var(--font-body)" }}
              >
                Completed goals
              </span>
            </span>

            <span className="flex shrink-0 items-center gap-[var(--space-3)] text-[var(--color-text-muted)]">
              <span
                className="font-[var(--weight-regular)] tabular-nums"
                style={{ font: "var(--text-sm) var(--font-body)" }}
              >
                {isLoading
                  ? "Loading"
                  : `${completedGoals.length} ${
                      completedGoals.length === 1 ? "goal" : "goals"
                    }`}
              </span>
              <svg
                className="h-[var(--space-4)] w-[var(--space-4)] transition-transform duration-[var(--duration-fast)] ease-[var(--easing-standard)] data-[state=open]:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                strokeWidth="2"
                strokeLinecap="round"
                strokeLinejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </span>
          </Accordion.Trigger>
        </Accordion.Header>

        <Accordion.Content className="overflow-hidden data-[state=closed]:animate-[accordion-up_var(--duration-base)_var(--easing-standard)] data-[state=open]:animate-[accordion-down_var(--duration-base)_var(--easing-standard)]">
          <div className="border-t border-[var(--color-border-subtle)] px-[var(--space-4)]">
            {isLoading ? (
              <div
                className="flex items-center gap-[var(--space-3)] py-[var(--space-6)] text-[var(--color-text-muted)]"
                style={{ font: "var(--text-base) var(--font-body)" }}
                role="status"
              >
                <svg
                  className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
                  style={{ animationDuration: "var(--duration-slow)" }}
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <circle
                    className="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    strokeWidth="3"
                  />
                  <path
                    className="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"
                  />
                </svg>
                <span>Loading completed goals</span>
              </div>
            ) : completedGoals.length === 0 ? (
              <p
                className="py-[var(--space-6)] text-[var(--color-text-muted)]"
                style={{ font: "var(--text-base) var(--font-body)" }}
              >
                No completed goals yet.
              </p>
            ) : (
              <ul className="divide-y divide-[var(--color-border-subtle)]">
                {completedGoals.map((goal) => (
                  <li
                    key={goal.id}
                    className="flex items-center gap-[var(--space-3)] py-[var(--space-4)]"
                  >
                    <span
                      className="flex h-[var(--space-8)] w-[var(--space-8)] shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-neutral-100)] text-[var(--color-text-primary)]"
                      aria-hidden="true"
                    >
                      {goal.emoji}
                    </span>

                    <span className="min-w-0 flex-1">
                      <span
                        className="block truncate font-[var(--weight-medium)] text-[var(--color-text-primary)]"
                        style={{ font: "var(--text-base) var(--font-body)" }}
                      >
                        {goal.name}
                      </span>
                      <span
                        className="mt-[var(--space-1)] block text-[var(--color-text-muted)]"
                        style={{ font: "var(--text-sm) var(--font-body)" }}
                      >
                        {formatCompletedDate(goal.completedDate)}
                      </span>
                    </span>

                    <span
                      className="shrink-0 font-[var(--weight-semibold)] tabular-nums text-[var(--color-success-900)]"
                      style={{ font: "var(--text-base) var(--font-body)" }}
                    >
                      {formatTargetAmount(goal.targetAmount)}
                    </span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </Accordion.Content>
      </Accordion.Item>
    </Accordion.Root>
  );
}