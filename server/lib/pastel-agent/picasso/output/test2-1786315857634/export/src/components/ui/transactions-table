// TransactionsTable.tsx — Paginated transaction ledger with sortable spending columns. Use for reviewing and organizing Wavelength spending activity.
import { cva, type VariantProps } from "class-variance-authority";
import type { ButtonHTMLAttributes, HTMLAttributes } from "react";
import { cn } from "../lib/cn";

const transactionsTableVariants = cva(
  "overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] font-[var(--font-body)] text-[var(--color-text-primary)]",
  {
    variants: {
      sortBy: {
        date: "",
        amount: "",
        merchant: "",
      },
      sortOrder: {
        asc: "",
        desc: "",
      },
    },
    defaultVariants: {
      sortBy: "date",
      sortOrder: "desc",
    },
  }
);

const sortButtonVariants = cva(
  "inline-flex h-[var(--control-sm)] items-center gap-[var(--space-1)] rounded-[var(--radius-sm)] px-[var(--space-2)] font-[var(--weight-semibold)] text-[var(--text-xs)] text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      active: {
        true: "text-[var(--color-accent-600)]",
        false: "",
      },
    },
    defaultVariants: {
      active: false,
    },
  }
);

const paginationButtonVariants = cva(
  "inline-flex h-[var(--control-sm)] min-w-[var(--control-sm)] items-center justify-center rounded-[var(--radius-sm)] border border-[var(--color-border-default)] px-[var(--space-2)] font-[var(--weight-medium)] text-[var(--text-sm)] text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      current: {
        true: "border-[var(--color-accent-500)] bg-[var(--color-accent-50)] text-[var(--color-accent-600)]",
        false: "bg-[var(--color-surface-raised)]",
      },
    },
    defaultVariants: {
      current: false,
    },
  }
);

export interface Transaction {
  id: string;
  date: Date;
  merchant: string;
  category: string;
  amount: number;
  notes?: string;
}

export interface TransactionsTableProps
  extends Omit<HTMLAttributes<HTMLDivElement>, "children">,
    VariantProps<typeof transactionsTableVariants> {
  transactions: Transaction[];
  currentPage: number;
  pageSize?: number;
  totalCount: number;
  onPageChange: (page: number) => void;
  onSort?: (
    column: "date" | "amount" | "merchant",
    order: "asc" | "desc"
  ) => void;
  currency?: string;
  isLoading?: boolean;
}

interface SortButtonProps
  extends ButtonHTMLAttributes<HTMLButtonElement>,
    VariantProps<typeof sortButtonVariants> {
  label: string;
  column: "date" | "amount" | "merchant";
  sortBy?: "date" | "amount" | "merchant" | null;
  sortOrder?: "asc" | "desc" | null;
  onSort?: (
    column: "date" | "amount" | "merchant",
    order: "asc" | "desc"
  ) => void;
}

function SortButton({
  label,
  column,
  sortBy,
  sortOrder,
  onSort,
  className,
  ...props
}: SortButtonProps) {
  const isActive = sortBy === column;
  const nextOrder = isActive && sortOrder === "asc" ? "desc" : "asc";

  return (
    <button
      type="button"
      className={cn(sortButtonVariants({ active: isActive }), className)}
      onClick={() => onSort?.(column, nextOrder)}
      aria-label={`Sort transactions by ${label}`}
      aria-pressed={isActive}
      {...props}
    >
      {label}
      <span aria-hidden="true" className="font-[var(--font-mono)] text-[var(--text-xs)]">
        {isActive ? (sortOrder === "asc" ? "↑" : "↓") : "↕"}
      </span>
    </button>
  );
}

export default function TransactionsTable({
  className,
  transactions,
  currentPage,
  pageSize = 10,
  totalCount,
  onPageChange,
  onSort,
  currency,
  isLoading = false,
  sortBy,
  sortOrder,
  ...props
}: TransactionsTableProps) {
  const totalPages = Math.max(1, Math.ceil(totalCount / pageSize));
  const startIndex = (currentPage - 1) * pageSize;
  const visibleTransactions = transactions.slice(startIndex, startIndex + pageSize);
  const hasTransactions = visibleTransactions.length > 0;

  const formatAmount = (amount: number) =>
    `${currency ?? ""}${Math.abs(amount).toFixed(2)}`;

  const formatDate = (date: Date) =>
    new Intl.DateTimeFormat(undefined, {
      month: "short",
      day: "numeric",
      year: "numeric",
    }).format(date);

  const getAriaSort = (column: "date" | "amount" | "merchant") => {
    if (sortBy !== column) return "none";
    return sortOrder === "asc" ? "ascending" : "descending";
  };

  return (
    <div
      className={cn(
        transactionsTableVariants({ sortBy, sortOrder }),
        className
      )}
      aria-busy={isLoading}
      {...props}
    >
      <div className="overflow-x-auto">
        <table className="w-full min-w-[var(--space-24)] border-collapse">
          <caption className="sr-only">
            Wavelength transaction history
          </caption>
          <thead className="border-b border-[var(--color-border-default)] bg-[var(--color-neutral-50)]">
            <tr>
              <th
                scope="col"
                aria-sort={getAriaSort("date")}
                className="px-[var(--space-4)] py-[var(--space-3)] text-left"
              >
                <SortButton
                  label="Date"
                  column="date"
                  sortBy={sortBy}
                  sortOrder={sortOrder}
                  onSort={onSort}
                />
              </th>
              <th
                scope="col"
                aria-sort={getAriaSort("merchant")}
                className="px-[var(--space-4)] py-[var(--space-3)] text-left"
              >
                <SortButton
                  label="Merchant"
                  column="merchant"
                  sortBy={sortBy}
                  sortOrder={sortOrder}
                  onSort={onSort}
                />
              </th>
              <th
                scope="col"
                className="px-[var(--space-4)] py-[var(--space-3)] text-left font-[var(--weight-semibold)] text-[var(--text-xs)] text-[var(--color-text-secondary)]"
              >
                Category
              </th>
              <th
                scope="col"
                aria-sort={getAriaSort("amount")}
                className="px-[var(--space-4)] py-[var(--space-3)] text-right"
              >
                <SortButton
                  label="Amount"
                  column="amount"
                  sortBy={sortBy}
                  sortOrder={sortOrder}
                  onSort={onSort}
                  className="ml-auto"
                />
              </th>
              <th
                scope="col"
                className="px-[var(--space-4)] py-[var(--space-3)] text-left font-[var(--weight-semibold)] text-[var(--text-xs)] text-[var(--color-text-secondary)]"
              >
                Notes
              </th>
            </tr>
          </thead>

          <tbody className="divide-y divide-[var(--color-border-subtle)]">
            {isLoading ? (
              <tr>
                <td
                  colSpan={5}
                  className="px-[var(--space-4)] py-[var(--space-12)] text-center text-[var(--text-sm)] text-[var(--color-text-muted)]"
                >
                  <span className="inline-flex items-center gap-[var(--space-2)]">
                    <svg
                      className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <circle
                        className="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        strokeWidth="4"
                      />
                      <path
                        className="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                      />
                    </svg>
                    Loading transactions
                  </span>
                </td>
              </tr>
            ) : !hasTransactions ? (
              <tr>
                <td
                  colSpan={5}
                  className="px-[var(--space-4)] py-[var(--space-12)] text-left text-[var(--text-sm)] text-[var(--color-text-muted)]"
                >
                  No transactions found for this page.
                </td>
              </tr>
            ) : (
              visibleTransactions.map((transaction) => (
                <tr
                  key={transaction.id}
                  className="transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-50)]"
                >
                  <td className="whitespace-nowrap px-[var(--space-4)] py-[var(--space-3)] text-[var(--text-sm)] text-[var(--color-text-secondary)]">
                    {formatDate(transaction.date)}
                  </td>
                  <td className="px-[var(--space-4)] py-[var(--space-3)] font-[var(--weight-medium)] text-[var(--text-base)]">
                    {transaction.merchant}
                  </td>
                  <td className="px-[var(--space-4)] py-[var(--space-3)] text-[var(--text-sm)] text-[var(--color-text-secondary)]">
                    {transaction.category}
                  </td>
                  <td
                    className={cn(
                      "whitespace-nowrap px-[var(--space-4)] py-[var(--space-3)] text-right font-[var(--font-mono)] text-[var(--text-sm)] font-[var(--weight-medium)] tabular-nums",
                      transaction.amount < 0
                        ? "text-[var(--color-danger-500)]"
                        : "text-[var(--color-success-500)]"
                    )}
                  >
                    {transaction.amount < 0 ? "-" : "+"}
                    {formatAmount(transaction.amount)}
                  </td>
                  <td className="max-w-[var(--space-24)] px-[var(--space-4)] py-[var(--space-3)] text-[var(--text-sm)] text-[var(--color-text-muted)]">
                    {transaction.notes || ""}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <div className="flex flex-wrap items-center justify-between gap-[var(--space-3)] border-t border-[var(--color-border-default)] px-[var(--space-4)] py-[var(--space-3)]">
        <p className="text-[var(--text-sm)] text-[var(--color-text-muted)]">
          Page {currentPage} of {totalPages}
        </p>

        <nav
          aria-label="Transaction pages"
          className="flex items-center gap-[var(--space-1)]"
        >
          <button
            type="button"
            className={cn(paginationButtonVariants())}
            disabled={currentPage <= 1 || isLoading}
            onClick={() => onPageChange(currentPage - 1)}
            aria-label="Previous transaction page"
          >
            Previous
          </button>

          {Array.from({ length: totalPages }, (_, index) => index + 1).map(
            (page) => (
              <button
                key={page}
                type="button"
                className={cn(
                  paginationButtonVariants({ current: page === currentPage })
                )}
                disabled={isLoading}
                onClick={() => onPageChange(page)}
                aria-current={page === currentPage ? "page" : undefined}
                aria-label={`Go to transaction page ${page}`}
              >
                {page}
              </button>
            )
          )}

          <button
            type="button"
            className={cn(paginationButtonVariants())}
            disabled={currentPage >= totalPages || isLoading}
            onClick={() => onPageChange(currentPage + 1)}
            aria-label="Next transaction page"
          >
            Next
          </button>
        </nav>
      </div>
    </div>
  );
}