// StreakBand.tsx — Prominent monthly streak summary with progress toward the end of the month. Use on the Wavelength dashboard to make budget consistency feel tangible.
import React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const streakBandVariants = cva(
  "w-full rounded-[var(--radius-xl)] border font-[var(--font-body)] transition-all duration-[var(--duration-base)] ease-[var(--easing-standard)] hover:border-[var(--color-border-focus)]",
  {
    variants: {
      emphasis: {
        active:
          "border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] text-[var(--color-text-primary)]",
        warning:
          "border-[var(--color-warning-500)] bg-[var(--color-warning-50)] text-[var(--color-warning-900)]",
        milestone:
          "border-[var(--color-success-500)] bg-[var(--color-success-50)] text-[var(--color-success-900)]",
      },
    },
    defaultVariants: {
      emphasis: "active",
    },
  }
);

export interface StreakBandProps
  extends React.HTMLAttributes<HTMLElement>,
    VariantProps<typeof streakBandVariants> {
  streakCount: number;
  daysRemainingInMonth: number;
  progressPercentage: number;
  isMilestone?: boolean;
  loading?: boolean;
}

export default function StreakBand({
  className,
  emphasis,
  streakCount,
  daysRemainingInMonth,
  progressPercentage,
  isMilestone = false,
  loading = false,
  ...props
}: StreakBandProps) {
  const progress = Math.min(100, Math.max(0, progressPercentage));
  const streakLabel = streakCount === 1 ? "day streak" : "day streak";
  const remainingLabel =
    daysRemainingInMonth === 1 ? "day left this month" : "days left this month";

  return (
    <section
      className={cn(streakBandVariants({ emphasis }), className)}
      aria-busy={loading}
      {...props}
    >
      <div className="flex flex-col gap-[var(--space-6)] p-[var(--space-6)] md:flex-row md:items-end md:justify-between">
        <div className="flex items-start gap-[var(--space-3)]">
          {loading && (
            <svg
              className="mt-[var(--space-2)] h-[var(--space-4)] w-[var(--space-4)] animate-spin"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                className="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                strokeWidth="4"
              />
              <path
                className="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
              />
            </svg>
          )}

          <div>
            <p className="text-[length:var(--text-sm)] font-[var(--weight-medium)] text-[var(--color-text-secondary)]">
              {isMilestone ? "Milestone streak" : "Keep your streak going"}
            </p>
            <div className="mt-[var(--space-2)] flex items-baseline gap-[var(--space-2)]">
              <span className="font-[var(--font-display)] text-[length:var(--text-4xl)] font-[var(--weight-bold)] tabular-nums tracking-[-0.04em]">
                {streakCount}
              </span>
              <span className="text-[length:var(--text-lg)] font-[var(--weight-medium)]">
                {streakLabel}
              </span>
            </div>
          </div>
        </div>

        <div className="min-w-0 md:w-2/5">
          <div className="flex items-center justify-between gap-[var(--space-4)] text-[length:var(--text-sm)]">
            <span className="font-[var(--weight-medium)]">Month progress</span>
            <span className="tabular-nums text-[var(--color-text-muted)]">
              {daysRemainingInMonth} {remainingLabel}
            </span>
          </div>

          <div
            className="mt-[var(--space-3)] h-[var(--space-2)] overflow-hidden rounded-[var(--radius-full)] bg-[var(--color-neutral-200)]"
            role="progressbar"
            aria-label="Month progress"
            aria-valuemin={0}
            aria-valuemax={100}
            aria-valuenow={progress}
          >
            <div
              className="h-full rounded-[var(--radius-full)] bg-[var(--color-accent-500)] transition-[width] duration-[var(--duration-slow)] ease-[var(--easing-standard)]"
              style={{ width: `${progress}%` }}
            />
          </div>

          <p className="mt-[var(--space-2)] text-right font-[var(--font-mono)] text-[length:var(--text-xs)] tabular-nums text-[var(--color-text-muted)]">
            {progress}%
          </p>
        </div>
      </div>
    </section>
  );
}