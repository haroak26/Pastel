// ProgressTimeline.tsx — Shows Wavelength contributions and savings milestones in chronological order. Use on dashboard and goals views when progress needs a time-based story.
import type { HTMLAttributes } from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const progressTimelineVariants = cva(
  "rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] font-[var(--font-body)] text-[var(--color-text-primary)] shadow-[var(--shadow-sm)] transition-all duration-[var(--duration-base)] ease-[var(--easing-standard)]"
);

export interface ProgressTimelineProps
  extends HTMLAttributes<HTMLElement> {
  contributions: Array<{
    date: Date;
    amount: number;
    source: string;
  }>;
  milestones?: Array<{
    date: Date;
    label: string;
    amount: number;
  }>;
  currency?: string;
  isLoading?: boolean;
}

export default function ProgressTimeline({
  contributions,
  milestones = [],
  currency,
  isLoading = false,
  className,
  ...props
}: ProgressTimelineProps) {
  const events = [
    ...contributions.map((contribution) => ({
      ...contribution,
      type: "contribution" as const,
    })),
    ...milestones.map((milestone) => ({
      ...milestone,
      type: "milestone" as const,
      source: milestone.label,
    })),
  ].sort((a, b) => a.date.getTime() - b.date.getTime());

  const formatAmount = (amount: number) => {
    const formattedAmount = new Intl.NumberFormat(undefined, {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(amount);

    return currency ? `${currency} ${formattedAmount}` : formattedAmount;
  };

  const formatDate = (date: Date) =>
    new Intl.DateTimeFormat(undefined, {
      month: "short",
      day: "numeric",
      year: "numeric",
    }).format(date);

  return (
    <section
      className={cn(progressTimelineVariants(), className)}
      aria-label="Contribution timeline"
      aria-busy={isLoading}
      {...props}
    >
      <div className="mb-[var(--space-6)] flex items-end justify-between gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] pb-[var(--space-4)]">
        <div>
          <p className="mb-[var(--space-1)] text-[var(--text-xs)] font-[var(--weight-semibold)] tracking-wide text-[var(--color-text-muted)]">
            MONEY MOVEMENT
          </p>
          <h2 className="font-[var(--font-display)] text-[var(--text-xl)] font-[var(--weight-semibold)]">
            Contribution timeline
          </h2>
        </div>
        {!isLoading && events.length > 0 && (
          <span className="text-right text-[var(--text-sm)] text-[var(--color-text-muted)]">
            {events.length} {events.length === 1 ? "entry" : "entries"}
          </span>
        )}
      </div>

      {isLoading ? (
        <div
          className="flex min-h-[var(--control-lg)] items-center gap-[var(--space-3)] text-[var(--text-base)] text-[var(--color-text-muted)]"
          role="status"
        >
          <svg
            className="size-[var(--space-4)] animate-spin text-[var(--color-text-muted)] duration-[var(--duration-slow)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
          Loading contribution timeline
        </div>
      ) : events.length === 0 ? (
        <div
          className="flex min-h-[var(--control-lg)] items-center text-[var(--text-base)] text-[var(--color-text-muted)]"
          role="status"
        >
          No contributions recorded yet
        </div>
      ) : (
        <div className="relative" role="list">
          <div
            className="absolute inset-y-[var(--space-4)] left-[var(--space-4)] border-l border-[var(--color-border-default)]"
            aria-hidden="true"
          />

          <div className="space-y-[var(--space-4)]">
            {events.map((event, index) => {
              const isMilestone = event.type === "milestone";

              return (
                <article
                  key={`${event.type}-${event.date.getTime()}-${index}`}
                  className="relative flex gap-[var(--space-4)]"
                  role="listitem"
                >
                  <div className="relative z-10 flex w-[var(--space-8)] shrink-0 justify-center bg-[var(--color-surface-raised)] py-[var(--space-1)]">
                    <span
                      className={cn(
                        "mt-[var(--space-1)] size-[var(--space-3)] rounded-[var(--radius-full)] border-2 border-[var(--color-surface-raised)]",
                        isMilestone
                          ? "bg-[var(--color-accent-500)] ring-2 ring-[var(--color-accent-100)]"
                          : "bg-[var(--color-neutral-400)]"
                      )}
                      aria-label={isMilestone ? "Milestone" : "Contribution"}
                    />
                  </div>

                  <div className="min-w-0 flex-1 border-b border-[var(--color-border-subtle)] pb-[var(--space-4)] last:border-b-0 last:pb-0">
                    <div className="flex items-start justify-between gap-[var(--space-4)]">
                      <div className="min-w-0">
                        <p className="truncate text-[var(--text-base)] font-[var(--weight-medium)]">
                          {event.source}
                        </p>
                        <time
                          className="text-[var(--text-sm)] text-[var(--color-text-muted)]"
                          dateTime={event.date.toISOString()}
                        >
                          {formatDate(event.date)}
                        </time>
                      </div>
                      <p
                        className={cn(
                          "shrink-0 font-[var(--font-mono)] text-[var(--text-base)] font-[var(--weight-semibold)] tabular-nums",
                          isMilestone
                            ? "text-[var(--color-text-primary)]"
                            : "text-[var(--color-text-secondary)]"
                        )}
                      >
                        {formatAmount(event.amount)}
                      </p>
                    </div>

                    {isMilestone && (
                      <p className="mt-[var(--space-2)] text-[var(--text-xs)] font-[var(--weight-medium)] text-[var(--color-text-muted)]">
                        Savings milestone reached
                      </p>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      )}
    </section>
  );
}