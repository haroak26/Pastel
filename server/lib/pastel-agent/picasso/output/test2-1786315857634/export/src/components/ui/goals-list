// GoalsList.tsx — Displays active Wavelength savings goals with progress, dates, sorting, and goal actions.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const goalsListVariants = cva(
  "w-full overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] font-[var(--font-body)] text-[var(--color-text-primary)]",
  {
    variants: {
      sortBy: {
        targetDate: "",
        progress: "",
        name: "",
      },
      layout: {
        list: "",
        card: "",
      },
    },
    defaultVariants: {
      sortBy: "targetDate",
      layout: "list",
    },
  }
);

export interface GoalsListProps
  extends React.HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof goalsListVariants> {
  goals: Array<{
    id: string;
    name: string;
    targetAmount: number;
    currentSaved: number;
    targetDate: Date;
    emoji: string;
  }>;
  currency?: string;
  onEdit?: (goalId: string) => void;
  onDelete?: (goalId: string) => void;
  onGoalClick?: (goalId: string) => void;
  isLoading?: boolean;
}

function EditIcon() {
  return (
    <svg
      className="h-[var(--space-4)] w-[var(--space-4)]"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="2"
      aria-hidden="true"
    >
      <path d="M12 20h9" />
      <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z" />
    </svg>
  );
}

function DeleteIcon() {
  return (
    <svg
      className="h-[var(--space-4)] w-[var(--space-4)]"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="2"
      aria-hidden="true"
    >
      <path d="M3 6h18" />
      <path d="M8 6V4h8v2" />
      <path d="m19 6-1 14H6L5 6" />
      <path d="M10 11v5M14 11v5" />
    </svg>
  );
}

function LoadingSpinner() {
  return (
    <svg
      className="h-[var(--space-6)] w-[var(--space-6)] animate-spin text-[var(--color-accent-500)]"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <circle
        className="opacity-25"
        cx="12"
        cy="12"
        r="10"
        stroke="currentColor"
        strokeWidth="3"
      />
      <path
        className="opacity-80"
        fill="currentColor"
        d="M12 2a10 10 0 0 1 10 10h-3a7 7 0 0 0-7-7V2Z"
      />
    </svg>
  );
}

export default function GoalsList({
  className,
  sortBy,
  layout,
  goals,
  currency = "",
  onEdit,
  onDelete,
  onGoalClick,
  isLoading = false,
  ...props
}: GoalsListProps) {
  const sortedGoals = React.useMemo(() => {
    return [...goals].sort((a, b) => {
      if (sortBy === "name") {
        return a.name.localeCompare(b.name);
      }

      if (sortBy === "progress") {
        const aProgress = a.targetAmount
          ? a.currentSaved / a.targetAmount
          : 0;
        const bProgress = b.targetAmount
          ? b.currentSaved / b.targetAmount
          : 0;
        return bProgress - aProgress;
      }

      return a.targetDate.getTime() - b.targetDate.getTime();
    });
  }, [goals, sortBy]);

  const formatAmount = (amount: number) =>
    `${currency}${amount.toLocaleString(undefined, {
      maximumFractionDigits: 2,
    })}`;

  const formatDate = (date: Date) =>
    date.toLocaleDateString(undefined, {
      month: "short",
      day: "numeric",
      year: "numeric",
    });

  return (
    <div
      className={cn(goalsListVariants({ sortBy, layout }), className)}
      aria-busy={isLoading}
      {...props}
    >
      {isLoading ? (
        <div
          className="flex min-h-[var(--control-lg)] items-center justify-center gap-[var(--space-3)] p-[var(--space-6)]"
          role="status"
          aria-label="Loading savings goals"
        >
          <LoadingSpinner />
          <span
            className="text-sm text-[var(--color-text-secondary)]"
            style={{ fontFamily: "var(--font-body)" }}
          >
            Loading your goals
          </span>
        </div>
      ) : sortedGoals.length === 0 ? (
        <div className="flex flex-col items-start gap-[var(--space-2)] p-[var(--space-6)]">
          <span
            className="text-lg font-[var(--weight-semibold)]"
            style={{ fontFamily: "var(--font-display)" }}
          >
            No active goals yet
          </span>
          <span className="text-base text-[var(--color-text-secondary)]">
            Add a savings goal to give your next win a clear finish line.
          </span>
        </div>
      ) : (
        <div
          className={cn(
            "divide-y divide-[var(--color-border-subtle)]",
            layout === "card" && "space-y-[var(--space-2)] divide-y-0 p-[var(--space-2)]"
          )}
        >
          {sortedGoals.map((goal) => {
            const progress = goal.targetAmount
              ? Math.min(
                  100,
                  Math.max(0, (goal.currentSaved / goal.targetAmount) * 100)
                )
              : 0;

            return (
              <div
                key={goal.id}
                className={cn(
                  "flex items-center gap-[var(--space-4)] p-[var(--space-4)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
                  layout === "card" &&
                    "rounded-[var(--radius-md)] bg-[var(--color-neutral-50)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)]"
                )}
              >
                <button
                  type="button"
                  className="min-w-0 flex-1 cursor-pointer rounded-[var(--radius-sm)] text-left outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2"
                  onClick={() => onGoalClick?.(goal.id)}
                  disabled={!onGoalClick}
                  aria-label={`View ${goal.name} savings goal`}
                >
                  <div className="flex items-start gap-[var(--space-3)]">
                    <span
                      className="flex h-[var(--control-lg)] w-[var(--control-lg)] shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-accent-50)] text-lg"
                      aria-hidden="true"
                    >
                      {goal.emoji}
                    </span>

                    <div className="min-w-0 flex-1">
                      <div className="flex flex-wrap items-baseline justify-between gap-x-[var(--space-3)] gap-y-[var(--space-1)]">
                        <span
                          className="truncate text-base font-[var(--weight-semibold)]"
                          style={{ fontFamily: "var(--font-display)" }}
                        >
                          {goal.name}
                        </span>
                        <span
                          className="font-[var(--font-mono)] text-sm tabular-nums text-[var(--color-text-secondary)]"
                          style={{ fontFamily: "var(--font-mono)" }}
                        >
                          {formatAmount(goal.currentSaved)} /{" "}
                          {formatAmount(goal.targetAmount)}
                        </span>
                      </div>

                      <div className="mt-[var(--space-3)] flex items-center gap-[var(--space-3)]">
                        <div
                          className="h-[var(--space-2)] flex-1 overflow-hidden rounded-[var(--radius-full)] bg-[var(--color-neutral-200)]"
                          role="progressbar"
                          aria-valuemin={0}
                          aria-valuemax={100}
                          aria-valuenow={Math.round(progress)}
                          aria-label={`${goal.name} progress`}
                        >
                          <div
                            className="h-full rounded-[var(--radius-full)] bg-[var(--color-accent-500)] transition-[width] duration-[var(--duration-base)] ease-[var(--easing-standard)]"
                            style={{ width: `${progress}%` }}
                          />
                        </div>
                        <span
                          className="w-[var(--space-8)] shrink-0 text-right text-sm font-[var(--weight-medium)] tabular-nums text-[var(--color-text-secondary)]"
                          style={{ fontFamily: "var(--font-mono)" }}
                        >
                          {Math.round(progress)}%
                        </span>
                      </div>

                      <span className="mt-[var(--space-2)] block text-sm text-[var(--color-text-muted)]">
                        Target date: {formatDate(goal.targetDate)}
                      </span>
                    </div>
                  </div>
                </button>

                {(onEdit || onDelete) && (
                  <div className="flex shrink-0 items-center gap-[var(--space-2)]">
                    {onEdit && (
                      <button
                        type="button"
                        className="inline-flex h-[var(--control-sm)] w-[var(--control-sm)] items-center justify-center rounded-[var(--radius-sm)] text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-200)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-300)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
                        onClick={() => onEdit(goal.id)}
                        aria-label={`Edit ${goal.name}`}
                      >
                        <EditIcon />
                      </button>
                    )}

                    {onDelete && (
                      <button
                        type="button"
                        className="inline-flex h-[var(--control-sm)] w-[var(--control-sm)] items-center justify-center rounded-[var(--radius-sm)] text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-danger-50)] hover:text-[var(--color-danger-500)] active:bg-[var(--color-danger-50)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
                        onClick={() => onDelete(goal.id)}
                        aria-label={`Delete ${goal.name}`}
                      >
                        <DeleteIcon />
                      </button>
                    )}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}