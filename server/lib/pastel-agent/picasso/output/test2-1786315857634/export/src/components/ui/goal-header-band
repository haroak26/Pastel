// GoalHeaderBand.tsx — Displays a Wavelength savings goal with progress, target details, and goal management actions.
import * as React from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const goalHeaderBandVariants = cva(
  "rounded-[var(--radius-xl)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] font-[var(--font-body)] shadow-[var(--shadow-sm)] transition-all duration-[var(--duration-base)] ease-[var(--easing-standard)]",
  {
    variants: {},
  }
);

const actionButtonVariants = cva(
  "inline-flex h-[var(--control-sm)] items-center justify-center gap-[var(--space-2)] rounded-[var(--radius-md)] px-[var(--space-3)] text-[var(--text-sm)] font-[var(--weight-medium)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      intent: {
        edit:
          "text-[var(--color-text-secondary)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)]",
        delete:
          "text-[var(--color-danger-500)] hover:bg-[var(--color-danger-50)] active:bg-[var(--color-danger-50)]",
      },
    },
  }
);

export interface GoalHeaderBandProps {
  goalName: string;
  targetAmount: number;
  currentSaved: number;
  targetDate: Date;
  emoji?: string;
  currency?: string;
  onEdit?: () => void;
  onDelete?: () => void;
  loading?: boolean;
  className?: string;
}

function formatAmount(amount: number, currency?: string) {
  const formattedAmount = Math.abs(amount).toLocaleString(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

  return currency ? `${currency}${formattedAmount}` : formattedAmount;
}

export default function GoalHeaderBand({
  goalName,
  targetAmount,
  currentSaved,
  targetDate,
  emoji,
  currency,
  onEdit,
  onDelete,
  loading = false,
  className,
}: GoalHeaderBandProps) {
  const progress =
    targetAmount > 0
      ? Math.min(100, Math.max(0, (currentSaved / targetAmount) * 100))
      : 0;

  const dateLabel = new Intl.DateTimeFormat(undefined, {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(targetDate);

  return (
    <section
      className={cn(goalHeaderBandVariants(), className)}
      aria-busy={loading}
      aria-label={goalName}
    >
      <div className="flex flex-col gap-[var(--space-6)]">
        <div className="flex flex-col justify-between gap-[var(--space-4)] sm:flex-row sm:items-start">
          <div className="flex min-w-0 items-start gap-[var(--space-3)]">
            {emoji ? (
              <span
                className="flex h-[var(--control-lg)] w-[var(--control-lg)] shrink-0 items-center justify-center rounded-[var(--radius-lg)] bg-[var(--color-accent-50)] text-[var(--text-2xl)]"
                aria-hidden="true"
              >
                {emoji}
              </span>
            ) : null}

            <div className="min-w-0">
              <p className="mb-[var(--space-1)] text-[var(--text-xs)] font-[var(--weight-semibold)] tracking-[0.04em] text-[var(--color-text-muted)]">
                SAVINGS GOAL
              </p>
              <h2 className="truncate font-[var(--font-display)] text-[var(--text-2xl)] font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
                {goalName}
              </h2>
            </div>
          </div>

          <div className="flex shrink-0 items-center gap-[var(--space-2)]">
            <button
              type="button"
              className={cn(actionButtonVariants({ intent: "edit" }))}
              onClick={onEdit}
              disabled={!onEdit || loading}
              aria-label={`Edit ${goalName}`}
            >
              {loading ? (
                <svg
                  className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <circle
                    cx="12"
                    cy="12"
                    r="9"
                    stroke="currentColor"
                    strokeOpacity="0.25"
                    strokeWidth="3"
                  />
                  <path
                    d="M21 12a9 9 0 0 0-9-9"
                    stroke="currentColor"
                    strokeWidth="3"
                  />
                </svg>
              ) : (
                <svg
                  className="h-[var(--space-4)] w-[var(--space-4)]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  strokeWidth="1.8"
                  aria-hidden="true"
                >
                  <path d="M12 20h9" />
                  <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z" />
                </svg>
              )}
              Edit
            </button>

            <button
              type="button"
              className={cn(actionButtonVariants({ intent: "delete" }))}
              onClick={onDelete}
              disabled={!onDelete || loading}
              aria-label={`Delete ${goalName}`}
            >
              <svg
                className="h-[var(--space-4)] w-[var(--space-4)]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                strokeWidth="1.8"
                aria-hidden="true"
              >
                <path d="M3 6h18" />
                <path d="M8 6V4h8v2" />
                <path d="m19 6-1 14H6L5 6" />
                <path d="M10 11v5M14 11v5" />
              </svg>
              Delete
            </button>
          </div>
        </div>

        <div className="flex flex-col gap-[var(--space-3)]">
          <div className="flex flex-wrap items-end justify-between gap-[var(--space-4)]">
            <div>
              <p className="text-[var(--text-sm)] text-[var(--color-text-muted)]">
                Saved so far
              </p>
              <p className="font-[var(--font-display)] text-[var(--text-3xl)] font-[var(--weight-semibold)] tabular-nums text-[var(--color-text-primary)]">
                {formatAmount(currentSaved, currency)}
              </p>
            </div>

            <div className="text-left sm:text-right">
              <p className="text-[var(--text-sm)] text-[var(--color-text-muted)]">
                Target
              </p>
              <p className="font-[var(--font-mono)] text-[var(--text-lg)] font-[var(--weight-medium)] tabular-nums text-[var(--color-text-secondary)]">
                {formatAmount(targetAmount, currency)}
              </p>
            </div>
          </div>

          <div
            className="h-[var(--space-2)] overflow-hidden rounded-[var(--radius-full)] bg-[var(--color-neutral-100)]"
            role="progressbar"
            aria-valuemin={0}
            aria-valuemax={100}
            aria-valuenow={Math.round(progress)}
            aria-label={`${Math.round(progress)} percent of ${goalName} saved`}
          >
            <div
              className="h-full rounded-[var(--radius-full)] bg-[var(--color-accent-500)] transition-[width] duration-[var(--duration-slow)] ease-[var(--easing-standard)]"
              style={{ width: `${progress}%` }}
            />
          </div>

          <div className="flex flex-wrap justify-between gap-[var(--space-3)] text-[var(--text-sm)]">
            <span className="font-[var(--weight-medium)] tabular-nums text-[var(--color-text-secondary)]">
              {Math.round(progress)}% there
            </span>
            <span className="text-[var(--color-text-muted)]">
              Target date:{" "}
              <span className="font-[var(--weight-medium)] text-[var(--color-text-secondary)]">
                {dateLabel}
              </span>
            </span>
          </div>
        </div>
      </div>
    </section>
  );
}