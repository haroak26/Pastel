// GoalStatsCard.tsx — Summarizes active savings goals, total saved, and the next milestone. Use on the Wavelength goals dashboard.
import React from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const goalStatsCardVariants = cva(
  "rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] border-l-[var(--space-1)] border-l-[var(--color-accent-500)] bg-[var(--color-surface-raised)] p-[var(--space-6)] font-[var(--font-body)] text-[var(--color-text-primary)] shadow-[var(--shadow-sm)] transition-all duration-[var(--duration-base)] ease-[var(--easing-standard)] hover:border-[var(--color-border-default)]"
);

export interface GoalStatsCardProps {
  totalGoals: number;
  totalSaved: number;
  nextMilestoneDate: Date | null;
  currency?: string;
  isLoading?: boolean;
  className?: string;
}

export default function GoalStatsCard({
  totalGoals,
  totalSaved,
  nextMilestoneDate,
  currency,
  isLoading = false,
  className,
}: GoalStatsCardProps) {
  const savedAmount = new Intl.NumberFormat(undefined, {
    maximumFractionDigits: 2,
  }).format(totalSaved);

  const milestoneLabel = nextMilestoneDate
    ? new Intl.DateTimeFormat(undefined, {
        month: "short",
        day: "numeric",
        year: "numeric",
      }).format(nextMilestoneDate)
    : "No upcoming milestone";

  return (
    <article
      className={cn(goalStatsCardVariants(), className)}
      aria-busy={isLoading}
    >
      <div className="flex items-start justify-between gap-[var(--space-4)]">
        <div>
          <p className="font-[var(--font-body)] text-[length:var(--text-sm)] leading-[var(--text-sm)] font-[var(--weight-medium)] text-[var(--color-text-secondary)]">
            Goal pulse
          </p>
          <h2 className="mt-[var(--space-1)] font-[var(--font-display)] text-[length:var(--text-xl)] leading-[var(--text-xl)] font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
            Your savings snapshot
          </h2>
        </div>

        {isLoading && (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-label="Calculating goal statistics"
            role="status"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}
      </div>

      <div className="mt-[var(--space-6)] grid grid-cols-[2fr_1fr] gap-[var(--space-6)]">
        <div>
          <p className="font-[var(--font-body)] text-[length:var(--text-sm)] leading-[var(--text-sm)] font-[var(--weight-regular)] text-[var(--color-text-muted)]">
            Saved across goals
          </p>
          <p className="mt-[var(--space-2)] font-[var(--font-display)] text-[length:var(--text-3xl)] leading-[var(--text-3xl)] font-[var(--weight-bold)] tabular-nums text-[var(--color-text-primary)]">
            {currency ? `${currency}${savedAmount}` : savedAmount}
          </p>
        </div>

        <div className="border-l border-[var(--color-border-subtle)] pl-[var(--space-4)]">
          <p className="font-[var(--font-body)] text-[length:var(--text-sm)] leading-[var(--text-sm)] font-[var(--weight-regular)] text-[var(--color-text-muted)]">
            Active goals
          </p>
          <p className="mt-[var(--space-2)] font-[var(--font-display)] text-[length:var(--text-2xl)] leading-[var(--text-2xl)] font-[var(--weight-semibold)] tabular-nums text-[var(--color-text-primary)]">
            {totalGoals}
          </p>
        </div>
      </div>

      <div className="mt-[var(--space-6)] border-t border-[var(--color-border-subtle)] pt-[var(--space-4)]">
        <p className="font-[var(--font-body)] text-[length:var(--text-xs)] leading-[var(--text-xs)] font-[var(--weight-medium)] text-[var(--color-text-muted)]">
          Next milestone
        </p>
        <p className="mt-[var(--space-1)] font-[var(--font-body)] text-[length:var(--text-base)] leading-[var(--text-base)] font-[var(--weight-medium)] text-[var(--color-text-primary)]">
          {milestoneLabel}
        </p>
      </div>
    </article>
  );
}