// GoalMetricsCard.tsx — Summarizes the timing, monthly contribution, and progress of a savings goal.
import * as React from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const goalMetricsCardVariants = cva(
  "w-full rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] font-[var(--font-body)] text-[var(--color-text-primary)] shadow-[var(--shadow-sm)] transition-all duration-[var(--duration-base)] ease-[var(--easing-standard)] hover:border-[var(--color-border-default)] active:border-[var(--color-accent-500)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
);

export interface GoalMetricsCardProps
  extends React.HTMLAttributes<HTMLElement> {
  daysRemaining: number;
  monthlySavingsNeeded: number;
  completionPercentage: number;
  currency?: string;
  isLoading?: boolean;
  disabled?: boolean;
}

export default function GoalMetricsCard({
  className,
  daysRemaining,
  monthlySavingsNeeded,
  completionPercentage,
  currency = "",
  isLoading = false,
  disabled = false,
  ...props
}: GoalMetricsCardProps) {
  const progress = Math.min(100, Math.max(0, completionPercentage));
  const formattedSavings = `${currency}${monthlySavingsNeeded.toLocaleString()}`;

  return (
    <section
      className={cn(goalMetricsCardVariants(), className)}
      aria-busy={isLoading}
      aria-disabled={disabled || undefined}
      aria-label="Savings goal progress metrics"
      tabIndex={disabled ? -1 : 0}
      {...props}
    >
      <div className="flex items-start justify-between gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] pb-[var(--space-4)]">
        <div>
          <p className="font-[var(--font-body)] text-sm font-[var(--weight-medium)] text-[var(--color-text-secondary)]">
            Goal progress
          </p>
          <p className="mt-[var(--space-1)] font-[var(--font-body)] text-sm text-[var(--color-text-muted)]">
            Keep your savings streak moving.
          </p>
        </div>

        {isLoading && (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}
      </div>

      {isLoading ? (
        <div className="mt-[var(--space-6)] space-y-[var(--space-4)]" aria-hidden="true">
          <div className="h-[var(--space-8)] w-[var(--space-12)] animate-pulse rounded-[var(--radius-sm)] bg-[var(--color-neutral-100)]" />
          <div className="h-[var(--space-2)] w-full animate-pulse rounded-[var(--radius-full)] bg-[var(--color-neutral-100)]" />
          <div className="grid grid-cols-2 gap-[var(--space-4)]">
            <div className="h-[var(--control-md)] animate-pulse rounded-[var(--radius-sm)] bg-[var(--color-neutral-100)]" />
            <div className="h-[var(--control-md)] animate-pulse rounded-[var(--radius-sm)] bg-[var(--color-neutral-100)]" />
          </div>
        </div>
      ) : (
        <>
          <div className="mt-[var(--space-6)]">
            <p className="font-[var(--font-body)] text-sm font-[var(--weight-medium)] text-[var(--color-text-muted)]">
              Completed
            </p>
            <p className="mt-[var(--space-1)] font-[var(--font-display)] text-3xl font-[var(--weight-semibold)] tabular-nums text-[var(--color-text-primary)]">
              {completionPercentage}%
            </p>
          </div>

          <div
            className="mt-[var(--space-4)] h-[var(--space-2)] overflow-hidden rounded-[var(--radius-full)] bg-[var(--color-neutral-100)]"
            role="progressbar"
            aria-valuemin={0}
            aria-valuemax={100}
            aria-valuenow={progress}
            aria-label={`${completionPercentage}% of goal completed`}
          >
            <div
              className="h-full rounded-[var(--radius-full)] bg-[var(--color-accent-500)] transition-[width] duration-[var(--duration-slow)] ease-[var(--easing-standard)]"
              style={{ width: `${progress}%` }}
            />
          </div>

          <div className="mt-[var(--space-6)] grid grid-cols-2 divide-x divide-[var(--color-border-subtle)]">
            <div className="pr-[var(--space-4)]">
              <p className="font-[var(--font-body)] text-sm font-[var(--weight-medium)] text-[var(--color-text-muted)]">
                Days remaining
              </p>
              <p className="mt-[var(--space-1)] font-[var(--font-display)] text-xl font-[var(--weight-semibold)] tabular-nums text-[var(--color-text-primary)]">
                {daysRemaining}
              </p>
            </div>

            <div className="pl-[var(--space-4)]">
              <p className="font-[var(--font-body)] text-sm font-[var(--weight-medium)] text-[var(--color-text-muted)]">
                Monthly savings
              </p>
              <p className="mt-[var(--space-1)] font-[var(--font-display)] text-xl font-[var(--weight-semibold)] tabular-nums text-[var(--color-text-primary)]">
                {formattedSavings}
              </p>
            </div>
          </div>
        </>
      )}
    </section>
  );
}