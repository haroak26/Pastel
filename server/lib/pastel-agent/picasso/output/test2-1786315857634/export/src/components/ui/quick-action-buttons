// QuickActionButtons.tsx — Paired budget actions for quickly logging spending or starting a savings goal.
import type { ButtonHTMLAttributes } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const quickActionVariants = cva(
  "flex w-full items-center",
  {
    variants: {
      layout: {
        horizontal: "flex-row gap-[var(--space-3)]",
        vertical: "flex-col gap-[var(--space-2)]",
        stacked: "flex-col gap-[var(--space-0)]",
      },
    },
    defaultVariants: {
      layout: "horizontal",
    },
  }
);

const actionButtonVariants = cva(
  "inline-flex items-center justify-center gap-[var(--space-2)] rounded-[var(--radius-md)] border font-[var(--font-body)] text-base font-[var(--weight-semibold)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      variant: {
        expense:
          "border-[var(--color-accent-500)] bg-[var(--color-accent-500)] text-[var(--color-text-inverse)] hover:bg-[var(--color-accent-600)] active:bg-[var(--color-accent-900)]",
        goal:
          "border-[var(--color-border-default)] bg-[var(--color-surface-raised)] text-[var(--color-text-primary)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)]",
      },
      width: {
        content: "flex-1",
        full: "w-full",
      },
      position: {
        standalone: "",
        first: "rounded-b-[var(--radius-none)]",
        last: "rounded-t-[var(--radius-none)]",
      },
    },
    defaultVariants: {
      variant: "expense",
      width: "content",
      position: "standalone",
    },
  }
);

export interface QuickActionButtonsProps
  extends VariantProps<typeof quickActionVariants> {
  onLogExpense: () => void;
  onAddGoal: () => void;
  isLoading?: boolean;
  disableExpense?: boolean;
  disableGoal?: boolean;
  className?: string;
}

interface ActionButtonProps
  extends ButtonHTMLAttributes<HTMLButtonElement> {
  loading: boolean;
  variant: "expense" | "goal";
  position: "standalone" | "first" | "last";
  fullWidth: boolean;
}

function ActionButton({
  children,
  className,
  disabled,
  loading,
  variant,
  position,
  fullWidth,
  ...props
}: ActionButtonProps) {
  return (
    <button
      className={cn(
        actionButtonVariants({
          variant,
          position,
          width: fullWidth ? "full" : "content",
        }),
        className
      )}
      disabled={disabled || loading}
      aria-busy={loading}
      {...props}
    >
      {loading && (
        <svg
          className="h-[var(--space-4)] w-[var(--space-4)] animate-[spin_var(--duration-slow)_var(--easing-standard)_infinite]"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle
            className="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            strokeWidth="4"
          />
          <path
            className="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
          />
        </svg>
      )}
      {children}
    </button>
  );
}

export default function QuickActionButtons({
  className,
  layout,
  onLogExpense,
  onAddGoal,
  isLoading = false,
  disableExpense = false,
  disableGoal = false,
}: QuickActionButtonsProps) {
  const isStacked = layout === "stacked";
  const fullWidth = layout === "vertical" || isStacked;

  return (
    <div
      className={cn(quickActionVariants({ layout }), className)}
      role="group"
      aria-label="Budget actions"
    >
      <ActionButton
        type="button"
        onClick={onLogExpense}
        disabled={disableExpense}
        loading={isLoading}
        variant="expense"
        position={isStacked ? "first" : "standalone"}
        fullWidth={fullWidth}
      >
        Log Expense
      </ActionButton>
      <ActionButton
        type="button"
        onClick={onAddGoal}
        disabled={disableGoal}
        loading={isLoading}
        variant="goal"
        position={isStacked ? "last" : "standalone"}
        fullWidth={fullWidth}
      >
        Add Goal
      </ActionButton>
    </div>
  );
}