// Logo.tsx — Wavelength brand mark and product name for the sidebar header. Use to link to the budgeting dashboard or trigger home navigation.
import React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const logoVariants = cva(
  "group inline-flex min-h-[var(--control-md)] items-center gap-[var(--space-2)] rounded-[var(--radius-md)] font-[var(--font-body)] text-[var(--weight-semibold)] text-[var(--color-text-primary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)] disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {},
  }
);

export interface LogoProps
  extends React.AnchorHTMLAttributes<HTMLAnchorElement>,
    VariantProps<typeof logoVariants> {
  href?: string;
  onClick?: () => void;
  loading?: boolean;
}

export default function Logo({
  className,
  href,
  onClick,
  loading = false,
  children,
  ...props
}: LogoProps) {
  const content = (
    <>
      <span
        className="flex h-[var(--space-8)] w-[var(--space-8)] shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-accent-500)] text-[var(--color-text-inverse)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] group-hover:bg-[var(--color-accent-600)] group-active:bg-[var(--color-accent-600)]"
        aria-hidden="true"
      >
        {loading ? (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        ) : (
          <svg
            className="h-[var(--space-6)] w-[var(--space-6)]"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
          >
            <path
              d="M3 9c2.4 0 2.4 6 4.8 6s2.4-6 4.8-6 2.4 6 4.8 6S19.8 9 22 9"
              stroke="currentColor"
              strokeLinecap="round"
              strokeLinejoin="round"
            />
            <path
              d="M3 14c2.4 0 2.4 4 4.8 4s2.4-4 4.8-4 2.4 4 4.8 4 2.4-4 4.6-4"
              stroke="currentColor"
              strokeLinecap="round"
              strokeLinejoin="round"
            />
          </svg>
        )}
      </span>
      <span className="font-[var(--font-display)] text-[var(--text-lg)] leading-[var(--text-lg)]">
        {children ?? "Wavelength"}
      </span>
    </>
  );

  return (
    <a
      href={href}
      className={cn(
        logoVariants(),
        loading && "pointer-events-none opacity-50",
        className
      )}
      onClick={onClick}
      aria-busy={loading}
      aria-disabled={loading || undefined}
      {...props}
    >
      {content}
    </a>
  );
}