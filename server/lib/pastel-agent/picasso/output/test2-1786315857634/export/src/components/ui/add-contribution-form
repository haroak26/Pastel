// AddContributionForm.tsx — Quick manual contribution form for recording an amount and optional note in Wavelength.
import type { FormEvent } from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const addContributionFormVariants = cva(
  "flex w-full flex-col gap-[var(--space-6)] rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] shadow-[var(--shadow-sm)]"
);

export interface AddContributionFormProps {
  amount: number;
  onAmountChange: (amount: number) => void;
  note?: string;
  onNoteChange?: (note: string) => void;
  onSubmit: () => void;
  isLoading?: boolean;
  error?: string | null;
  className?: string;
}

export default function AddContributionForm({
  amount,
  onAmountChange,
  note = "",
  onNoteChange,
  onSubmit,
  isLoading = false,
  error = null,
  className,
}: AddContributionFormProps) {
  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    onSubmit();
  };

  return (
    <form
      className={cn(addContributionFormVariants(), className)}
      onSubmit={handleSubmit}
      aria-busy={isLoading}
      aria-describedby={error ? "add-contribution-error" : undefined}
    >
      <div className="flex flex-col gap-[var(--space-2)]">
        <label
          htmlFor="contribution-amount"
          className="font-[var(--font-body)] text-[var(--color-text-secondary)] font-[var(--weight-semibold)]"
          style={{ font: "var(--text-sm) var(--font-body)" }}
        >
          Contribution amount
        </label>
        <div className="relative">
          <span
            className="pointer-events-none absolute inset-y-0 left-[var(--space-4)] flex items-center text-[var(--color-text-muted)] font-[var(--weight-medium)]"
            style={{ font: "var(--text-lg) var(--font-body)" }}
            aria-hidden="true"
          >
            $
          </span>
          <input
            id="contribution-amount"
            name="amount"
            type="number"
            inputMode="decimal"
            min="0"
            step="0.01"
            value={amount}
            onChange={(event) => onAmountChange(Number(event.target.value))}
            disabled={isLoading}
            aria-invalid={Boolean(error)}
            aria-describedby={error ? "add-contribution-error" : undefined}
            className="h-[var(--control-lg)] w-full rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-overlay)] pl-[var(--space-8)] pr-[var(--space-4)] text-[var(--color-text-primary)] font-[var(--weight-semibold)] tabular-nums outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-neutral-500)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:border-[var(--color-accent-500)] disabled:pointer-events-none disabled:opacity-50"
            style={{ font: "var(--text-lg) var(--font-body)" }}
          />
        </div>
      </div>

      <div className="flex flex-col gap-[var(--space-2)]">
        <label
          htmlFor="contribution-note"
          className="text-[var(--color-text-secondary)] font-[var(--weight-semibold)]"
          style={{ font: "var(--text-sm) var(--font-body)" }}
        >
          Note
          <span
            className="ml-[var(--space-1)] text-[var(--color-text-muted)] font-[var(--weight-regular)]"
            style={{ font: "var(--text-xs) var(--font-body)" }}
          >
            optional
          </span>
        </label>
        <input
          id="contribution-note"
          name="note"
          type="text"
          value={note}
          onChange={(event) => onNoteChange?.(event.target.value)}
          readOnly={!onNoteChange}
          disabled={isLoading}
          className="h-[var(--control-md)] w-full rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-overlay)] px-[var(--space-4)] text-[var(--color-text-primary)] outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-neutral-500)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:border-[var(--color-accent-500)] disabled:pointer-events-none disabled:opacity-50"
          style={{ font: "var(--text-base) var(--font-body)" }}
        />
      </div>

      {error && (
        <p
          id="add-contribution-error"
          role="alert"
          className="rounded-[var(--radius-sm)] bg-[var(--color-danger-50)] px-[var(--space-3)] py-[var(--space-2)] text-[var(--color-danger-900)]"
          style={{ font: "var(--text-sm) var(--font-body)" }}
        >
          {error}
        </p>
      )}

      <button
        type="submit"
        disabled={isLoading}
        aria-busy={isLoading}
        className="inline-flex h-[var(--control-md)] items-center justify-center gap-[var(--space-2)] rounded-[var(--radius-md)] bg-[var(--color-accent-500)] px-[var(--space-4)] text-[var(--color-text-inverse)] font-[var(--weight-semibold)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-accent-600)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:bg-[var(--color-accent-600)] disabled:pointer-events-none disabled:opacity-50"
        style={{ font: "var(--text-base) var(--font-body)" }}
      >
        {isLoading && (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}
        {isLoading ? "Adding contribution" : "Add contribution"}
      </button>
    </form>
  );
}