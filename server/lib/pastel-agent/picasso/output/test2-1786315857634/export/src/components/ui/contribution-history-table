// ContributionHistoryTable.tsx — Displays a clear record of money added to a Wavelength budget, including timing, source, amount, and personal notes.
import React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const contributionHistoryTableVariants = cva(
  "overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] shadow-[var(--shadow-sm)] font-[var(--font-body)] text-[var(--color-text-primary)]",
  {
    variants: {},
  }
);

export interface Contribution {
  id: string;
  date: Date;
  amount: number;
  source: "manual" | "auto-save";
  notes?: string;
}

export interface ContributionHistoryTableProps
  extends React.HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof contributionHistoryTableVariants> {
  contributions: Contribution[];
  currency?: string;
  isLoading?: boolean;
}

function formatAmount(amount: number, currency?: string) {
  const formattedAmount = amount.toLocaleString(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

  if (!currency) {
    return formattedAmount;
  }

  if (/^[A-Z]{3}$/.test(currency)) {
    return new Intl.NumberFormat(undefined, {
      style: "currency",
      currency,
      minimumFractionDigits: 2,
      maximumFractionDigits: 2,
    }).format(amount);
  }

  return `${currency}${formattedAmount}`;
}

function formatDate(date: Date) {
  return date.toLocaleDateString(undefined, {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}

export default function ContributionHistoryTable({
  className,
  contributions,
  currency,
  isLoading = false,
  ...props
}: ContributionHistoryTableProps) {
  return (
    <div
      className={cn(contributionHistoryTableVariants(), className)}
      aria-busy={isLoading}
      {...props}
    >
      <div className="border-b border-[var(--color-border-subtle)] px-[var(--space-4)] py-[var(--space-4)]">
        <h2 className="font-[var(--font-display)] text-lg font-[var(--weight-semibold)]">
          Contribution history
        </h2>
        <p className="mt-[var(--space-1)] text-sm text-[var(--color-text-muted)]">
          Every deposit helping your budget move forward.
        </p>
      </div>

      <div className="overflow-x-auto">
        <table className="w-full min-w-[var(--space-24)] border-collapse text-left">
          <caption className="sr-only">Contribution history</caption>
          <thead>
            <tr className="border-b border-[var(--color-border-default)] bg-[var(--color-neutral-50)]">
              <th
                scope="col"
                className="px-[var(--space-4)] py-[var(--space-3)] text-xs font-[var(--weight-semibold)] text-[var(--color-text-muted)]"
              >
                Date
              </th>
              <th
                scope="col"
                className="px-[var(--space-4)] py-[var(--space-3)] text-right text-xs font-[var(--weight-semibold)] text-[var(--color-text-muted)]"
              >
                Amount
              </th>
              <th
                scope="col"
                className="px-[var(--space-4)] py-[var(--space-3)] text-xs font-[var(--weight-semibold)] text-[var(--color-text-muted)]"
              >
                Source
              </th>
              <th
                scope="col"
                className="px-[var(--space-4)] py-[var(--space-3)] text-xs font-[var(--weight-semibold)] text-[var(--color-text-muted)]"
              >
                Notes
              </th>
            </tr>
          </thead>

          <tbody>
            {isLoading ? (
              <tr>
                <td
                  colSpan={4}
                  className="px-[var(--space-4)] py-[var(--space-6)] text-center text-sm text-[var(--color-text-muted)]"
                >
                  <span className="inline-flex items-center gap-[var(--space-2)]">
                    <svg
                      className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <circle
                        className="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        strokeWidth="4"
                      />
                      <path
                        className="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                      />
                    </svg>
                    Loading contributions
                  </span>
                </td>
              </tr>
            ) : contributions.length === 0 ? (
              <tr>
                <td
                  colSpan={4}
                  className="px-[var(--space-4)] py-[var(--space-6)] text-center text-sm text-[var(--color-text-muted)]"
                >
                  No contributions recorded yet.
                </td>
              </tr>
            ) : (
              contributions.map((contribution) => (
                <tr
                  key={contribution.id}
                  className="border-b border-[var(--color-border-subtle)] last:border-b-0"
                >
                  <td className="whitespace-nowrap px-[var(--space-4)] py-[var(--space-4)] text-sm">
                    {formatDate(contribution.date)}
                  </td>
                  <td className="whitespace-nowrap px-[var(--space-4)] py-[var(--space-4)] text-right font-[var(--font-mono)] text-sm font-[var(--weight-medium)] tabular-nums">
                    {formatAmount(contribution.amount, currency)}
                  </td>
                  <td className="px-[var(--space-4)] py-[var(--space-4)] text-sm">
                    <span
                      className={cn(
                        "inline-flex items-center rounded-[var(--radius-full)] px-[var(--space-2)] py-[var(--space-1)] text-xs font-[var(--weight-medium)]",
                        contribution.source === "auto-save"
                          ? "bg-[var(--color-success-50)] text-[var(--color-success-900)]"
                          : "bg-[var(--color-neutral-100)] text-[var(--color-text-secondary)]"
                      )}
                    >
                      {contribution.source === "auto-save"
                        ? "Auto-save"
                        : "Manual"}
                    </span>
                  </td>
                  <td className="max-w-[var(--space-24)] px-[var(--space-4)] py-[var(--space-4)] text-sm text-[var(--color-text-secondary)]">
                    {contribution.notes || ""}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}