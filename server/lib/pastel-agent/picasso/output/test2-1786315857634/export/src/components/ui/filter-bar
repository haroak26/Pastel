// FilterBar.tsx — Transaction filters for Wavelength’s date, category, and spending-range controls.
import React, { useEffect, useRef, useState } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const filterBarVariants = cva(
  "relative flex w-full flex-wrap items-end border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] font-[var(--font-body)] text-[var(--color-text-primary)] transition-colors duration-[var(--duration-base)] ease-[var(--easing-standard)] hover:border-[var(--color-neutral-400)] focus-within:border-[var(--color-border-focus)]",
  {
    variants: {
      density: {
        compact:
          "gap-[var(--space-2)] rounded-[var(--radius-md)] p-[var(--space-3)]",
        normal:
          "gap-[var(--space-3)] rounded-[var(--radius-lg)] p-[var(--space-4)]",
        spacious:
          "gap-[var(--space-4)] rounded-[var(--radius-lg)] p-[var(--space-6)]",
      },
    },
    defaultVariants: {
      density: "normal",
    },
  }
);

export interface FilterBarProps
  extends React.HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof filterBarVariants> {
  dateRange: {
    startDate: Date;
    endDate: Date;
  };
  onDateRangeChange: (range: {
    startDate: Date;
    endDate: Date;
  }) => void;
  selectedCategories: string[];
  onCategoryChange: (categories: string[]) => void;
  amountRange: {
    min: number;
    max: number;
  };
  onAmountRangeChange: (range: { min: number; max: number }) => void;
  availableCategories: Array<{
    id: string;
    name: string;
    icon: string;
  }>;
  loading?: boolean;
}

function formatDateInputValue(date: Date) {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");

  return `${year}-${month}-${day}`;
}

function parseDateInputValue(value: string, fallback: Date) {
  if (!value) {
    return fallback;
  }

  const [year, month, day] = value.split("-").map(Number);
  const nextDate = new Date(year, month - 1, day);

  return Number.isNaN(nextDate.getTime()) ? fallback : nextDate;
}

export default function FilterBar({
  className,
  density,
  dateRange,
  onDateRangeChange,
  selectedCategories,
  onCategoryChange,
  amountRange,
  onAmountRangeChange,
  availableCategories,
  loading = false,
  ...props
}: FilterBarProps) {
  const [categoryMenuOpen, setCategoryMenuOpen] = useState(false);
  const categoryMenuRef = useRef<HTMLDivElement>(null);

  useEffect(() => {
    function handlePointerDown(event: PointerEvent) {
      if (
        categoryMenuRef.current &&
        !categoryMenuRef.current.contains(event.target as Node)
      ) {
        setCategoryMenuOpen(false);
      }
    }

    function handleKeyDown(event: KeyboardEvent) {
      if (event.key === "Escape") {
        setCategoryMenuOpen(false);
      }
    }

    document.addEventListener("pointerdown", handlePointerDown);
    document.addEventListener("keydown", handleKeyDown);

    return () => {
      document.removeEventListener("pointerdown", handlePointerDown);
      document.removeEventListener("keydown", handleKeyDown);
    };
  }, []);

  const amountMaximum = Math.max(amountRange.max, amountRange.min + 1);
  const selectedCategoryNames = availableCategories
    .filter((category) => selectedCategories.includes(category.id))
    .map((category) => category.name);

  const categorySummary =
    selectedCategoryNames.length > 0
      ? selectedCategoryNames.join(", ")
      : "All categories";

  function toggleCategory(categoryId: string) {
    const nextCategories = selectedCategories.includes(categoryId)
      ? selectedCategories.filter((id) => id !== categoryId)
      : [...selectedCategories, categoryId];

    onCategoryChange(nextCategories);
  }

  return (
    <div
      className={cn(filterBarVariants({ density }), className)}
      aria-busy={loading}
      {...props}
    >
      {loading && (
        <svg
          className="absolute right-[var(--space-3)] top-[var(--space-3)] h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle
            className="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            strokeWidth="4"
          />
          <path
            className="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
          />
        </svg>
      )}

      <fieldset
        className="flex w-full flex-wrap items-end gap-[var(--space-3)] disabled:pointer-events-none disabled:opacity-50"
        disabled={loading}
      >
        <legend className="sr-only">Transaction filters</legend>

        <div className="flex min-w-[var(--control-lg)] flex-1 flex-col gap-[var(--space-1)]">
          <label
            htmlFor="filter-start-date"
            className="text-[length:var(--text-xs)] font-[var(--weight-semibold)] text-[var(--color-text-secondary)]"
          >
            Start date
          </label>
          <input
            id="filter-start-date"
            type="date"
            value={formatDateInputValue(dateRange.startDate)}
            onChange={(event) =>
              onDateRangeChange({
                startDate: parseDateInputValue(
                  event.target.value,
                  dateRange.startDate
                ),
                endDate: dateRange.endDate,
              })
            }
            className="h-[var(--control-md)] min-w-0 rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-overlay)] px-[var(--space-3)] font-[var(--font-body)] text-[length:var(--text-sm)] text-[var(--color-text-primary)] outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-neutral-400)] focus-visible:border-[var(--color-border-focus)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:border-[var(--color-accent-600)] disabled:pointer-events-none disabled:opacity-50"
          />
        </div>

        <div className="flex min-w-[var(--control-lg)] flex-1 flex-col gap-[var(--space-1)]">
          <label
            htmlFor="filter-end-date"
            className="text-[length:var(--text-xs)] font-[var(--weight-semibold)] text-[var(--color-text-secondary)]"
          >
            End date
          </label>
          <input
            id="filter-end-date"
            type="date"
            value={formatDateInputValue(dateRange.endDate)}
            onChange={(event) =>
              onDateRangeChange({
                startDate: dateRange.startDate,
                endDate: parseDateInputValue(
                  event.target.value,
                  dateRange.endDate
                ),
              })
            }
            className="h-[var(--control-md)] min-w-0 rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-overlay)] px-[var(--space-3)] font-[var(--font-body)] text-[length:var(--text-sm)] text-[var(--color-text-primary)] outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-neutral-400)] focus-visible:border-[var(--color-border-focus)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:border-[var(--color-accent-600)] disabled:pointer-events-none disabled:opacity-50"
          />
        </div>

        <div
          ref={categoryMenuRef}
          className="relative min-w-[var(--control-lg)] flex-[1.2]"
        >
          <label
            htmlFor="filter-category-trigger"
            className="mb-[var(--space-1)] block text-[length:var(--text-xs)] font-[var(--weight-semibold)] text-[var(--color-text-secondary)]"
          >
            Categories
          </label>
          <button
            id="filter-category-trigger"
            type="button"
            aria-expanded={categoryMenuOpen}
            aria-haspopup="listbox"
            onClick={() => setCategoryMenuOpen((open) => !open)}
            className="flex h-[var(--control-md)] w-full items-center justify-between gap-[var(--space-2)] rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-overlay)] px-[var(--space-3)] text-left text-[length:var(--text-sm)] text-[var(--color-text-primary)] outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-neutral-400)] hover:bg-[var(--color-neutral-50)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:border-[var(--color-accent-600)] disabled:pointer-events-none disabled:opacity-50"
          >
            <span className="truncate">{categorySummary}</span>
            <span
              className={cn(
                "text-[var(--color-text-muted)] transition-transform duration-[var(--duration-fast)]",
                categoryMenuOpen && "rotate-180"
              )}
              aria-hidden="true"
            >
              ▾
            </span>
          </button>

          {categoryMenuOpen && (
            <div
              role="listbox"
              aria-label="Transaction categories"
              aria-multiselectable="true"
              className="absolute left-0 right-0 top-full z-10 mt-[var(--space-1)] max-h-[var(--space-16)] overflow-y-auto rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-overlay)] p-[var(--space-1)] shadow-[var(--shadow-md)]"
            >
              {availableCategories.map((category) => {
                const selected = selectedCategories.includes(category.id);

                return (
                  <label
                    key={category.id}
                    role="option"
                    aria-selected={selected}
                    className="flex min-h-[var(--control-md)] cursor-pointer items-center gap-[var(--space-2)] rounded-[var(--radius-sm)] px-[var(--space-2)] text-[length:var(--text-sm)] transition-colors duration-[var(--duration-fast)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)]"
                  >
                    <input
                      type="checkbox"
                      checked={selected}
                      onChange={() => toggleCategory(category.id)}
                      className="h-[var(--space-4)] w-[var(--space-4)] accent-[var(--color-accent-500)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2"
                    />
                    <span aria-hidden="true">{category.icon}</span>
                    <span className="truncate">{category.name}</span>
                  </label>
                );
              })}
            </div>
          )}
        </div>

        <div className="min-w-[var(--control-lg)] flex-[1.4]">
          <div className="mb-[var(--space-1)] flex items-center justify-between gap-[var(--space-2)]">
            <span className="text-[length:var(--text-xs)] font-[var(--weight-semibold)] text-[var(--color-text-secondary)]">
              Amount range
            </span>
            <span className="font-[var(--font-mono)] text-[length:var(--text-xs)] tabular-nums text-[var(--color-text-muted)]">
              {amountRange.min}–{amountRange.max}
            </span>
          </div>

          <div className="relative flex h-[var(--control-md)] items-center px-[var(--space-1)]">
            <div className="absolute left-[var(--space-1)] right-[var(--space-1)] h-[var(--space-1)] rounded-[var(--radius-full)] bg-[var(--color-neutral-200)]" />
            <input
              aria-label="Minimum transaction amount"
              type="range"
              min={0}
              max={amountMaximum}
              value={Math.min(amountRange.min, amountMaximum)}
              onChange={(event) =>
                onAmountRangeChange({
                  min: Math.min(Number(event.target.value), amountRange.max),
                  max: amountRange.max,
                })
              }
              className="pointer-events-none absolute h-[var(--space-4)] w-full appearance-none bg-transparent accent-[var(--color-accent-500)] [&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:h-[var(--space-4)] [&::-webkit-slider-thumb]:w-[var(--space-4)] [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-[var(--radius-full)] [&::-webkit-slider-thumb]:border-2 [&::-webkit-slider-thumb]:border-[var(--color-accent-500)] [&::-webkit-slider-thumb]:bg-[var(--color-surface-overlay)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:opacity-50"
            />
            <input
              aria-label="Maximum transaction amount"
              type="range"
              min={0}
              max={amountMaximum}
              value={Math.max(amountRange.max, amountRange.min)}
              onChange={(event) =>
                onAmountRangeChange({
                  min: amountRange.min,
                  max: Math.max(Number(event.target.value), amountRange.min),
                })
              }
              className="pointer-events-none absolute h-[var(--space-4)] w-full appearance-none bg-transparent accent-[var(--color-accent-500)] [&::-webkit-slider-thumb]:pointer-events-auto [&::-webkit-slider-thumb]:h-[var(--space-4)] [&::-webkit-slider-thumb]:w-[var(--space-4)] [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:rounded-[var(--radius-full)] [&::-webkit-slider-thumb]:border-2 [&::-webkit-slider-thumb]:border-[var(--color-accent-500)] [&::-webkit-slider-thumb]:bg-[var(--color-surface-overlay)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:opacity-50"
            />
          </div>
        </div>
      </fieldset>
    </div>
  );
}