// TransactionStatsCard.tsx — Summarizes filtered spending, transaction volume, and average transaction size for the Wavelength dashboard.
import type { HTMLAttributes } from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const transactionStatsCardVariants = cva(
  "rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] font-[var(--font-body)] shadow-[var(--shadow-sm)] transition-colors duration-[var(--duration-base)] ease-[var(--easing-standard)]"
);

export interface TransactionStatsCardProps
  extends HTMLAttributes<HTMLElement> {
  totalSpent: number;
  transactionCount: number;
  averageTransaction: number;
  currency?: string;
  isLoading?: boolean;
}

function formatAmount(amount: number, currency?: string) {
  const formattedAmount = new Intl.NumberFormat(undefined, {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(amount);

  return currency ? `${currency}${formattedAmount}` : formattedAmount;
}

export default function TransactionStatsCard({
  className,
  totalSpent,
  transactionCount,
  averageTransaction,
  currency,
  isLoading = false,
  ...props
}: TransactionStatsCardProps) {
  return (
    <article
      className={cn(transactionStatsCardVariants(), className)}
      aria-busy={isLoading}
      {...props}
    >
      <div className="flex items-start justify-between gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] pb-[var(--space-4)]">
        <div>
          <p
            className="text-[var(--color-text-muted)]"
            style={{
              font: "var(--text-sm) var(--font-body)",
              fontWeight: "var(--weight-medium)",
            }}
          >
            Spending snapshot
          </p>
          <p
            className="mt-[var(--space-1)] text-[var(--color-text-primary)]"
            style={{
              font: "var(--text-xs) var(--font-body)",
              fontWeight: "var(--weight-regular)",
            }}
          >
            Filtered transactions
          </p>
        </div>

        {isLoading && (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-label="Calculating spending stats"
            role="status"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}
      </div>

      <div className="mt-[var(--space-6)]">
        <p
          className="text-[var(--color-accent-500)] tabular-nums"
          style={{
            font: "var(--text-3xl) var(--font-display)",
            fontWeight: "var(--weight-semibold)",
          }}
        >
          {formatAmount(totalSpent, currency)}
        </p>
        <p
          className="mt-[var(--space-1)] text-[var(--color-text-secondary)]"
          style={{
            font: "var(--text-sm) var(--font-body)",
            fontWeight: "var(--weight-regular)",
          }}
        >
          Total spent
        </p>
      </div>

      <dl className="mt-[var(--space-6)] grid grid-cols-2 divide-x divide-[var(--color-border-subtle)] border-t border-[var(--color-border-subtle)] pt-[var(--space-4)]">
        <div className="pr-[var(--space-4)]">
          <dt
            className="text-[var(--color-text-muted)]"
            style={{
              font: "var(--text-xs) var(--font-body)",
              fontWeight: "var(--weight-medium)",
            }}
          >
            Transactions
          </dt>
          <dd
            className="mt-[var(--space-1)] text-[var(--color-text-primary)] tabular-nums"
            style={{
              font: "var(--text-lg) var(--font-display)",
              fontWeight: "var(--weight-semibold)",
            }}
          >
            {transactionCount.toLocaleString()}
          </dd>
        </div>

        <div className="pl-[var(--space-4)]">
          <dt
            className="text-[var(--color-text-muted)]"
            style={{
              font: "var(--text-xs) var(--font-body)",
              fontWeight: "var(--weight-medium)",
            }}
          >
            Average size
          </dt>
          <dd
            className="mt-[var(--space-1)] text-[var(--color-text-primary)] tabular-nums"
            style={{
              font: "var(--text-lg) var(--font-display)",
              fontWeight: "var(--weight-semibold)",
            }}
          >
            {formatAmount(averageTransaction, currency)}
          </dd>
        </div>
      </dl>
    </article>
  );
}