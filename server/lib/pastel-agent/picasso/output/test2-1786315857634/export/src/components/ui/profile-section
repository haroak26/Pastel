// ProfileSection.tsx — Displays a Wavelength user's identity and profile editing action. Use in account settings and dashboard account areas.
import React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const profileSectionVariants = cva(
  "flex items-center justify-between gap-[var(--space-6)] rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] shadow-[var(--shadow-sm)] transition-all duration-[var(--duration-base)] ease-[var(--easing-standard)]",
  {
    variants: {},
  }
);

const editButtonVariants = cva(
  "inline-flex h-[var(--control-md)] shrink-0 items-center justify-center gap-[var(--space-2)] rounded-[var(--radius-md)] border border-[var(--color-border-default)] px-[var(--space-4)] font-[var(--weight-medium)] text-[var(--color-text-primary)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-accent-500)] hover:bg-[var(--color-accent-50)] active:bg-[var(--color-accent-100)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {},
  }
);

export interface ProfileSectionProps
  extends React.HTMLAttributes<HTMLElement>,
    VariantProps<typeof profileSectionVariants> {
  avatar: string;
  name: string;
  email: string;
  onEditProfile: () => void;
  isLoading?: boolean;
}

export default function ProfileSection({
  avatar,
  name,
  email,
  onEditProfile,
  isLoading = false,
  className,
  ...props
}: ProfileSectionProps) {
  return (
    <section
      className={cn(profileSectionVariants(), className)}
      aria-busy={isLoading}
      aria-label={`${name} profile`}
      {...props}
    >
      <div className="flex min-w-0 items-center gap-[var(--space-4)]">
        <img
          src={avatar}
          alt={`${name}'s avatar`}
          className="h-[var(--control-lg)] w-[var(--control-lg)] shrink-0 rounded-[var(--radius-full)] object-cover"
        />

        <div className="min-w-0">
          <h2
            className="truncate font-[var(--font-display)] text-[var(--text-lg)] font-[var(--weight-semibold)] text-[var(--color-text-primary)]"
          >
            {name}
          </h2>
          <p
            className="truncate font-[var(--font-body)] text-[var(--text-sm)] font-[var(--weight-regular)] text-[var(--color-text-muted)]"
          >
            {email}
          </p>
        </div>
      </div>

      <button
        type="button"
        className={cn(editButtonVariants())}
        onClick={onEditProfile}
        disabled={isLoading}
        aria-busy={isLoading}
      >
        {isLoading && (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}
        {isLoading ? "Loading profile" : "Edit profile"}
      </button>
    </section>
  );
}