// BudgetStatusList.tsx — Spending category list with progress and budget health signals. Use on dashboard budget summaries and category drill-downs.
import type { CSSProperties, HTMLAttributes } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const budgetStatusListVariants = cva(
  "w-full overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] font-[var(--font-body)]",
  {
    variants: {
      sortBy: {
        category: "",
        remaining: "",
        status: "",
      },
    },
    defaultVariants: {
      sortBy: "category",
    },
  }
);

const budgetRowVariants = cva(
  "group flex w-full items-center gap-[var(--space-3)] border-b border-[var(--color-border-subtle)] px-[var(--space-4)] py-[var(--space-3)] text-left transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] last:border-b-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-inset active:bg-[var(--color-neutral-100)] disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      interactive: {
        true: "cursor-pointer hover:bg-[var(--color-neutral-50)]",
        false: "cursor-default",
      },
    },
    defaultVariants: {
      interactive: false,
    },
  }
);

const statusStyles = {
  "on-track": {
    label: "On track",
    text: "text-[var(--color-success-900)]",
    background: "bg-[var(--color-success-50)]",
    progress: "bg-[var(--color-success-500)]",
  },
  warning: {
    label: "Warning",
    text: "text-[var(--color-warning-900)]",
    background: "bg-[var(--color-warning-50)]",
    progress: "bg-[var(--color-warning-500)]",
  },
  over: {
    label: "Over budget",
    text: "text-[var(--color-danger-900)]",
    background: "bg-[var(--color-danger-50)]",
    progress: "bg-[var(--color-danger-500)]",
  },
} as const;

export interface BudgetStatusListProps
  extends HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof budgetStatusListVariants> {
  budgets: Array<{
    id: string;
    category: string;
    limit: number;
    spent: number;
    status: "on-track" | "warning" | "over";
  }>;
  currency?: string;
  onCategoryClick?: (categoryId: string) => void;
  isLoading?: boolean;
}

function formatAmount(amount: number, currency?: string) {
  const formatted = new Intl.NumberFormat(undefined, {
    maximumFractionDigits: 0,
  }).format(Math.abs(amount));

  if (!currency) {
    return amount < 0 ? `-${formatted}` : formatted;
  }

  return amount < 0
    ? `-${currency}${formatted}`
    : `${currency}${formatted}`;
}

export default function BudgetStatusList({
  budgets,
  currency,
  onCategoryClick,
  isLoading = false,
  sortBy,
  className,
  ...props
}: BudgetStatusListProps) {
  const resolvedSortBy = sortBy ?? "category";

  const sortedBudgets = [...budgets].sort((a, b) => {
    if (resolvedSortBy === "remaining") {
      return b.limit - b.spent - (a.limit - a.spent);
    }

    if (resolvedSortBy === "status") {
      const statusRank = { over: 0, warning: 1, "on-track": 2 };
      return statusRank[a.status] - statusRank[b.status];
    }

    return a.category.localeCompare(b.category);
  });

  return (
    <div
      className={cn(
        budgetStatusListVariants({ sortBy: resolvedSortBy }),
        className
      )}
      aria-busy={isLoading}
      data-sort-by={resolvedSortBy}
      {...props}
    >
      {isLoading ? (
        <div className="flex min-h-[var(--control-lg)] items-center gap-[var(--space-3)] px-[var(--space-4)] py-[var(--space-6)] text-[var(--color-text-secondary)]">
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-[spin_var(--duration-slow)_linear_infinite]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
          <span className="text-sm">Updating your budget picture…</span>
        </div>
      ) : sortedBudgets.length === 0 ? (
        <div className="px-[var(--space-4)] py-[var(--space-6)] text-[var(--color-text-secondary)]">
          <p className="font-[var(--font-display)] text-base font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
            No budget categories yet
          </p>
          <p className="mt-[var(--space-1)] text-sm">
            Add a category to start tracking where your money goes.
          </p>
        </div>
      ) : (
        <ul aria-label="Budget categories">
          {sortedBudgets.map((budget) => {
            const remaining = budget.limit - budget.spent;
            const progress = budget.limit > 0
              ? Math.min(Math.max((budget.spent / budget.limit) * 100, 0), 100)
              : 0;
            const status = statusStyles[budget.status];
            const progressStyle = {
              "--budget-progress": `${progress}%`,
            } as CSSProperties;

            const rowContent = (
              <>
                <div className="min-w-0 flex-1">
                  <div className="flex items-center justify-between gap-[var(--space-3)]">
                    <span className="truncate font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
                      {budget.category}
                    </span>
                    <span
                      className={cn(
                        "shrink-0 rounded-[var(--radius-full)] px-[var(--space-2)] py-[var(--space-1)] text-xs font-[var(--weight-medium)]",
                        status.background,
                        status.text
                      )}
                    >
                      {status.label}
                    </span>
                  </div>

                  <div className="mt-[var(--space-2)] h-[var(--space-2)] overflow-hidden rounded-[var(--radius-full)] bg-[var(--color-neutral-100)]">
                    <div
                      className={cn(
                        "h-full rounded-[var(--radius-full)] transition-[width] duration-[var(--duration-base)] ease-[var(--easing-standard)]",
                        status.progress
                      )}
                      style={progressStyle}
                      role="progressbar"
                      aria-label={`${budget.category} spending progress`}
                      aria-valuemin={0}
                      aria-valuemax={budget.limit}
                      aria-valuenow={Math.min(Math.max(budget.spent, 0), budget.limit)}
                    />
                  </div>

                  <div className="mt-[var(--space-2)] flex items-center justify-between gap-[var(--space-3)] text-sm text-[var(--color-text-muted)]">
                    <span>
                      {formatAmount(budget.spent, currency)} of{" "}
                      {formatAmount(budget.limit, currency)}
                    </span>
                    <span
                      className={cn(
                        "font-[var(--font-mono)] tabular-nums font-[var(--weight-medium)]",
                        budget.status === "over"
                          ? "text-[var(--color-danger-500)]"
                          : "text-[var(--color-text-primary)]"
                      )}
                    >
                      {formatAmount(remaining, currency)}{" "}
                      {remaining < 0 ? "over" : "left"}
                    </span>
                  </div>
                </div>

                {onCategoryClick && (
                  <span
                    className="shrink-0 text-lg text-[var(--color-text-muted)] transition-transform duration-[var(--duration-fast)] group-hover:translate-x-[var(--space-1)]"
                    aria-hidden="true"
                  >
                    →
                  </span>
                )}
              </>
            );

            return (
              <li key={budget.id}>
                {onCategoryClick ? (
                  <button
                    type="button"
                    className={cn(budgetRowVariants({ interactive: true }))}
                    onClick={() => onCategoryClick(budget.id)}
                    disabled={isLoading}
                    aria-label={`View ${budget.category} budget`}
                  >
                    {rowContent}
                  </button>
                ) : (
                  <div className={cn(budgetRowVariants({ interactive: false }))}>
                    {rowContent}
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      )}
    </div>
  );
}