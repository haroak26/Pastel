// NavigationMenu.tsx — Primary Wavelength navigation for switching between money views. Use for the app’s persistent desktop navigation.
import * as React from "react";
import { NavigationMenu as NavigationMenuPrimitive } from "@radix-ui/react-navigation-menu";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const navigationMenuItemVariants = cva(
  "group inline-flex min-h-[var(--control-md)] w-full items-center gap-[var(--space-3)] rounded-[var(--radius-md)] px-[var(--space-3)] font-[var(--font-body)] text-[length:var(--text-base)] font-[var(--weight-medium)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:translate-y-[var(--space-1)] disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      state: {
        inactive:
          "text-[var(--color-text-secondary)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)]",
        active:
          "bg-[var(--color-accent-50)] text-[var(--color-accent-900)] hover:bg-[var(--color-accent-100)] active:bg-[var(--color-accent-100)]",
      },
    },
    defaultVariants: {
      state: "inactive",
    },
  }
);

export interface NavigationMenuItem {
  id: string;
  label: string;
  href: string;
  icon: string;
}

export interface NavigationMenuProps
  extends Omit<
      React.ComponentPropsWithoutRef<typeof NavigationMenuPrimitive.Root>,
      "children"
    >,
    VariantProps<typeof navigationMenuItemVariants> {
  items: NavigationMenuItem[];
  activeItemId: string;
  onItemClick: (itemId: string) => void;
  disabled?: boolean;
  loading?: boolean;
}

export default function NavigationMenu({
  className,
  items,
  activeItemId,
  onItemClick,
  disabled = false,
  loading = false,
  ...props
}: NavigationMenuProps) {
  const isDisabled = disabled || loading;

  return (
    <NavigationMenuPrimitive.Root
      className={cn("w-full", className)}
      aria-label="Primary navigation"
      aria-busy={loading}
      {...props}
    >
      <NavigationMenuPrimitive.List className="flex w-full flex-col gap-[var(--space-1)]">
        {items.map((item) => {
          const isActive = item.id === activeItemId;

          return (
            <NavigationMenuPrimitive.Item key={item.id} className="w-full">
              <NavigationMenuPrimitive.Link
                href={item.href}
                aria-current={isActive ? "page" : undefined}
                aria-disabled={isDisabled ? "true" : undefined}
                tabIndex={isDisabled ? -1 : undefined}
                className={cn(
                  navigationMenuItemVariants({
                    state: isActive ? "active" : "inactive",
                  }),
                  isDisabled && "pointer-events-none opacity-50"
                )}
                onClick={(event) => {
                  if (isDisabled) {
                    event.preventDefault();
                    return;
                  }

                  onItemClick(item.id);
                }}
              >
                {loading && (
                  <svg
                    className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <circle
                      className="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      strokeWidth="4"
                    />
                    <path
                      className="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                    />
                  </svg>
                )}

                {!loading && (
                  <span
                    className="inline-flex h-[var(--space-6)] w-[var(--space-6)] shrink-0 items-center justify-center font-[var(--font-mono)] text-[length:var(--text-sm)] font-[var(--weight-semibold)]"
                    aria-hidden="true"
                  >
                    {item.icon}
                  </span>
                )}

                <span className="truncate">{item.label}</span>
              </NavigationMenuPrimitive.Link>
            </NavigationMenuPrimitive.Item>
          );
        })}
      </NavigationMenuPrimitive.List>
    </NavigationMenuPrimitive.Root>
  );
}