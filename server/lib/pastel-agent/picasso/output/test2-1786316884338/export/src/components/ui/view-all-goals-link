import React from "react";
import { cn } from "../lib/cn";

export interface ViewAllGoalsLinkProps
  extends React.AnchorHTMLAttributes<HTMLAnchorElement> {
  onClick: () => void;
  label?: string;
}

export default function ViewAllGoalsLink({
  onClick,
  label = "View all goals",
  className,
  ...props
}: ViewAllGoalsLinkProps) {
  return (
    <a
      onClick={onClick}
      className={cn(
        "inline-flex items-center gap-1 font-[var(--weight-medium)] text-[var(--color-accent-500)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:text-[var(--color-accent-600)] active:text-[var(--color-accent-700)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 cursor-pointer",
        className
      )}
      role="button"
      tabIndex={0}
      onKeyDown={(e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          onClick();
        }
      }}
      {...props}
    >
      {label}
      <svg
        className="w-4 h-4"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path
          strokeLinecap="round"
          strokeLinejoin="round"
          strokeWidth={2}
          d="M9 5l7 7-7 7"
        />
      </svg>
    </a>
  );
}