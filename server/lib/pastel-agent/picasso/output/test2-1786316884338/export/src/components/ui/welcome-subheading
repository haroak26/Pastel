// WelcomeSubheading.tsx — Playful supporting copy that explains Wavelength’s money-tracking purpose beneath a welcome heading.
import * as React from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const welcomeSubheadingVariants = cva(
  "max-w-[var(--space-24)] text-[var(--color-text-secondary)]"
);

export interface WelcomeSubheadingProps
  extends React.HTMLAttributes<HTMLParagraphElement> {
  text: string;
}

export default function WelcomeSubheading({
  className,
  text,
  style,
  ...props
}: WelcomeSubheadingProps) {
  return (
    <p
      className={cn(welcomeSubheadingVariants(), className)}
      style={{
        font: "var(--text-lg) var(--font-body)",
        fontWeight: "var(--weight-regular)",
        ...style,
      }}
      {...props}
    >
      {text}
    </p>
  );
}