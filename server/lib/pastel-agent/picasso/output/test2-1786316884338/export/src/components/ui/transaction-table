// TransactionTable.tsx — Recent spending table with quick editing and transaction navigation. Use on budgeting dashboards to review the latest activity.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const transactionTableVariants = cva(
  "w-full overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] shadow-[var(--shadow-sm)]",
  {}
);

export interface Transaction {
  id: string;
  date: Date;
  merchant: string;
  category: string;
  amount: number;
}

export interface TransactionTableProps
  extends React.HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof transactionTableVariants> {
  transactions: Transaction[];
  onTransactionClick?: (transactionId: string) => void;
  onEditTransaction?: (transactionId: string) => void;
  onViewAll?: () => void;
  isLoading?: boolean;
}

function formatDate(date: Date) {
  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
  }).format(date);
}

function formatAmount(amount: number) {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    signDisplay: "always",
  }).format(amount);
}

export default function TransactionTable({
  className,
  transactions,
  onTransactionClick,
  onEditTransaction,
  onViewAll,
  isLoading = false,
  ...props
}: TransactionTableProps) {
  const [openMenuId, setOpenMenuId] = React.useState<string | null>(null);
  const visibleTransactions = transactions.slice(0, 6);

  const handleTransactionKeyDown = (
    event: React.KeyboardEvent<HTMLTableRowElement>,
    transactionId: string
  ) => {
    if (!onTransactionClick) return;

    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      onTransactionClick(transactionId);
    }
  };

  return (
    <div
      className={cn(transactionTableVariants(), className)}
      aria-busy={isLoading}
      {...props}
    >
      <div className="flex items-center justify-between border-b border-[var(--color-border-subtle)] px-[var(--space-4)] py-[var(--space-4)]">
        <div>
          <h2
            className="text-[var(--color-text-primary)]"
            style={{
              font: "var(--weight-semibold) var(--text-lg) var(--font-display)",
            }}
          >
            Recent transactions
          </h2>
          <p
            className="mt-[var(--space-1)] text-[var(--color-text-muted)]"
            style={{
              font: "var(--weight-regular) var(--text-sm) var(--font-body)",
            }}
          >
            Your latest spending activity
          </p>
        </div>

        {onViewAll && (
          <button
            type="button"
            onClick={onViewAll}
            className="inline-flex h-[var(--control-sm)] items-center rounded-[var(--radius-sm)] px-[var(--space-2)] text-[var(--color-accent-600)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-accent-50)] active:bg-[var(--color-accent-100)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
            style={{
              font: "var(--weight-medium) var(--text-sm) var(--font-body)",
            }}
          >
            View all transactions
          </button>
        )}
      </div>

      <div className="overflow-x-auto">
        <table className="w-full border-collapse">
          <caption className="sr-only">
            Recent transactions with dates, merchants, categories, and amounts
          </caption>
          <thead>
            <tr className="border-b border-[var(--color-border-subtle)] bg-[var(--color-neutral-50)] text-left">
              <th
                scope="col"
                className="px-[var(--space-4)] py-[var(--space-3)] text-[var(--color-text-muted)]"
                style={{
                  font: "var(--weight-medium) var(--text-xs) var(--font-body)",
                }}
              >
                Date
              </th>
              <th
                scope="col"
                className="px-[var(--space-4)] py-[var(--space-3)] text-[var(--color-text-muted)]"
                style={{
                  font: "var(--weight-medium) var(--text-xs) var(--font-body)",
                }}
              >
                Merchant
              </th>
              <th
                scope="col"
                className="px-[var(--space-4)] py-[var(--space-3)] text-[var(--color-text-muted)]"
                style={{
                  font: "var(--weight-medium) var(--text-xs) var(--font-body)",
                }}
              >
                Category
              </th>
              <th
                scope="col"
                className="px-[var(--space-4)] py-[var(--space-3)] text-right text-[var(--color-text-muted)]"
                style={{
                  font: "var(--weight-medium) var(--text-xs) var(--font-body)",
                }}
              >
                Amount
              </th>
              <th scope="col" className="w-[var(--control-lg)]">
                <span className="sr-only">Actions</span>
              </th>
            </tr>
          </thead>

          <tbody>
            {isLoading ? (
              <tr>
                <td colSpan={5} className="px-[var(--space-4)] py-[var(--space-8)]">
                  <div
                    className="flex items-center justify-center gap-[var(--space-2)] text-[var(--color-text-muted)]"
                    style={{
                      font: "var(--weight-regular) var(--text-sm) var(--font-body)",
                    }}
                  >
                    <svg
                      className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <circle
                        className="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        strokeWidth="4"
                      />
                      <path
                        className="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                      />
                    </svg>
                    Loading transactions
                  </div>
                </td>
              </tr>
            ) : visibleTransactions.length === 0 ? (
              <tr>
                <td
                  colSpan={5}
                  className="px-[var(--space-4)] py-[var(--space-8)] text-center text-[var(--color-text-muted)]"
                  style={{
                    font: "var(--weight-regular) var(--text-sm) var(--font-body)",
                  }}
                >
                  No recent transactions recorded.
                </td>
              </tr>
            ) : (
              visibleTransactions.map((transaction) => {
                const isMenuOpen = openMenuId === transaction.id;
                const isClickable = Boolean(onTransactionClick);

                return (
                  <tr
                    key={transaction.id}
                    tabIndex={isClickable ? 0 : undefined}
                    role={isClickable ? "button" : undefined}
                    onClick={() => onTransactionClick?.(transaction.id)}
                    onKeyDown={(event) =>
                      handleTransactionKeyDown(event, transaction.id)
                    }
                    className={cn(
                      "border-b border-[var(--color-border-subtle)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] last:border-b-0",
                      isClickable &&
                        "cursor-pointer hover:bg-[var(--color-neutral-50)] active:bg-[var(--color-neutral-100)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-inset"
                    )}
                  >
                    <td
                      className="whitespace-nowrap px-[var(--space-4)] py-[var(--space-4)] text-[var(--color-text-muted)]"
                      style={{
                        font: "var(--weight-regular) var(--text-sm) var(--font-body)",
                      }}
                    >
                      {formatDate(transaction.date)}
                    </td>
                    <td
                      className="px-[var(--space-4)] py-[var(--space-4)] text-[var(--color-text-primary)]"
                      style={{
                        font: "var(--weight-medium) var(--text-base) var(--font-body)",
                      }}
                    >
                      {transaction.merchant}
                    </td>
                    <td className="px-[var(--space-4)] py-[var(--space-4)]">
                      <span
                        className="inline-flex rounded-[var(--radius-full)] bg-[var(--color-neutral-100)] px-[var(--space-2)] py-[var(--space-1)] text-[var(--color-text-secondary)]"
                        style={{
                          font: "var(--weight-medium) var(--text-xs) var(--font-body)",
                        }}
                      >
                        {transaction.category}
                      </span>
                    </td>
                    <td
                      className={cn(
                        "whitespace-nowrap px-[var(--space-4)] py-[var(--space-4)] text-right tabular-nums",
                        transaction.amount < 0
                          ? "text-[var(--color-text-primary)]"
                          : "text-[var(--color-success-500)]"
                      )}
                      style={{
                        font: "var(--weight-semibold) var(--text-base) var(--font-mono)",
                      }}
                    >
                      {formatAmount(transaction.amount)}
                    </td>
                    <td className="relative px-[var(--space-2)] py-[var(--space-2)]">
                      <button
                        type="button"
                        aria-label={`Edit ${transaction.merchant} transaction`}
                        aria-expanded={isMenuOpen}
                        aria-haspopup="menu"
                        disabled={!onEditTransaction}
                        onClick={(event) => {
                          event.stopPropagation();
                          setOpenMenuId(isMenuOpen ? null : transaction.id);
                        }}
                        className="inline-flex h-[var(--control-sm)] w-[var(--control-sm)] items-center justify-center rounded-[var(--radius-sm)] text-[var(--color-text-muted)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
                      >
                        <svg
                          className="h-[var(--space-4)] w-[var(--space-4)]"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          strokeWidth="2"
                          aria-hidden="true"
                        >
                          <circle cx="5" cy="12" r="1" />
                          <circle cx="12" cy="12" r="1" />
                          <circle cx="19" cy="12" r="1" />
                        </svg>
                      </button>

                      {isMenuOpen && onEditTransaction && (
                        <div
                          role="menu"
                          className="absolute right-[var(--space-0)] top-[var(--control-sm)] z-10 rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] p-[var(--space-1)] shadow-[var(--shadow-md)]"
                        >
                          <button
                            type="button"
                            role="menuitem"
                            onClick={(event) => {
                              event.stopPropagation();
                              onEditTransaction(transaction.id);
                              setOpenMenuId(null);
                            }}
                            className="h-[var(--control-sm)] whitespace-nowrap rounded-[var(--radius-sm)] px-[var(--space-3)] text-left text-[var(--color-text-primary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
                            style={{
                              font: "var(--weight-medium) var(--text-sm) var(--font-body)",
                            }}
                          >
                            Edit transaction
                          </button>
                        </div>
                      )}
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  );
}