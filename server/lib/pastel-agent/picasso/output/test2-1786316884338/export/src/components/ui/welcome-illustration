        stroke="var(--color-success-900)"
        strokeWidth="2"
        strokeLinecap="round"
      />
      <path
        d="M10 10.5h7M31 37.5h7"
        stroke="var(--color-accent-500)"
        strokeWidth="2"
        strokeLinecap="round"
      />
