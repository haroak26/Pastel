// GoalsPreview.tsx — Compact active savings-goal progress list for the dashboard; use when users need a quick view of momentum and deadlines.
import type { HTMLAttributes } from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const goalsPreviewVariants = cva(
  "w-full overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] shadow-[var(--shadow-sm)]"
);

export interface GoalsPreviewProps
  extends Omit<HTMLAttributes<HTMLElement>, "children"> {
  goals: Array<{
    id: string;
    name: string;
    target: number;
    saved: number;
    deadline: Date;
  }>;
  onViewAll?: () => void;
  onGoalClick?: (goalId: string) => void;
  isLoading?: boolean;
}

function formatCurrency(value: number) {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(value);
}

function getDaysRemaining(deadline: Date) {
  const millisecondsPerDay = 1000 * 60 * 60 * 24;
  const days = Math.ceil(
    (deadline.getTime() - new Date().getTime()) / millisecondsPerDay
  );

  if (days <= 0) return "Due today";
  if (days === 1) return "1 day left";
  return `${days} days left`;
}

export default function GoalsPreview({
  className,
  goals,
  onViewAll,
  onGoalClick,
  isLoading = false,
  ...props
}: GoalsPreviewProps) {
  return (
    <section
      className={cn(goalsPreviewVariants(), className)}
      aria-busy={isLoading}
      {...props}
    >
      <div className="flex items-center justify-between gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] px-[var(--space-4)] py-[var(--space-4)]">
        <div className="min-w-0">
          <h2 className="font-[var(--font-display)] text-base font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
            Active goals
          </h2>
          <p className="mt-[var(--space-1)] font-[var(--font-body)] text-sm text-[var(--color-text-muted)]">
            Keep your next milestone in sight
          </p>
        </div>

        {onViewAll && (
          <button
            type="button"
            onClick={onViewAll}
            disabled={isLoading}
            className="inline-flex h-[var(--control-sm)] shrink-0 items-center rounded-[var(--radius-md)] px-[var(--space-2)] font-[var(--font-body)] text-sm font-[var(--weight-medium)] text-[var(--color-accent-500)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-accent-50)] hover:text-[var(--color-accent-600)] active:bg-[var(--color-neutral-100)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
          >
            View all goals
          </button>
        )}
      </div>

      {isLoading ? (
        <div
          className="flex items-center gap-[var(--space-3)] px-[var(--space-4)] py-[var(--space-6)] font-[var(--font-body)] text-base text-[var(--color-text-secondary)]"
          role="status"
          aria-live="polite"
        >
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
            style={{ animationDuration: "var(--duration-slow)" }}
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
          Loading goals
        </div>
      ) : goals.length === 0 ? (
        <div className="px-[var(--space-4)] py-[var(--space-6)]">
          <p className="font-[var(--font-body)] text-base font-[var(--weight-medium)] text-[var(--color-text-primary)]">
            No active savings goals
          </p>
          <p className="mt-[var(--space-1)] font-[var(--font-body)] text-sm text-[var(--color-text-muted)]">
            Add a goal to give your next saving streak a target.
          </p>
        </div>
      ) : (
        <div className="divide-y divide-[var(--color-border-subtle)]">
          {goals.map((goal) => {
            const percentage = Math.min(
              100,
              Math.max(0, (goal.saved / goal.target) * 100)
            );
            const goalContent = (
              <>
                <div className="flex items-start justify-between gap-[var(--space-4)]">
                  <span className="min-w-0 truncate font-[var(--font-body)] text-base font-[var(--weight-medium)] text-[var(--color-text-primary)]">
                    {goal.name}
                  </span>
                  <span className="shrink-0 font-[var(--font-mono)] text-sm tabular-nums text-[var(--color-text-secondary)]">
                    {Math.round(percentage)}%
                  </span>
                </div>

                <div
                  className="mt-[var(--space-3)] h-[var(--space-2)] overflow-hidden rounded-[var(--radius-full)] bg-[var(--color-neutral-100)]"
                  role="progressbar"
                  aria-label={`${goal.name} savings progress`}
                  aria-valuemin={0}
                  aria-valuemax={100}
                  aria-valuenow={Math.round(percentage)}
                >
                  <div
                    className="h-full rounded-[var(--radius-full)] bg-[var(--color-accent-500)] transition-[width] duration-[var(--duration-base)] ease-[var(--easing-standard)]"
                    style={{ width: `${percentage}%` }}
                  />
                </div>

                <div className="mt-[var(--space-2)] flex items-center justify-between gap-[var(--space-3)] font-[var(--font-body)] text-sm text-[var(--color-text-muted)]">
                  <span className="tabular-nums">
                    {formatCurrency(goal.saved)} of {formatCurrency(goal.target)}
                  </span>
                  <span className="shrink-0">{getDaysRemaining(goal.deadline)}</span>
                </div>
              </>
            );

            return onGoalClick ? (
              <button
                key={goal.id}
                type="button"
                onClick={() => onGoalClick(goal.id)}
                className="block w-full px-[var(--space-4)] py-[var(--space-4)] text-left transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-50)] active:bg-[var(--color-neutral-100)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--color-border-focus)] disabled:pointer-events-none disabled:opacity-50"
              >
                {goalContent}
              </button>
            ) : (
              <div key={goal.id} className="px-[var(--space-4)] py-[var(--space-4)]">
                {goalContent}
              </div>
            );
          })}
        </div>
      )}
    </section>
  );
}