// Pagination.tsx — Page navigation for browsing Wavelength spending and savings records without losing count context.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const paginationControlVariants = cva(
  "inline-flex items-center justify-center gap-[var(--space-2)] rounded-[var(--radius-md)] font-[var(--font-body)] font-[var(--weight-medium)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      tone: {
        default:
          "border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] text-[var(--color-text-secondary)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)]",
        current:
          "border border-[var(--color-accent-500)] bg-[var(--color-accent-50)] text-[var(--color-accent-900)] active:bg-[var(--color-accent-100)]",
      },
      size: {
        sm: "h-[var(--control-sm)] px-[var(--space-3)] text-sm",
        md: "h-[var(--control-md)] px-[var(--space-4)] text-base",
      },
    },
    defaultVariants: {
      tone: "default",
      size: "md",
    },
  }
);

type PaginationControlProps = VariantProps<typeof paginationControlVariants>;

export interface PaginationProps {
  currentPage: number;
  totalPages: number;
  totalCount: number;
  onPageChange: (page: number) => void;
  className?: string;
  loading?: boolean;
}

export default function Pagination({
  currentPage,
  totalPages,
  totalCount,
  onPageChange,
  className,
  loading = false,
}: PaginationProps) {
  const isFirstPage = currentPage <= 1;
  const isLastPage = currentPage >= totalPages;

  const handlePrevious = () => {
    if (!isFirstPage && !loading) {
      onPageChange(currentPage - 1);
    }
  };

  const handleNext = () => {
    if (!isLastPage && !loading) {
      onPageChange(currentPage + 1);
    }
  };

  return (
    <nav
      aria-label="Budget records pagination"
      aria-busy={loading}
      className={cn(
        "flex items-center justify-between gap-[var(--space-4)] rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] px-[var(--space-4)] py-[var(--space-3)] font-[var(--font-body)]",
        className
      )}
    >
      <div
        className="flex min-w-0 items-center gap-[var(--space-3)] text-sm text-[var(--color-text-secondary)]"
        aria-live="polite"
      >
        {loading && (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
            style={{ animationDuration: "var(--duration-slow)" }}
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}
        <span className="truncate">
          Page{" "}
          <span className="font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
            {currentPage}
          </span>{" "}
          of{" "}
          <span className="font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
            {totalPages}
          </span>
          <span className="mx-[var(--space-2)] text-[var(--color-text-muted)]">
            ·
          </span>
          {totalCount.toLocaleString()} items
        </span>
      </div>

      <div className="flex shrink-0 items-center gap-[var(--space-2)]">
        <button
          type="button"
          className={cn(
            paginationControlVariants({
              tone: "default",
              size: "sm",
            })
          )}
          onClick={handlePrevious}
          disabled={isFirstPage || loading}
          aria-label={`Go to page ${Math.max(1, currentPage - 1)}`}
        >
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="2"
            strokeLinecap="round"
            strokeLinejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
          <span className="hidden sm:inline">Previous</span>
        </button>

        <span
          aria-current="page"
          className={cn(
            paginationControlVariants({
              tone: "current",
              size: "sm",
            }),
            "min-w-[var(--control-sm)] px-[var(--space-2)] tabular-nums"
          )}
        >
          {currentPage}
        </span>

        <button
          type="button"
          className={cn(
            paginationControlVariants({
              tone: "default",
              size: "sm",
            })
          )}
          onClick={handleNext}
          disabled={isLastPage || loading}
          aria-label={`Go to page ${Math.min(totalPages, currentPage + 1)}`}
        >
          <span className="hidden sm:inline">Next</span>
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="2"
            strokeLinecap="round"
            strokeLinejoin="round"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>
      </div>
    </nav>
  );
}