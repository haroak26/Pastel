// AchievementBand.tsx — Section header for the completed goals summary and its total count.
import type { HTMLAttributes } from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const achievementBandVariants = cva(
  "flex items-center justify-between gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] py-[var(--space-4)] font-[var(--font-body)]"
);

export interface AchievementBandProps
  extends HTMLAttributes<HTMLElement> {
  completedCount: number;
}

export default function AchievementBand({
  completedCount,
  className,
  ...props
}: AchievementBandProps) {
  return (
    <section
      className={cn(achievementBandVariants(), className)}
      aria-labelledby="completed-goals-heading"
      {...props}
    >
      <h2
        id="completed-goals-heading"
        className="font-[var(--font-display)] text-[var(--text-xl)] font-[var(--weight-semibold)] leading-[var(--text-xl)] text-[var(--color-text-primary)]"
      >
        Completed Goals
      </h2>

      <span
        className="inline-flex items-center rounded-[var(--radius-md)] border border-[var(--color-accent-100)] bg-[var(--color-accent-50)] px-[var(--space-3)] py-[var(--space-2)] font-[var(--font-mono)] text-[var(--text-sm)] font-[var(--weight-semibold)] tabular-nums text-[var(--color-accent-900)]"
        aria-label={`${completedCount} completed goals`}
      >
        {completedCount}
      </span>
    </section>
  );
}