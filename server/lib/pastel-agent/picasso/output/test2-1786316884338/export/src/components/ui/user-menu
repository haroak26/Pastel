// UserMenu.tsx — Account identity trigger with account settings and logout actions. Use in authenticated app navigation.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import * as DropdownMenu from "@radix-ui/react-dropdown-menu";
import { cn } from "../lib/cn";

const userMenuTriggerVariants = cva(
  "inline-flex h-[var(--control-md)] items-center gap-[var(--space-2)] rounded-[var(--radius-md)] px-[var(--space-2)] font-[var(--weight-medium)] text-[var(--color-text-primary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=open]:bg-[var(--color-neutral-100)]",
  {
    variants: {},
  }
);

const menuItemVariants = cva(
  "flex h-[var(--control-sm)] w-full items-center rounded-[var(--radius-sm)] px-[var(--space-3)] font-[var(--weight-medium)] text-[var(--color-text-secondary)] outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 data-[highlighted]:bg-[var(--color-neutral-100)] data-[disabled]:pointer-events-none data-[disabled]:opacity-50"
);

export interface UserMenuProps
  extends Omit<React.ComponentPropsWithoutRef<"button">, "children">,
    VariantProps<typeof userMenuTriggerVariants> {
  userName: string;
  avatarUrl?: string | null;
  onLogout: () => void;
  onAccountSettings?: () => void;
  loading?: boolean;
}

function getInitials(userName: string) {
  return userName
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part.charAt(0))
    .join("")
    .toUpperCase();
}

export default function UserMenu({
  className,
  userName,
  avatarUrl = null,
  onLogout,
  onAccountSettings,
  loading = false,
  disabled,
  ...props
}: UserMenuProps) {
  const initials = getInitials(userName);

  return (
    <DropdownMenu.Root>
      <DropdownMenu.Trigger asChild>
        <button
          className={cn(userMenuTriggerVariants(), className)}
          disabled={disabled || loading}
          aria-busy={loading}
          aria-label={userName}
          {...props}
        >
          {loading ? (
            <svg
              className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                className="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                strokeWidth="4"
              />
              <path
                className="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
              />
            </svg>
          ) : avatarUrl ? (
            <img
              className="h-[var(--control-sm)] w-[var(--control-sm)] rounded-[var(--radius-full)] object-cover"
              src={avatarUrl}
              alt=""
              aria-hidden="true"
            />
          ) : (
            <span
              className="inline-flex h-[var(--control-sm)] w-[var(--control-sm)] items-center justify-center rounded-[var(--radius-full)] bg-[var(--color-accent-100)] font-[var(--weight-semibold)] text-sm text-[var(--color-accent-900)]"
              aria-hidden="true"
            >
              {initials}
            </span>
          )}
          <span className="max-w-[var(--space-24)] truncate text-sm">
            {userName}
          </span>
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] text-[var(--color-text-muted)]"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="2"
            strokeLinecap="round"
            strokeLinejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>
      </DropdownMenu.Trigger>

      <DropdownMenu.Portal>
        <DropdownMenu.Content
          align="end"
          sideOffset={8}
          className="z-50 min-w-[var(--control-lg)] rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] p-[var(--space-2)] font-[var(--font-body)] shadow-[var(--shadow-md)] focus:outline-none"
        >
          <DropdownMenu.Label className="px-[var(--space-3)] py-[var(--space-2)] text-sm font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
            {userName}
          </DropdownMenu.Label>

          {onAccountSettings && (
            <DropdownMenu.Item
              className={cn(menuItemVariants())}
              disabled={loading}
              onSelect={onAccountSettings}
            >
              Account settings
            </DropdownMenu.Item>
          )}

          <DropdownMenu.Separator className="my-[var(--space-2)] h-px bg-[var(--color-border-subtle)]" />

          <DropdownMenu.Item
            className={cn(
              menuItemVariants(),
              "text-[var(--color-danger-500)] hover:bg-[var(--color-danger-50)] data-[highlighted]:bg-[var(--color-danger-50)]"
            )}
            disabled={loading}
            onSelect={onLogout}
          >
            Log out
          </DropdownMenu.Item>
        </DropdownMenu.Content>
      </DropdownMenu.Portal>
    </DropdownMenu.Root>
  );
}