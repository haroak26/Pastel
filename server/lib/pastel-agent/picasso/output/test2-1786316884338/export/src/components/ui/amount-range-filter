// AmountRangeFilter.tsx — Filters Wavelength transactions by a minimum and maximum amount.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const amountRangeFilterVariants = cva(
  "rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-4)] font-[var(--font-body)]",
  {}
);

const amountInputVariants = cva(
  "h-[var(--control-md)] w-full rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-background)] px-[var(--space-3)] font-[var(--font-body)] font-[var(--weight-medium)] tabular-nums text-[var(--color-text-primary)] outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] placeholder:text-[var(--color-text-muted)] hover:border-[var(--color-neutral-500)] focus-visible:border-[var(--color-border-focus)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:border-[var(--color-accent-600)] disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      error: {
        true: "border-[var(--color-danger-500)] hover:border-[var(--color-danger-500)] focus-visible:border-[var(--color-danger-500)] focus-visible:ring-[var(--color-danger-500)]",
        false: "",
      },
    },
    defaultVariants: {
      error: false,
    },
  }
);

export interface AmountRangeFilterProps
  extends VariantProps<typeof amountRangeFilterVariants> {
  minAmount?: number | null;
  maxAmount?: number | null;
  onAmountChange: (min: number | null, max: number | null) => void;
  disabled?: boolean;
  loading?: boolean;
  className?: string;
  id?: string;
}

export default function AmountRangeFilter({
  minAmount = null,
  maxAmount = null,
  onAmountChange,
  disabled = false,
  loading = false,
  className,
  id,
}: AmountRangeFilterProps) {
  const generatedId = React.useId();
  const baseId = id ?? `amount-range-${generatedId}`;
  const minInputId = `${baseId}-min`;
  const maxInputId = `${baseId}-max`;
  const errorId = `${baseId}-error`;
  const hasRangeError =
    minAmount !== null &&
    minAmount !== undefined &&
    maxAmount !== null &&
    maxAmount !== undefined &&
    minAmount > maxAmount;
  const isDisabled = disabled || loading;

  const handleMinChange = (event: React.ChangeEvent<HTMLInputElement>) => {
    const value = event.target.value;
    onAmountChange(value === "" ? null : Number(value), maxAmount);
  };

  const handleMaxChange = (event: React.ChangeEvent<HTMLInputElement>) => {
    const value = event.target.value;
    onAmountChange(minAmount, value === "" ? null : Number(value));
  };

  return (
    <fieldset
      className={cn(amountRangeFilterVariants(), className)}
      disabled={isDisabled}
      aria-busy={loading}
    >
      <legend
        className="mb-[var(--space-3)] text-[var(--color-text-primary)]"
        style={{
          font: "var(--text-base)",
          fontFamily: "var(--font-display)",
          fontWeight: "var(--weight-semibold)",
        }}
      >
        Transaction amount
      </legend>

      <div className="grid grid-cols-1 gap-[var(--space-3)] sm:grid-cols-2">
        <label
          htmlFor={minInputId}
          className="flex flex-col gap-[var(--space-2)] text-[var(--color-text-secondary)]"
          style={{ font: "var(--text-sm)", fontWeight: "var(--weight-medium)" }}
        >
          Minimum amount
          <input
            id={minInputId}
            name="minAmount"
            type="number"
            inputMode="decimal"
            min={0}
            step="0.01"
            value={minAmount ?? ""}
            onChange={handleMinChange}
            className={cn(
              amountInputVariants({ error: hasRangeError }),
              "pr-[var(--space-3)]"
            )}
            aria-invalid={hasRangeError}
            aria-describedby={hasRangeError ? errorId : undefined}
          />
        </label>

        <label
          htmlFor={maxInputId}
          className="flex flex-col gap-[var(--space-2)] text-[var(--color-text-secondary)]"
          style={{ font: "var(--text-sm)", fontWeight: "var(--weight-medium)" }}
        >
          Maximum amount
          <input
            id={maxInputId}
            name="maxAmount"
            type="number"
            inputMode="decimal"
            min={0}
            step="0.01"
            value={maxAmount ?? ""}
            onChange={handleMaxChange}
            className={cn(
              amountInputVariants({ error: hasRangeError }),
              "pr-[var(--space-3)]"
            )}
            aria-invalid={hasRangeError}
            aria-describedby={hasRangeError ? errorId : undefined}
          />
        </label>
      </div>

      {loading && (
        <div
          className="mt-[var(--space-3)] flex items-center gap-[var(--space-2)] text-[var(--color-text-muted)]"
          style={{ font: "var(--text-sm)" }}
          role="status"
        >
          <svg
            className="size-[var(--space-4)] animate-spin duration-[var(--duration-slow)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
          Updating transactions
        </div>
      )}

      {hasRangeError && !loading && (
        <p
          id={errorId}
          className="mt-[var(--space-3)] text-[var(--color-danger-500)]"
          style={{ font: "var(--text-sm)" }}
          role="alert"
        >
          Minimum amount must be no greater than maximum amount.
        </p>
      )}
    </fieldset>
  );
}