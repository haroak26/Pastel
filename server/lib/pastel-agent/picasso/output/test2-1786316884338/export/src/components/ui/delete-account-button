// DeleteAccountButton.tsx — Destructive red button to delete account with confirmation modal. Use in account settings to trigger irreversible account deletion.
import { useState } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const deleteAccountButtonVariants = cva(
  "inline-flex items-center justify-center gap-2 rounded-[var(--radius-md)] font-[var(--weight-medium)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      size: {
        md: "h-[var(--control-md)] px-4 text-base",
        lg: "h-[var(--control-lg)] px-6 text-lg",
      },
    },
    defaultVariants: {
      size: "md",
    },
  }
);

export interface DeleteAccountButtonProps
  extends React.ButtonHTMLAttributes<HTMLButtonElement>,
    VariantProps<typeof deleteAccountButtonVariants> {
  onClick: () => void;
  onConfirm: () => void;
  loading?: boolean;
}

export default function DeleteAccountButton({
  className,
  size,
  onClick,
  onConfirm,
  loading = false,
  disabled,
  ...props
}: DeleteAccountButtonProps) {
  const [showModal, setShowModal] = useState(false);
  const [confirmLoading, setConfirmLoading] = useState(false);

  const handleClick = () => {
    onClick();
    setShowModal(true);
  };

  const handleConfirm = async () => {
    setConfirmLoading(true);
    try {
      onConfirm();
    } finally {
      setConfirmLoading(false);
      setShowModal(false);
    }
  };

  return (
    <>
      <button
        className={cn(
          deleteAccountButtonVariants({ size }),
          "bg-[var(--color-danger-500)] text-[var(--color-text-inverse)] hover:bg-[var(--color-danger-600)] active:bg-[var(--color-danger-700)]",
          className
        )}
        disabled={disabled || loading}
        aria-busy={loading}
        onClick={handleClick}
        {...props}
      >
        {loading && (
          <svg
            className="animate-spin h-4 w-4"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}
        Delete Account
      </button>

      {showModal && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
          <div className="bg-[var(--color-surface-raised)] rounded-[var(--radius-lg)] shadow-[var(--shadow-xl)] p-6 max-w-sm w-full mx-4">
            <h2 className="text-xl font-[var(--weight-bold)] text-[var(--color-text-primary)] mb-2">
              Delete your account?
            </h2>
            <p className="text-sm text-[var(--color-text-secondary)] mb-6">
              This action cannot be undone. All your data, goals, and transaction history will be permanently deleted.
            </p>
            <div className="flex gap-3 justify-end">
              <button
                className="h-[var(--control-md)] px-4 text-base font-[var(--weight-medium)] rounded-[var(--radius-md)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 bg-[var(--color-neutral-100)] text-[var(--color-text-primary)] hover:bg-[var(--color-neutral-200)] active:bg-[var(--color-neutral-300)]"
                onClick={() => setShowModal(false)}
                disabled={confirmLoading}
              >
                Cancel
              </button>
              <button
                className="h-[var(--control-md)] px-4 text-base font-[var(--weight-medium)] rounded-[var(--radius-md)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-[var(--color-danger-500)] text-[var(--color-text-inverse)] hover:bg-[var(--color-danger-600)] active:bg-[var(--color-danger-700)] inline-flex items-center justify-center gap-2"
                onClick={handleConfirm}
                disabled={confirmLoading}
                aria-busy={confirmLoading}
              >
                {confirmLoading && (
                  <svg
                    className="animate-spin h-4 w-4"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <circle
                      className="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      strokeWidth="4"
                    />
                    <path
                      className="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                    />
                  </svg>
                )}
                Delete
              </button>
            </div>
          </div>
        </div>
      )}
    </>
  );
}