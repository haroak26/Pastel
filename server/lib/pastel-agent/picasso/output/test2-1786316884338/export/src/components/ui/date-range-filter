// DateRangeFilter.tsx — Filters Wavelength transactions by a selectable start and end date range.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const dateRangeFilterVariants = cva(
  "flex flex-col gap-[var(--space-3)] rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-4)] font-[var(--font-body)]",
  {
    variants: {},
  }
);

export interface DateRangeFilterProps
  extends React.HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof dateRangeFilterVariants> {
  startDate?: Date | null;
  endDate?: Date | null;
  onDateChange: (
    startDate: Date | null,
    endDate: Date | null
  ) => void;
  minDate?: Date;
  maxDate?: Date;
  loading?: boolean;
  disabled?: boolean;
  startLabel?: string;
  endLabel?: string;
}

function formatDateValue(date?: Date | null) {
  if (!date) return "";

  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");

  return `${year}-${month}-${day}`;
}

function parseDateValue(value: string) {
  if (!value) return null;

  const [year, month, day] = value.split("-").map(Number);
  return new Date(year, month - 1, day);
}

export default function DateRangeFilter({
  className,
  startDate = null,
  endDate = null,
  onDateChange,
  minDate,
  maxDate,
  loading = false,
  disabled = false,
  startLabel = "Transactions from",
  endLabel = "Transactions through",
  id,
  ...props
}: DateRangeFilterProps) {
  const generatedId = React.useId();
  const baseId = id ?? `transaction-date-range-${generatedId}`;
  const startId = `${baseId}-start`;
  const endId = `${baseId}-end`;
  const isDisabled = disabled || loading;

  const handleStartChange = (
    event: React.ChangeEvent<HTMLInputElement>
  ) => {
    const nextStartDate = parseDateValue(event.target.value);
    const nextEndDate =
      nextStartDate && endDate && nextStartDate > endDate
        ? null
        : endDate;

    onDateChange(nextStartDate, nextEndDate);
  };

  const handleEndChange = (
    event: React.ChangeEvent<HTMLInputElement>
  ) => {
    onDateChange(startDate, parseDateValue(event.target.value));
  };

  const inputClasses = cn(
    "h-[var(--control-md)] w-full rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] px-[var(--space-3)] font-[var(--font-body)] text-[length:var(--text-base)] text-[var(--color-text-primary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-neutral-500)] focus-visible:border-[var(--color-border-focus)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:border-[var(--color-accent-600)] disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50"
  );

  return (
    <div
      className={cn(dateRangeFilterVariants(), className)}
      aria-busy={loading}
      {...props}
    >
      <div className="flex items-center justify-between gap-[var(--space-3)]">
        <span className="font-[var(--font-display)] text-[length:var(--text-sm)] font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
          Transaction window
        </span>

        {loading && (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}
      </div>

      <div className="grid grid-cols-1 gap-[var(--space-3)] sm:grid-cols-2">
        <div className="flex flex-col gap-[var(--space-1)]">
          <label
            htmlFor={startId}
            className="font-[var(--font-body)] text-[length:var(--text-sm)] font-[var(--weight-medium)] text-[var(--color-text-secondary)]"
          >
            {startLabel}
          </label>
          <input
            id={startId}
            className={inputClasses}
            type="date"
            value={formatDateValue(startDate)}
            min={formatDateValue(minDate)}
            max={formatDateValue(endDate ?? maxDate)}
            onChange={handleStartChange}
            disabled={isDisabled}
            aria-label={startLabel}
          />
        </div>

        <div className="flex flex-col gap-[var(--space-1)]">
          <label
            htmlFor={endId}
            className="font-[var(--font-body)] text-[length:var(--text-sm)] font-[var(--weight-medium)] text-[var(--color-text-secondary)]"
          >
            {endLabel}
          </label>
          <input
            id={endId}
            className={inputClasses}
            type="date"
            value={formatDateValue(endDate)}
            min={formatDateValue(startDate ?? minDate)}
            max={formatDateValue(maxDate)}
            onChange={handleEndChange}
            disabled={isDisabled}
            aria-label={endLabel}
          />
        </div>
      </div>
    </div>
  );
}