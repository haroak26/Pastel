// WelcomeHeading.tsx — Large teal welcome heading for introducing the Wavelength budgeting workspace.
import type { HTMLAttributes } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const welcomeHeadingVariants = cva(
  "font-[var(--font-display)] text-[var(--text-4xl)] font-[var(--weight-bold)] leading-[var(--text-4xl)] text-[var(--color-accent-500)]",
  {
    variants: {},
  }
);

export interface WelcomeHeadingProps
  extends Omit<HTMLAttributes<HTMLHeadingElement>, "children">,
    VariantProps<typeof welcomeHeadingVariants> {
  text: string;
}

export default function WelcomeHeading({
  className,
  text,
  ...props
}: WelcomeHeadingProps) {
  return (
    <h1 className={cn(welcomeHeadingVariants(), className)} {...props}>
      {text}
    </h1>
  );
}