// StreakBand.tsx — Displays Wavelength’s current budget streak, reset risk, and next reward milestone.
import type { HTMLAttributes } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const streakBandVariants = cva(
  "flex items-stretch gap-[var(--space-4)] rounded-[var(--radius-lg)] border p-[var(--space-4)] font-[var(--font-body)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
  {
    variants: {
      status: {
        active:
          "border-[var(--color-accent-200)] bg-[var(--color-accent-50)] text-[var(--color-accent-900)]",
        "at-risk":
          "border-[var(--color-warning-500)] bg-[var(--color-warning-50)] text-[var(--color-warning-900)]",
        broken:
          "border-[var(--color-danger-500)] bg-[var(--color-danger-50)] text-[var(--color-danger-900)]",
      },
    },
    defaultVariants: {
      status: "active",
    },
  }
);

export interface StreakBandProps
  extends HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof streakBandVariants> {
  streakCount: number;
  daysRemaining: number;
  nextRewardUnlock: string;
  isAtRisk?: boolean;
  loading?: boolean;
}

export default function StreakBand({
  className,
  status,
  streakCount,
  daysRemaining,
  nextRewardUnlock,
  isAtRisk = false,
  loading = false,
  ...props
}: StreakBandProps) {
  const resolvedStatus = isAtRisk && status !== "broken" ? "at-risk" : status;

  return (
    <div
      className={cn(
        streakBandVariants({ status: resolvedStatus }),
        loading && "opacity-50",
        className
      )}
      aria-busy={loading}
      {...props}
    >
      <div className="flex min-w-[var(--space-12)] flex-col justify-center">
        <div className="flex items-center gap-[var(--space-2)]">
          <svg
            className="h-[var(--space-6)] w-[var(--space-6)] shrink-0"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M13.4 2.2c.3 2.5-.7 4.1-2.1 5.4-.9.8-1.8 1.6-2.1 3.2-.3-.8-.8-1.5-1.5-2.1C6.3 10.2 5 12.3 5 14.8 5 18.8 8.1 22 12 22s7-3.2 7-7.2c0-4.2-2.4-7.8-5.6-12.6ZM12 19.8c-1.8 0-3.2-1.4-3.2-3.2 0-1.2.5-2.2 1.4-3.2.2 1.1.9 1.8 1.8 2.2.7-.7 1.1-1.5 1-2.7 1.2 1.5 2.2 2.8 2.2 4.1 0 1.5-1.4 2.8-3.2 2.8Z" />
          </svg>
          <span
            className="tabular-nums"
            style={{
              font: "var(--text-3xl)",
              fontFamily: "var(--font-display)",
              fontWeight: "var(--weight-bold)",
            }}
          >
            {streakCount}
          </span>
        </div>
        <span
          className="text-[var(--color-text-secondary)]"
          style={{
            font: "var(--text-xs)",
            fontFamily: "var(--font-body)",
            fontWeight: "var(--weight-medium)",
          }}
        >
          day streak
        </span>
      </div>

      <div className="flex min-w-0 flex-1 flex-col justify-center gap-[var(--space-2)] border-l border-[var(--color-border-default)] pl-[var(--space-4)]">
        <div className="flex items-baseline justify-between gap-[var(--space-3)]">
          <span
            className="text-[var(--color-text-primary)]"
            style={{
              font: "var(--text-base)",
              fontFamily: "var(--font-body)",
              fontWeight: "var(--weight-semibold)",
            }}
          >
            Keep the streak alive
          </span>
          <span
            className="shrink-0 tabular-nums text-[var(--color-text-secondary)]"
            style={{
              font: "var(--text-sm)",
              fontFamily: "var(--font-mono)",
              fontWeight: "var(--weight-medium)",
            }}
          >
            {daysRemaining} days left
          </span>
        </div>

        <div className="flex items-center gap-[var(--space-2)]">
          {loading && (
            <svg
              className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                className="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                strokeWidth="4"
              />
              <path
                className="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
              />
            </svg>
          )}
          <span
            className="truncate text-[var(--color-text-secondary)]"
            style={{
              font: "var(--text-sm)",
              fontFamily: "var(--font-body)",
              fontWeight: "var(--weight-regular)",
            }}
          >
            Next reward: {nextRewardUnlock}
          </span>
        </div>
      </div>
    </div>
  );
}