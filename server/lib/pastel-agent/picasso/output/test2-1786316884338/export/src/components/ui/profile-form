// ProfileForm.tsx — Editable Wavelength profile form for identity details, avatar updates, and saving account changes.
import { useRef, useState, type FormEvent } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";
import Button from "./Button";

const profileFormVariants = cva(
  "w-full rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] p-[var(--space-6)] shadow-[var(--shadow-sm)]",
  {
    variants: {},
  }
);

export interface ProfileFormProps extends VariantProps<typeof profileFormVariants> {
  name: string;
  email: string;
  avatarUrl?: string | null;
  onNameChange: (name: string) => void;
  onEmailChange: (email: string) => void;
  onAvatarUpload?: (file: File) => void;
  onSave: () => void;
  isLoading?: boolean;
  className?: string;
}

export default function ProfileForm({
  name,
  email,
  avatarUrl = null,
  onNameChange,
  onEmailChange,
  onAvatarUpload,
  onSave,
  isLoading = false,
  className,
}: ProfileFormProps) {
  const fileInputRef = useRef<HTMLInputElement>(null);
  const [nameError, setNameError] = useState(false);
  const [emailError, setEmailError] = useState(false);

  const initials = name
    .trim()
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((part) => part[0]?.toUpperCase())
    .join("");

  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();

    const nextNameError = !name.trim();
    const nextEmailError = !email.trim() || !email.includes("@");

    setNameError(nextNameError);
    setEmailError(nextEmailError);

    if (!nextNameError && !nextEmailError) {
      onSave();
    }
  };

  return (
    <form
      className={cn(profileFormVariants(), className)}
      onSubmit={handleSubmit}
      aria-busy={isLoading}
      noValidate
    >
      <div className="flex flex-col gap-[var(--space-6)]">
        <div className="flex flex-col gap-[var(--space-2)]">
          <h2
            className="[font-family:var(--font-display)] [font-size:var(--text-xl)] [line-height:var(--text-xl)] [font-weight:var(--weight-semibold)] text-[var(--color-text-primary)]"
          >
            Wavelength profile
          </h2>
          <p
            className="[font-family:var(--font-body)] [font-size:var(--text-base)] [line-height:var(--text-base)] [font-weight:var(--weight-regular)] text-[var(--color-text-secondary)]"
          >
            Keep your account details ready for your next savings streak.
          </p>
        </div>

        <div className="flex items-center gap-[var(--space-4)] rounded-[var(--radius-md)] bg-[var(--color-neutral-50)] p-[var(--space-4)]">
          <div
            className="flex size-[var(--control-lg)] shrink-0 items-center justify-center overflow-hidden rounded-[var(--radius-full)] bg-[var(--color-accent-100)] [font-family:var(--font-display)] [font-size:var(--text-lg)] [line-height:var(--text-lg)] [font-weight:var(--weight-semibold)] text-[var(--color-accent-900)]"
            aria-label={avatarUrl ? `${name} profile photo` : `${name} initials`}
          >
            {avatarUrl ? (
              <img
                src={avatarUrl}
                alt={`${name} profile`}
                className="size-full object-cover"
              />
            ) : (
              initials
            )}
          </div>

          <div className="flex min-w-0 flex-1 flex-col gap-[var(--space-1)]">
            <span
              className="[font-family:var(--font-body)] [font-size:var(--text-sm)] [line-height:var(--text-sm)] [font-weight:var(--weight-medium)] text-[var(--color-text-primary)]"
            >
              Profile photo
            </span>
            <span
              className="[font-family:var(--font-body)] [font-size:var(--text-sm)] [line-height:var(--text-sm)] [font-weight:var(--weight-regular)] text-[var(--color-text-muted)]"
            >
              Show up alongside your budget wins.
            </span>
          </div>

          {onAvatarUpload && (
            <>
              <input
                ref={fileInputRef}
                id="profile-avatar"
                name="avatar"
                type="file"
                accept="image/*"
                className="sr-only"
                disabled={isLoading}
                onChange={(event) => {
                  const file = event.target.files?.[0];
                  if (file) {
                    onAvatarUpload(file);
                  }
                }}
              />
              <button
                type="button"
                className="inline-flex h-[var(--control-sm)] shrink-0 items-center justify-center rounded-[var(--radius-md)] border border-[var(--color-border-default)] px-[var(--space-3)] [font-family:var(--font-body)] [font-size:var(--text-sm)] [line-height:var(--text-sm)] [font-weight:var(--weight-medium)] text-[var(--color-text-primary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
                onClick={() => fileInputRef.current?.click()}
                disabled={isLoading}
                aria-label="Upload a new profile photo"
              >
                Upload
              </button>
            </>
          )}
        </div>

        <div className="flex flex-col gap-[var(--space-4)]">
          <div className="flex flex-col gap-[var(--space-2)]">
            <label
              htmlFor="profile-name"
              className="[font-family:var(--font-body)] [font-size:var(--text-sm)] [line-height:var(--text-sm)] [font-weight:var(--weight-medium)] text-[var(--color-text-primary)]"
            >
              Full name
            </label>
            <input
              id="profile-name"
              name="name"
              type="text"
              value={name}
              autoComplete="name"
              required
              disabled={isLoading}
              aria-invalid={nameError}
              aria-describedby={nameError ? "profile-name-error" : undefined}
              onChange={(event) => {
                onNameChange(event.target.value);
                if (event.target.value.trim()) {
                  setNameError(false);
                }
              }}
              onBlur={() => setNameError(!name.trim())}
              className="h-[var(--control-lg)] rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] px-[var(--space-4)] text-[var(--color-text-primary)] outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] placeholder:text-[var(--color-text-muted)] hover:border-[var(--color-neutral-500)] focus-visible:border-[var(--color-border-focus)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
              style={{ font: "var(--text-base) var(--font-body)" }}
            />
            {nameError && (
              <p
                id="profile-name-error"
                role="alert"
                className="[font-family:var(--font-body)] [font-size:var(--text-sm)] [line-height:var(--text-sm)] [font-weight:var(--weight-regular)] text-[var(--color-danger-500)]"
              >
                Add your full name to continue.
              </p>
            )}
          </div>

          <div className="flex flex-col gap-[var(--space-2)]">
            <label
              htmlFor="profile-email"
              className="[font-family:var(--font-body)] [font-size:var(--text-sm)] [line-height:var(--text-sm)] [font-weight:var(--weight-medium)] text-[var(--color-text-primary)]"
            >
              Email address
            </label>
            <input
              id="profile-email"
              name="email"
              type="email"
              value={email}
              autoComplete="email"
              required
              disabled={isLoading}
              aria-invalid={emailError}
              aria-describedby={emailError ? "profile-email-error" : undefined}
              onChange={(event) => {
                onEmailChange(event.target.value);
                if (event.target.validity.valid) {
                  setEmailError(false);
                }
              }}
              onBlur={(event) => setEmailError(!event.currentTarget.validity.valid)}
              className="h-[var(--control-lg)] rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] px-[var(--space-4)] text-[var(--color-text-primary)] outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] placeholder:text-[var(--color-text-muted)] hover:border-[var(--color-neutral-500)] focus-visible:border-[var(--color-border-focus)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
              style={{ font: "var(--text-base) var(--font-body)" }}
            />
            {emailError && (
              <p
                id="profile-email-error"
                role="alert"
                className="[font-family:var(--font-body)] [font-size:var(--text-sm)] [line-height:var(--text-sm)] [font-weight:var(--weight-regular)] text-[var(--color-danger-500)]"
              >
                Enter a valid email address for account updates.
              </p>
            )}
          </div>
        </div>

        <div className="flex justify-start border-t border-[var(--color-border-subtle)] pt-[var(--space-6)]">
          <Button
            type="submit"
            variant="primary"
            size="md"
            loading={isLoading}
            disabled={isLoading}
          >
            Save changes
          </Button>
        </div>
      </div>
    </form>
  );
}