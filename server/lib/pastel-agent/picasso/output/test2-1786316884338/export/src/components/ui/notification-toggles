// NotificationToggles.tsx — Controls Wavelength notification preferences for budget progress, savings goals, streaks, and weekly money recaps.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import * as Switch from "@radix-ui/react-switch";
import { cn } from "../lib/cn";

const notificationSwitchVariants = cva(
  "relative inline-flex shrink-0 cursor-pointer items-center rounded-[var(--radius-full)] border border-[var(--color-border-default)] bg-[var(--color-neutral-200)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-300)] active:bg-[var(--color-neutral-400)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=checked]:border-[var(--color-accent-500)] data-[state=checked]:bg-[var(--color-accent-500)] data-[state=checked]:hover:bg-[var(--color-accent-600)] data-[state=checked]:active:bg-[var(--color-accent-600)]",
  {
    variants: {},
  }
);

export interface NotificationTogglesProps
  extends VariantProps<typeof notificationSwitchVariants> {
  budgetAlerts: boolean;
  goalMilestones: boolean;
  streakReminders: boolean;
  weeklySummaries: boolean;
  onToggle: (
    type:
      | "budgetAlerts"
      | "goalMilestones"
      | "streakReminders"
      | "weeklySummaries",
    enabled: boolean
  ) => void;
  loading?: boolean;
  className?: string;
}

export default function NotificationToggles({
  budgetAlerts,
  goalMilestones,
  streakReminders,
  weeklySummaries,
  onToggle,
  loading = false,
  className,
}: NotificationTogglesProps) {
  const idPrefix = React.useId();

  const settings = [
    {
      key: "budgetAlerts" as const,
      label: "Budget alerts",
      description: "Know when a spending category is close to its limit.",
      enabled: budgetAlerts,
    },
    {
      key: "goalMilestones" as const,
      label: "Goal milestones",
      description: "Celebrate each savings goal checkpoint as it lands.",
      enabled: goalMilestones,
    },
    {
      key: "streakReminders" as const,
      label: "Streak reminders",
      description: "Keep your budget streak alive with timely nudges.",
      enabled: streakReminders,
    },
    {
      key: "weeklySummaries" as const,
      label: "Weekly summaries",
      description: "Get a quick recap of where your money went this week.",
      enabled: weeklySummaries,
    },
  ];

  return (
    <section
      className={cn(
        "w-full max-w-2xl rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] p-[var(--space-6)]",
        className
      )}
      aria-busy={loading}
    >
      <div className="mb-[var(--space-4)] flex items-start justify-between gap-[var(--space-4)]">
        <div>
          <h2
            className="font-[var(--font-display)] text-[var(--text-xl)] font-[var(--weight-semibold)] text-[var(--color-text-primary)]"
            style={{ font: "var(--text-xl) var(--font-display)", fontWeight: "var(--weight-semibold)" }}
          >
            Notification settings
          </h2>
          <p
            className="mt-[var(--space-1)] font-[var(--font-body)] text-[var(--text-base)] text-[var(--color-text-secondary)]"
            style={{ font: "var(--text-base) var(--font-body)" }}
          >
            Choose which money moments should reach you.
          </p>
        </div>

        {loading && (
          <svg
            className="mt-[var(--space-1)] h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-label="Saving notification settings"
            role="status"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}
      </div>

      <div className="divide-y divide-[var(--color-border-subtle)]">
        {settings.map((setting) => {
          const switchId = `${idPrefix}-${setting.key}`;

          return (
            <div
              key={setting.key}
              className="flex min-h-[var(--control-lg)] items-center justify-between gap-[var(--space-4)] py-[var(--space-4)] first:pt-[var(--space-2)] last:pb-[var(--space-2)]"
            >
              <label
                htmlFor={switchId}
                className="min-w-0 cursor-pointer"
              >
                <span
                  className="block font-[var(--font-body)] text-[var(--text-base)] font-[var(--weight-medium)] text-[var(--color-text-primary)]"
                  style={{ font: "var(--text-base) var(--font-body)", fontWeight: "var(--weight-medium)" }}
                >
                  {setting.label}
                </span>
                <span
                  className="mt-[var(--space-1)] block font-[var(--font-body)] text-[var(--text-sm)] text-[var(--color-text-secondary)]"
                  style={{ font: "var(--text-sm) var(--font-body)" }}
                >
                  {setting.description}
                </span>
              </label>

              <Switch.Root
                id={switchId}
                checked={setting.enabled}
                disabled={loading}
                aria-label={setting.label}
                aria-busy={loading}
                onCheckedChange={(enabled) => onToggle(setting.key, enabled)}
                className={cn(
                  notificationSwitchVariants(),
                  "h-[var(--control-sm)] w-[var(--control-lg)]"
                )}
              >
                <Switch.Thumb className="pointer-events-none block h-[var(--space-6)] w-[var(--space-6)] translate-x-[var(--space-1)] rounded-[var(--radius-full)] bg-[var(--color-surface-raised)] transition-transform duration-[var(--duration-fast)] ease-[var(--easing-standard)] data-[state=checked]:translate-x-[var(--space-4)]" />
              </Switch.Root>
            </div>
          );
        })}
      </div>
    </section>
  );
}