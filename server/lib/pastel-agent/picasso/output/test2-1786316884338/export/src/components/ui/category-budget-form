// CategoryBudgetForm.tsx — Category-by-category budget setup with spending recommendations. Use when users are assigning monthly limits across their Wavelength spending categories.
import React, { useEffect, useState } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const categoryBudgetFormVariants = cva(
  "w-full rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] shadow-[var(--shadow-sm)]"
);

const actionVariants = cva(
  "inline-flex items-center justify-center gap-[var(--space-2)] rounded-[var(--radius-md)] font-[var(--weight-medium)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      variant: {
        primary:
          "bg-[var(--color-accent-500)] text-[var(--color-text-inverse)] hover:bg-[var(--color-accent-600)] active:bg-[var(--color-accent-700)]",
      },
      size: {
        md: "h-[var(--control-md)] px-[var(--space-4)] text-base",
      },
    },
    defaultVariants: {
      variant: "primary",
      size: "md",
    },
  }
);

interface CategoryBudgetFormProps
  extends React.FormHTMLAttributes<HTMLFormElement> {
  categories: Array<{
    name: string;
    suggestedPercentage: number;
    suggestedAmount: number;
  }>;
  totalIncome: number;
  onBudgetChange: (category: string, amount: number) => void;
  onSave: () => void;
  loading?: boolean;
  error?: string;
}

export default function CategoryBudgetForm({
  categories,
  totalIncome,
  onBudgetChange,
  onSave,
  loading = false,
  error,
  className,
  ...props
}: CategoryBudgetFormProps) {
  const [budgets, setBudgets] = useState<Record<string, string>>(() =>
    Object.fromEntries(
      categories.map((category) => [
        category.name,
        String(category.suggestedAmount),
      ])
    )
  );

  useEffect(() => {
    setBudgets(
      Object.fromEntries(
        categories.map((category) => [
          category.name,
          String(category.suggestedAmount),
        ])
      )
    );
  }, [categories]);

  const invalidCategories = categories.filter((category) => {
    const value = budgets[category.name];
    return value === "" || !Number.isFinite(Number(value)) || Number(value) < 0;
  });

  const handleBudgetChange = (category: string, value: string) => {
    setBudgets((current) => ({ ...current, [category]: value }));

    const amount = Number(value);
    onBudgetChange(category, Number.isFinite(amount) ? amount : 0);
  };

  const handleSubmit = (event: React.FormEvent<HTMLFormElement>) => {
    event.preventDefault();

    if (invalidCategories.length > 0 || loading) {
      return;
    }

    onSave();
  };

  return (
    <form
      className={cn(categoryBudgetFormVariants(), className)}
      onSubmit={handleSubmit}
      aria-busy={loading}
      {...props}
    >
      <div className="flex flex-col gap-[var(--space-2)] border-b border-[var(--color-border-subtle)] pb-[var(--space-6)]">
        <div className="flex flex-col gap-[var(--space-1)]">
          <h2 className="font-[var(--font-display)] text-xl font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
            Shape your monthly budget
          </h2>
          <p className="text-base text-[var(--color-text-secondary)]">
            Set spending limits that fit your monthly income.
          </p>
        </div>
        <p className="font-[var(--font-mono)] text-sm tabular-nums text-[var(--color-text-muted)]">
          Monthly income:{" "}
          {new Intl.NumberFormat(undefined, {
            style: "currency",
            currency: "USD",
            maximumFractionDigits: 0,
          }).format(totalIncome)}
        </p>
      </div>

      <div className="divide-y divide-[var(--color-border-subtle)]">
        {categories.map((category, index) => {
          const inputId = `category-budget-${index}`;
          const errorId = `${inputId}-error`;
          const value = budgets[category.name];
          const hasError =
            value === "" ||
            !Number.isFinite(Number(value)) ||
            Number(value) < 0;

          return (
            <div
              key={category.name}
              className="grid grid-cols-1 items-center gap-[var(--space-4)] py-[var(--space-4)] md:grid-cols-[minmax(0,1fr)_auto]"
            >
              <div className="flex min-w-0 flex-col gap-[var(--space-1)]">
                <label
                  htmlFor={inputId}
                  className="font-[var(--weight-medium)] text-base text-[var(--color-text-primary)]"
                >
                  {category.name}
                </label>
                <p className="text-sm text-[var(--color-text-muted)]">
                  Suggested:{" "}
                  {new Intl.NumberFormat(undefined, {
                    style: "currency",
                    currency: "USD",
                    maximumFractionDigits: 0,
                  }).format(category.suggestedAmount)}{" "}
                  · {category.suggestedPercentage}%
                </p>
                {hasError && (
                  <p
                    id={errorId}
                    className="text-sm text-[var(--color-danger-500)]"
                  >
                    Enter a budget of zero or more.
                  </p>
                )}
              </div>

              <div className="relative flex items-center md:min-w-[var(--control-lg)]">
                <span
                  className="pointer-events-none absolute left-[var(--space-3)] text-base text-[var(--color-text-muted)]"
                  aria-hidden="true"
                >
                  $
                </span>
                <input
                  id={inputId}
                  name={category.name}
                  type="number"
                  min="0"
                  step="1"
                  inputMode="decimal"
                  value={value}
                  onChange={(event) =>
                    handleBudgetChange(category.name, event.target.value)
                  }
                  disabled={loading}
                  aria-invalid={hasError}
                  aria-describedby={hasError ? errorId : undefined}
                  className={cn(
                    "h-[var(--control-md)] w-full rounded-[var(--radius-md)] border bg-[var(--color-surface-background)] pl-[var(--space-6)] pr-[var(--space-3)] text-right font-[var(--font-mono)] text-base tabular-nums text-[var(--color-text-primary)] outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-neutral-500)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:border-[var(--color-border-focus)] disabled:pointer-events-none disabled:opacity-50",
                    hasError
                      ? "border-[var(--color-danger-500)]"
                      : "border-[var(--color-border-default)]"
                  )}
                />
              </div>
            </div>
          );
        })}
      </div>

      {(error || invalidCategories.length > 0) && (
        <div
          className="mt-[var(--space-4)] rounded-[var(--radius-md)] border border-[var(--color-danger-500)] bg-[var(--color-danger-50)] px-[var(--space-3)] py-[var(--space-2)] text-sm text-[var(--color-danger-900)]"
          role="alert"
        >
          {error || "Review the highlighted budgets before saving."}
        </div>
      )}

      <div className="mt-[var(--space-6)] flex justify-end">
        <button
          type="submit"
          className={cn(actionVariants({ variant: "primary", size: "md" }))}
          disabled={loading || invalidCategories.length > 0}
          aria-busy={loading}
        >
          {loading && (
            <svg
              className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                className="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                strokeWidth="4"
              />
              <path
                className="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
              />
            </svg>
          )}
          Save category budgets
        </button>
      </div>
    </form>
  );
}