// BudgetLimitsList.tsx — Editable spending-category limits with a single save action. Use on budgeting screens where users adjust several limits together.
import { useId, type FormEvent } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const budgetLimitsVariants = cva(
  "w-full rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] p-[var(--space-6)] font-[var(--font-body)] text-[var(--color-text-primary)] shadow-[var(--shadow-md)]",
  {
    variants: {},
  }
);

const saveButtonVariants = cva(
  "inline-flex items-center justify-center gap-[var(--space-2)] rounded-[var(--radius-md)] border font-[var(--weight-medium)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      variant: {
        primary:
          "border-[var(--color-accent-500)] bg-[var(--color-accent-500)] text-[var(--color-text-inverse)] hover:border-[var(--color-accent-600)] hover:bg-[var(--color-accent-600)] active:border-[var(--color-accent-700)] active:bg-[var(--color-accent-700)]",
      },
      size: {
        md: "h-[var(--control-md)] px-[var(--space-4)] text-base",
      },
    },
    defaultVariants: {
      variant: "primary",
      size: "md",
    },
  }
);

interface BudgetLimit {
  category: string;
  limit: number;
}

export interface BudgetLimitsListProps
  extends VariantProps<typeof budgetLimitsVariants> {
  budgets: BudgetLimit[];
  onBudgetChange: (category: string, limit: number) => void;
  onSave: () => void;
  isLoading?: boolean;
  error?: string;
}

export default function BudgetLimitsList({
  budgets,
  onBudgetChange,
  onSave,
  isLoading = false,
  error,
  className,
}: BudgetLimitsListProps) {
  const idPrefix = useId();

  function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    onSave();
  }

  return (
    <form
      className={cn(budgetLimitsVariants(), className)}
      onSubmit={handleSubmit}
      aria-label="Budget limits"
      aria-busy={isLoading}
    >
      <div className="flex items-start justify-between gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] pb-[var(--space-4)]">
        <div>
          <h2 className="font-[var(--font-display)] text-xl font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
            Budget limits
          </h2>
          <p className="mt-[var(--space-1)] text-sm text-[var(--color-text-secondary)]">
            Keep each spending lane on track.
          </p>
        </div>
        <span className="rounded-[var(--radius-full)] bg-[var(--color-accent-50)] px-[var(--space-3)] py-[var(--space-1)] font-[var(--font-mono)] text-xs font-[var(--weight-medium)] text-[var(--color-accent-900)]">
          Monthly
        </span>
      </div>

      <div className="divide-y divide-[var(--color-border-subtle)]">
        {budgets.map((budget, index) => {
          const inputId = `${idPrefix}-budget-${index}`;
          const hasError = Boolean(error);

          return (
            <div
              className="flex items-center justify-between gap-[var(--space-4)] py-[var(--space-4)]"
              key={budget.category}
            >
              <label
                className="min-w-0 flex-1 font-[var(--weight-medium)] text-[var(--color-text-primary)]"
                htmlFor={inputId}
              >
                {budget.category}
              </label>

              <div className="flex shrink-0 items-center gap-[var(--space-2)]">
                <span
                  className="font-[var(--font-mono)] text-base text-[var(--color-text-muted)]"
                  aria-hidden="true"
                >
                  $
                </span>
                <input
                  id={inputId}
                  className={cn(
                    "h-[var(--control-md)] w-[var(--space-24)] rounded-[var(--radius-md)] border bg-[var(--color-surface-raised)] px-[var(--space-3)] text-right font-[var(--font-mono)] text-base tabular-nums text-[var(--color-text-primary)] outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-accent-500)] focus-visible:border-[var(--color-border-focus)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:border-[var(--color-accent-600)] disabled:pointer-events-none disabled:opacity-50",
                    hasError
                      ? "border-[var(--color-danger-500)]"
                      : "border-[var(--color-border-default)]"
                  )}
                  type="number"
                  min="0"
                  step="1"
                  value={budget.limit}
                  onChange={(event) =>
                    onBudgetChange(budget.category, Number(event.target.value))
                  }
                  disabled={isLoading}
                  aria-label={`${budget.category} monthly limit`}
                  aria-invalid={hasError}
                  aria-describedby={hasError ? `${idPrefix}-error` : undefined}
                />
              </div>
            </div>
          );
        })}
      </div>

      {error && (
        <p
          id={`${idPrefix}-error`}
          className="mt-[var(--space-4)] rounded-[var(--radius-md)] border border-[var(--color-danger-500)] bg-[var(--color-danger-50)] px-[var(--space-3)] py-[var(--space-2)] text-sm text-[var(--color-danger-900)]"
          role="alert"
        >
          {error}
        </p>
      )}

      <div className="flex justify-end border-t border-[var(--color-border-subtle)] pt-[var(--space-4)]">
        <button
          className={cn(saveButtonVariants({ variant: "primary", size: "md" }))}
          type="submit"
          disabled={isLoading}
          aria-busy={isLoading}
        >
          {isLoading && (
            <svg
              className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                className="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                strokeWidth="4"
              />
              <path
                className="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
              />
            </svg>
          )}
          {isLoading ? "Saving limits" : "Save changes"}
        </button>
      </div>
    </form>
  );
}