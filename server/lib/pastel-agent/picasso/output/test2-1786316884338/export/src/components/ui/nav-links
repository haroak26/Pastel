// NavLinks.tsx — Vertical Wavelength navigation for moving between budget, goal, transaction, and account views.
import type { MouseEvent } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const navLinkVariants = cva(
  "relative inline-flex h-[var(--control-lg)] w-full items-center gap-[var(--space-3)] rounded-[var(--radius-md)] px-[var(--space-4)] font-[var(--font-body)] text-[var(--text-base)] font-[var(--weight-medium)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:translate-y-[var(--space-1)]",
  {
    variants: {
      active: {
        true: "bg-[var(--color-accent-50)] text-[var(--color-accent-900)] hover:bg-[var(--color-accent-100)] active:bg-[var(--color-accent-100)]",
        false:
          "text-[var(--color-text-secondary)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)]",
      },
      disabled: {
        true: "pointer-events-none opacity-50",
        false: "",
      },
    },
    defaultVariants: {
      active: false,
      disabled: false,
    },
  }
);

export interface NavLink {
  label: string;
  href: string;
  icon: string;
}

export interface NavLinksProps extends VariantProps<typeof navLinkVariants> {
  links: NavLink[];
  activeLink: string;
  onLinkClick?: (href: string) => void;
  loading?: boolean;
  disabled?: boolean;
  className?: string;
}

function NavIcon({ name }: { name: string }) {
  const commonProps = {
    className: "h-[var(--space-4)] w-[var(--space-4)] shrink-0",
    fill: "none",
    stroke: "currentColor",
    strokeLinecap: "round" as const,
    strokeLinejoin: "round" as const,
    strokeWidth: 1.8,
    viewBox: "0 0 24 24",
    "aria-hidden": true,
  };

  switch (name) {
    case "dashboard":
      return (
        <svg {...commonProps}>
          <rect x="4" y="4" width="6" height="6" rx="1" />
          <rect x="14" y="4" width="6" height="6" rx="1" />
          <rect x="4" y="14" width="6" height="6" rx="1" />
          <rect x="14" y="14" width="6" height="6" rx="1" />
        </svg>
      );
    case "goals":
      return (
        <svg {...commonProps}>
          <circle cx="12" cy="12" r="8" />
          <circle cx="12" cy="12" r="4" />
          <path d="m15 9 3-3" />
          <path d="M18 6h-3" />
          <path d="M18 6v3" />
        </svg>
      );
    case "transactions":
      return (
        <svg {...commonProps}>
          <path d="M5 7h14" />
          <path d="m15 4 4 3-4 3" />
          <path d="M19 17H5" />
          <path d="m9 14-4 3 4 3" />
        </svg>
      );
    case "settings":
      return (
        <svg {...commonProps}>
          <path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z" />
          <path d="m19.4 15 .1.1a1.8 1.8 0 0 1-2.5 2.5l-.1-.1a1.8 1.8 0 0 0-3.1 1.3v.2a1.8 1.8 0 0 1-3.6 0v-.2a1.8 1.8 0 0 0-3.1-1.3l-.1.1a1.8 1.8 0 0 1-2.5-2.5l.1-.1a1.8 1.8 0 0 0-1.3-3.1h-.2a1.8 1.8 0 0 1 0-3.6h.2A1.8 1.8 0 0 0 4.6 5l-.1-.1A1.8 1.8 0 0 1 7 2.4l.1.1a1.8 1.8 0 0 0 3.1-1.3V1a1.8 1.8 0 0 1 3.6 0v.2a1.8 1.8 0 0 0 3.1 1.3l.1-.1a1.8 1.8 0 0 1 2.5 2.5l-.1.1a1.8 1.8 0 0 0 1.3 3.1h.2a1.8 1.8 0 0 1 0 3.6h-.2a1.8 1.8 0 0 0-1.3 3.1Z" />
        </svg>
      );
    default:
      return (
        <svg {...commonProps}>
          <circle cx="12" cy="12" r="8" />
          <circle cx="12" cy="12" r="1" />
        </svg>
      );
  }
}

export default function NavLinks({
  links,
  activeLink,
  onLinkClick,
  loading = false,
  disabled = false,
  className,
}: NavLinksProps) {
  const handleLinkClick = (
    event: MouseEvent<HTMLAnchorElement>,
    href: string
  ) => {
    if (disabled || loading) {
      event.preventDefault();
      return;
    }

    onLinkClick?.(href);
  };

  return (
    <nav
      aria-label="Primary navigation"
      aria-busy={loading}
      className={cn(
        "flex w-full flex-col gap-[var(--space-1)]",
        className
      )}
    >
      {links.map((link) => {
        const isActive = link.href === activeLink;

        return (
          <a
            key={link.href}
            href={link.href}
            className={cn(
              navLinkVariants({ active: isActive, disabled: disabled || loading })
            )}
            aria-current={isActive ? "page" : undefined}
            aria-disabled={disabled || loading ? true : undefined}
            aria-busy={loading}
            onClick={(event) => handleLinkClick(event, link.href)}
          >
            {isActive && (
              <span
                className="absolute left-[var(--space-1)] h-[var(--space-6)] w-[var(--space-1)] rounded-[var(--radius-full)] bg-[var(--color-accent-500)]"
                aria-hidden="true"
              />
            )}
            {loading ? (
              <svg
                className="h-[var(--space-4)] w-[var(--space-4)] shrink-0 animate-spin duration-[var(--duration-slow)]"
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <circle
                  className="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  strokeWidth="4"
                />
                <path
                  className="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4Z"
                />
              </svg>
            ) : (
              <NavIcon name={link.icon} />
            )}
            <span>{link.label}</span>
          </a>
        );
      })}
    </nav>
  );
}