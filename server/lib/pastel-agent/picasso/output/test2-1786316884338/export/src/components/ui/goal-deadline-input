// GoalDeadlineInput.tsx — Date picker for goal deadline selection. Use in goal creation/editing forms to set target completion dates with validation and error handling.
import React, { useRef, useState } from "react";
import { cn } from "../lib/cn";

export interface GoalDeadlineInputProps {
  value: Date | null;
  onChange: (date: Date | null) => void;
  minDate?: Date;
  error?: string | null;
  disabled?: boolean;
  placeholder?: string;
}

export default function GoalDeadlineInput({
  value,
  onChange,
  minDate = new Date(),
  error = null,
  disabled = false,
  placeholder = "Select deadline",
}: GoalDeadlineInputProps) {
  const [isOpen, setIsOpen] = useState(false);
  const [displayMonth, setDisplayMonth] = useState(
    value ? new Date(value.getFullYear(), value.getMonth()) : new Date()
  );
  const inputRef = useRef<HTMLInputElement>(null);
  const containerRef = useRef<HTMLDivElement>(null);

  const formatDate = (date: Date | null): string => {
    if (!date) return "";
    return date.toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    });
  };

  const getDaysInMonth = (date: Date): number => {
    return new Date(date.getFullYear(), date.getMonth() + 1, 0).getDate();
  };

  const getFirstDayOfMonth = (date: Date): number => {
    return new Date(date.getFullYear(), date.getMonth(), 1).getDay();
  };

  const handlePrevMonth = () => {
    setDisplayMonth(
      new Date(displayMonth.getFullYear(), displayMonth.getMonth() - 1)
    );
  };

  const handleNextMonth = () => {
    setDisplayMonth(
      new Date(displayMonth.getFullYear(), displayMonth.getMonth() + 1)
    );
  };

  const handleDateSelect = (day: number) => {
    const selectedDate = new Date(
      displayMonth.getFullYear(),
      displayMonth.getMonth(),
      day
    );
    if (selectedDate >= minDate) {
      onChange(selectedDate);
      setIsOpen(false);
    }
  };

  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const input = e.target.value;
    if (!input) {
      onChange(null);
      return;
    }

    const parsed = new Date(input);
    if (!isNaN(parsed.getTime()) && parsed >= minDate) {
      onChange(parsed);
      setDisplayMonth(new Date(parsed.getFullYear(), parsed.getMonth()));
    }
  };

  const handleInputFocus = () => {
    setIsOpen(true);
  };

  const handleClickOutside = (e: MouseEvent) => {
    if (
      containerRef.current &&
      !containerRef.current.contains(e.target as Node)
    ) {
      setIsOpen(false);
    }
  };

  React.useEffect(() => {
    if (isOpen) {
      document.addEventListener("mousedown", handleClickOutside);
      return () => {
        document.removeEventListener("mousedown", handleClickOutside);
      };
    }
  }, [isOpen]);

  const daysInMonth = getDaysInMonth(displayMonth);
  const firstDay = getFirstDayOfMonth(displayMonth);
  const days: (number | null)[] = [
    ...Array(firstDay).fill(null),
    ...Array.from({ length: daysInMonth }, (_, i) => i + 1),
  ];

  const monthYear = displayMonth.toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
  });

  const isDateDisabled = (day: number): boolean => {
    const testDate = new Date(
      displayMonth.getFullYear(),
      displayMonth.getMonth(),
      day
    );
    return testDate < minDate;
  };

  const isDateSelected = (day: number): boolean => {
    if (!value) return false;
    return (
      value.getDate() === day &&
      value.getMonth() === displayMonth.getMonth() &&
      value.getFullYear() === displayMonth.getFullYear()
    );
  };

  return (
    <div ref={containerRef} className="relative w-full">
      <div className="flex flex-col gap-[var(--space-2)]">
        <div
          className={cn(
            "relative inline-flex items-center rounded-[var(--radius-md)] border transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
            error
              ? "border-[var(--color-danger-500)] bg-[var(--color-danger-50)]"
              : "border-[var(--color-border-default)] bg-[var(--color-surface-raised)]",
            isOpen && !error
              ? "border-[var(--color-border-focus)] ring-2 ring-[var(--color-accent-50)]"
              : "",
            disabled ? "opacity-50 pointer-events-none" : ""
          )}
        >
          <input
            ref={inputRef}
            type="text"
            value={formatDate(value)}
            onChange={handleInputChange}
            onFocus={handleInputFocus}
            placeholder={placeholder}
            disabled={disabled}
            className={cn(
              "w-full h-[var(--control-md)] px-[var(--space-3)] py-[var(--space-2)] bg-transparent text-[var(--text-base)] font-[var(--weight-regular)] font-[var(--font-body)] text-[var(--color-text-primary)] placeholder-[var(--color-text-muted)] outline-none",
              "focus-visible:outline-none"
            )}
            aria-label="Goal deadline"
            aria-invalid={!!error}
            aria-describedby={error ? "deadline-error" : undefined}
          />
          <svg
            className={cn(
              "mr-[var(--space-3)] w-5 h-5 text-[var(--color-text-secondary)] pointer-events-none transition-transform duration-[var(--duration-fast)]",
              isOpen ? "rotate-180" : ""
            )}
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              strokeLinecap="round"
              strokeLinejoin="round"
              strokeWidth={2}
              d="M19 14l-7 7m0 0l-7-7m7 7V3"
            />
          </svg>
        </div>

        {error && (
          <span
            id="deadline-error"
            className="text-[var(--text-xs)] font-[var(--weight-regular)] text-[var(--color-danger-500)]"
          >
            {error}
          </span>
        )}
      </div>

      {isOpen && (
        <div
          className="absolute top-full left-0 mt-[var(--space-2)] bg-[var(--color-surface-raised)] border border-[var(--color-border-default)] rounded-[var(--radius-lg)] shadow-[var(--shadow-md)] z-50 p-[var(--space-4)] w-80"
          role="dialog"
          aria-label="Date picker"
        >
          <div className="flex items-center justify-between mb-[var(--space-4)]">
            <button
              onClick={handlePrevMonth}
              className={cn(
                "p-[var(--space-2)] rounded-[var(--radius-md)] text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)]",
                "hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)]",
                "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2"
              )}
              aria-label="Previous month"
            >
              <svg
                className="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  strokeWidth={2}
                  d="M15 19l-7-7 7-7"
                />
              </svg>
            </button>

            <h3 className="text-[var(--text-base)] font-[var(--weight-semibold)] text-[var(--color-text-primary)] font-[var(--font-display)]">
              {monthYear}
            </h3>

            <button
              onClick={handleNextMonth}
              className={cn(
                "p-[var(--space-2)] rounded-[var(--radius-md)] text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)]",
                "hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)]",
                "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2"
              )}
              aria-label="Next month"
            >
              <svg
                className="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  strokeWidth={2}
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </button>
          </div>

          <div className="grid grid-cols-7 gap-[var(--space-1)] mb-[var(--space-3)]">
            {["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"].map((day) => (
              <div
                key={day}
                className="text-center text-[var(--text-xs)] font-[var(--weight-semibold)] text-[var(--color-text-muted)] h-8 flex items-center justify-center"
              >
                {day}
              </div>
            ))}
          </div>

          <div className="grid grid-cols-7 gap-[var(--space-1)]">
            {days.map((day, idx) => (
              <button
                key={idx}
                onClick={() => day && handleDateSelect(day)}
                disabled={day === null || isDateDisabled(day)}
                className={cn(
                  "h-8 rounded-[var(--radius-md)] text-[var(--text-sm)] font-[var(--weight-regular)] transition-all duration-[var(--duration-fast)]",
                  day === null ? "cursor-default" : "",
                  day !== null && !isDateDisabled(day)
                    ? "cursor-pointer hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-1"
                    : "",
                  isDateSelected(day || 0)
                    ? "bg-[var(--color-accent-500)] text-[var(--color-text-inverse)] font-[var(--weight-semibold)] hover:bg-[var(--color-accent-600)] active:bg-[var(--color-accent-600)]"
                    : "",
                  isDateDisabled(day || 0)
                    ? "text-[var(--color-text-muted)] opacity-50 cursor-not-allowed"
                    : "text-[var(--color-text-primary)]"
                )}
                aria-label={
                  day
                    ? `${day} ${monthYear}`
                    : "Not available"
                }
                aria-current={isDateSelected(day || 0) ? "date" : undefined}
              >
                {day}
              </button>
            ))}
          </div>

          <div className="mt-[var(--space-4)] pt-[var(--space-3)] border-t border-[var(--color-border-subtle)] flex gap-[var(--space-2)]">
            <button
              onClick={() => {
                onChange(null);
                setIsOpen(false);
              }}
              className={cn(
                "flex-1 h-[var(--control-sm)] rounded-[var(--radius-md)] text-[var(--text-sm)] font-[var(--weight-medium)] bg-[var(--color-neutral-100)] text-[var(--color-text-primary)] transition-colors duration-[var(--duration-fast)]",
                "hover:bg-[var(--color-neutral-200)] active:bg-[var(--color-neutral-300)]",
                "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2"
              )}
            >
              Clear
            </button>
            <button
              onClick={() => setIsOpen(false)}
              className={cn(
                "flex-1 h-[var(--control-sm)] rounded-[var(--radius-md)] text-[var(--text-sm)] font-[var(--weight-medium)] bg-[var(--color-accent-500)] text-[var(--color-text-inverse)] transition-colors duration-[var(--duration-fast)]",
                "hover:bg-[var(--color-accent-600)] active:bg-[var(--color-accent-600)]",
                "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2"
              )}
            >
              Done
            </button>
          </div>
        </div>
      )}
    </div>
  );
}