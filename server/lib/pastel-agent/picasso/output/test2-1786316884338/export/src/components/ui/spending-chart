// SpendingChart.tsx — Spending breakdown by category for dashboard budgets. Use to help users quickly see where their money went.
import { type HTMLAttributes } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const spendingChartVariants = cva(
  "rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] font-[var(--font-body)] text-[var(--color-text-primary)] shadow-[var(--shadow-sm)]",
  {
    variants: {
      chartType: {
        bar: "",
        donut: "",
      },
      layout: {
        horizontal: "",
        vertical: "",
      },
    },
    defaultVariants: {
      chartType: "bar",
      layout: "horizontal",
    },
  }
);

export interface SpendingCategory {
  category: string;
  amount: number;
  percentage: number;
  color: string;
}

export interface SpendingChartProps
  extends HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof spendingChartVariants> {
  data: SpendingCategory[];
  totalSpent: number;
  isLoading?: boolean;
  onCategoryClick?: (category: string) => void;
}

function resolveTokenColor(color: string) {
  if (color.startsWith("var(--color-")) {
    return color;
  }

  if (color.startsWith("--color-")) {
    return `var(${color})`;
  }

  return "var(--color-accent-500)";
}

function formatAmount(amount: number) {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 2,
  }).format(amount);
}

function LoadingSpinner() {
  return (
    <svg
      className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <circle
        className="opacity-25"
        cx="12"
        cy="12"
        r="10"
        stroke="currentColor"
        strokeWidth="4"
      />
      <path
        className="opacity-75"
        fill="currentColor"
        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
      />
    </svg>
  );
}

function DonutChart({ data }: { data: SpendingCategory[] }) {
  const radius = 42;
  const circumference = 2 * Math.PI * radius;
  let offset = 0;

  return (
    <div className="relative flex shrink-0 items-center justify-center">
      <svg
        className="h-[var(--space-24)] w-[var(--space-24)] -rotate-90"
        viewBox="0 0 100 100"
        role="img"
        aria-label="Spending distribution by category"
      >
        <circle
          cx="50"
          cy="50"
          r={radius}
          fill="none"
          stroke="var(--color-neutral-200)"
          strokeWidth="12"
        />
        {data.map((item) => {
          const segmentLength = (item.percentage / 100) * circumference;
          const segmentOffset = offset;
          offset += segmentLength;

          return (
            <circle
              key={item.category}
              cx="50"
              cy="50"
              r={radius}
              fill="none"
              stroke={resolveTokenColor(item.color)}
              strokeWidth="12"
              strokeDasharray={`${segmentLength} ${circumference - segmentLength}`}
              strokeDashoffset={-segmentOffset}
              strokeLinecap="butt"
            />
          );
        })}
      </svg>
    </div>
  );
}

function BarChart({
  data,
  layout,
  onCategoryClick,
}: {
  data: SpendingCategory[];
  layout: "horizontal" | "vertical";
  onCategoryClick?: (category: string) => void;
}) {
  const isVertical = layout === "vertical";

  return (
    <div
      className={cn(
        "flex",
        isVertical
          ? "min-h-[var(--space-24)] items-end gap-[var(--space-3)]"
          : "flex-col gap-[var(--space-4)]"
      )}
      role="list"
      aria-label="Spending categories"
    >
      {data.map((item) => {
        const categoryColor = resolveTokenColor(item.color);
        const categoryContent = (
          <>
            <span
              className={cn(
                "truncate font-[var(--weight-medium)] text-[var(--color-text-primary)]",
                isVertical
                  ? "max-w-[var(--space-12)] text-center text-[length:var(--text-xs)]"
                  : "text-[length:var(--text-sm)]"
              )}
            >
              {item.category}
            </span>
            <span
              className={cn(
                "tabular-nums text-[var(--color-text-muted)]",
                isVertical
                  ? "text-[length:var(--text-xs)]"
                  : "text-[length:var(--text-sm)]"
              )}
            >
              {item.percentage}%
            </span>
          </>
        );

        return (
          <div
            key={item.category}
            className={cn(
              "group",
              isVertical
                ? "flex min-w-0 flex-1 flex-col items-center gap-[var(--space-2)]"
                : "flex flex-col gap-[var(--space-2)]"
            )}
            role="listitem"
          >
            <button
              type="button"
              onClick={() => onCategoryClick?.(item.category)}
              disabled={!onCategoryClick}
              aria-label={`${item.category}: ${item.percentage}% of spending, ${formatAmount(item.amount)}`}
              className={cn(
                "flex w-full items-center gap-[var(--space-2)] rounded-[var(--radius-sm)] text-left transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:scale-[0.99] disabled:pointer-events-none",
                isVertical
                  ? "flex-col justify-end"
                  : "justify-between hover:bg-[var(--color-neutral-50)]"
              )}
            >
              {isVertical ? (
                <div className="flex h-[var(--space-16)] w-[var(--space-8)] items-end">
                  <span
                    className="block w-full rounded-t-[var(--radius-sm)] transition-all duration-[var(--duration-base)] ease-[var(--easing-standard)] group-hover:opacity-80"
                    style={{
                      height: `${Math.max(item.percentage, 4)}%`,
                      backgroundColor: categoryColor,
                    }}
                  />
                </div>
              ) : (
                <div className="flex min-w-0 flex-1 items-center gap-[var(--space-2)]">
                  <span
                    className="h-[var(--space-2)] w-[var(--space-2)] shrink-0 rounded-[var(--radius-full)]"
                    style={{ backgroundColor: categoryColor }}
                    aria-hidden="true"
                  />
                  {categoryContent}
                </div>
              )}
              {isVertical && categoryContent}
            </button>

            {!isVertical && (
              <div
                className="h-[var(--space-2)] overflow-hidden rounded-[var(--radius-full)] bg-[var(--color-neutral-100)]"
                aria-hidden="true"
              >
                <span
                  className="block h-full rounded-[var(--radius-full)] transition-all duration-[var(--duration-slow)] ease-[var(--easing-standard)] group-hover:opacity-80"
                  style={{
                    width: `${Math.min(Math.max(item.percentage, 0), 100)}%`,
                    backgroundColor: categoryColor,
                  }}
                />
              </div>
            )}

            <span
              className={cn(
                "tabular-nums text-[var(--color-text-muted)]",
                isVertical
                  ? "text-[length:var(--text-xs)]"
                  : "pl-[var(--space-4)] text-[length:var(--text-xs)]"
              )}
            >
              {formatAmount(item.amount)}
            </span>
          </div>
        );
      })}
    </div>
  );
}

export default function SpendingChart({
  className,
  chartType = "bar",
  layout = "horizontal",
  data,
  totalSpent,
  isLoading = false,
  onCategoryClick,
  ...props
}: SpendingChartProps) {
  const isEmpty = !isLoading && data.length === 0;

  return (
    <section
      className={cn(
        spendingChartVariants({ chartType, layout }),
        className
      )}
      aria-busy={isLoading}
      {...props}
    >
      <div className="flex items-start justify-between gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] pb-[var(--space-4)]">
        <div>
          <p className="font-[var(--font-display)] text-[length:var(--text-lg)] font-[var(--weight-semibold)]">
            Spending breakdown
          </p>
          <p className="mt-[var(--space-1)] text-[length:var(--text-sm)] text-[var(--color-text-muted)]">
            Where your budget went this period
          </p>
        </div>
        <p className="shrink-0 font-[var(--font-display)] text-[length:var(--text-xl)] font-[var(--weight-semibold)] tabular-nums">
          {formatAmount(totalSpent)}
        </p>
      </div>

      <div className="pt-[var(--space-6)]">
        {isLoading ? (
          <div
            className="flex min-h-[var(--space-24)] items-center justify-center gap-[var(--space-2)] text-[length:var(--text-sm)] text-[var(--color-text-muted)]"
            role="status"
          >
            <LoadingSpinner />
            <span>Updating your spending</span>
          </div>
        ) : isEmpty ? (
          <div className="flex min-h-[var(--space-24)] items-center justify-center text-[length:var(--text-sm)] text-[var(--color-text-muted)]">
            No spending recorded yet.
          </div>
        ) : chartType === "donut" ? (
          <div className="flex items-center gap-[var(--space-6)]">
            <DonutChart data={data} />
            <div
              className="flex min-w-0 flex-1 flex-col divide-y divide-[var(--color-border-subtle)]"
              role="list"
              aria-label="Spending categories"
            >
              {data.map((item) => (
                <button
                  key={item.category}
                  type="button"
                  onClick={() => onCategoryClick?.(item.category)}
                  disabled={!onCategoryClick}
                  className="flex min-h-[var(--control-sm)] items-center justify-between gap-[var(--space-3)] py-[var(--space-2)] text-left transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-50)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:bg-[var(--color-neutral-100)] disabled:pointer-events-none"
                  aria-label={`${item.category}: ${item.percentage}% of spending, ${formatAmount(item.amount)}`}
                >
                  <span className="flex min-w-0 items-center gap-[var(--space-2)]">
                    <span
                      className="h-[var(--space-2)] w-[var(--space-2)] shrink-0 rounded-[var(--radius-full)]"
                      style={{ backgroundColor: resolveTokenColor(item.color) }}
                      aria-hidden="true"
                    />
                    <span className="truncate text-[length:var(--text-sm)] font-[var(--weight-medium)]">
                      {item.category}
                    </span>
                  </span>
                  <span className="shrink-0 tabular-nums text-[length:var(--text-sm)] text-[var(--color-text-muted)]">
                    {item.percentage}%
                  </span>
                </button>
              ))}
            </div>
          </div>
        ) : (
          <BarChart
            data={data}
            layout={layout ?? "horizontal"}
            onCategoryClick={onCategoryClick}
          />
        )}
      </div>
    </section>
  );
}