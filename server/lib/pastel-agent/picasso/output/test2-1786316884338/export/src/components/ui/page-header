// PageHeader.tsx — Provides month navigation, the active month label, and an account menu trigger for Wavelength app screens.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const pageHeaderVariants = cva(
  "flex w-full items-center justify-between border-b border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] font-[var(--font-body)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
  {
    variants: {
      layout: {
        compact:
          "min-h-[var(--control-lg)] gap-[var(--space-3)] px-[var(--space-4)] py-[var(--space-2)]",
        expanded:
          "min-h-[var(--control-lg)] gap-[var(--space-4)] px-[var(--space-6)] py-[var(--space-4)]",
      },
    },
    defaultVariants: {
      layout: "compact",
    },
  }
);

export interface PageHeaderProps
  extends React.HTMLAttributes<HTMLElement>,
    VariantProps<typeof pageHeaderVariants> {
  currentMonth: Date;
  onMonthChange: (direction: "prev" | "next") => void;
  onUserMenuOpen?: () => void;
  loading?: boolean;
}

export default function PageHeader({
  className,
  layout,
  currentMonth,
  onMonthChange,
  onUserMenuOpen,
  loading = false,
  ...props
}: PageHeaderProps) {
  const monthLabel = new Intl.DateTimeFormat(undefined, {
    month: "long",
    year: "numeric",
  }).format(currentMonth);

  const controlClassName =
    "inline-flex h-[var(--control-md)] w-[var(--control-md)] items-center justify-center rounded-[var(--radius-md)] text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50";

  return (
    <header
      className={cn(pageHeaderVariants({ layout }), className)}
      aria-busy={loading}
      {...props}
    >
      <div className="flex min-w-0 items-center gap-[var(--space-2)]">
        <button
          type="button"
          className={controlClassName}
          onClick={() => onMonthChange("prev")}
          disabled={loading}
          aria-label={`Show previous month before ${monthLabel}`}
        >
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="2"
            strokeLinecap="round"
            strokeLinejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
        </button>

        <div className="flex min-w-0 items-center gap-[var(--space-2)] px-[var(--space-2)]">
          {loading && (
            <svg
              className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <circle
                className="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                strokeWidth="4"
              />
              <path
                className="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 0 1 8-8V0C5.373 0 0 5.373 0 12h4Z"
              />
            </svg>
          )}
          <h1
            className={cn(
              "truncate font-[var(--font-display)] font-[var(--weight-semibold)] text-[var(--color-text-primary)]",
              layout === "expanded"
                ? "text-[var(--text-xl)]"
                : "text-[var(--text-lg)]"
            )}
          >
            {monthLabel}
          </h1>
        </div>

        <button
          type="button"
          className={controlClassName}
          onClick={() => onMonthChange("next")}
          disabled={loading}
          aria-label={`Show next month after ${monthLabel}`}
        >
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="2"
            strokeLinecap="round"
            strokeLinejoin="round"
            aria-hidden="true"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>
      </div>

      <button
        type="button"
        className={cn(
          "inline-flex h-[var(--control-md)] items-center gap-[var(--space-2)] rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] px-[var(--space-3)] font-[var(--font-body)] text-[var(--text-sm)] font-[var(--weight-medium)] text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-accent-500)] hover:bg-[var(--color-accent-50)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-accent-100)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
          layout === "expanded" && "px-[var(--space-4)]"
        )}
        onClick={onUserMenuOpen}
        disabled={loading}
        aria-label="Open user menu"
      >
        <span
          className="inline-flex h-[var(--space-4)] w-[var(--space-4)] items-center justify-center rounded-[var(--radius-full)] bg-[var(--color-accent-500)] text-[var(--color-text-inverse)]"
          aria-hidden="true"
        >
          <svg
            className="h-[var(--space-3)] w-[var(--space-3)]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="2"
            strokeLinecap="round"
            strokeLinejoin="round"
          >
            <path d="M20 21a8 8 0 0 0-16 0" />
            <circle cx="12" cy="7" r="4" />
          </svg>
        </span>
        <span className="hidden sm:inline">Account</span>
      </button>
    </header>
  );
}