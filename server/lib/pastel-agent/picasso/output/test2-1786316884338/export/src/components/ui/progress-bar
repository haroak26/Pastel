// ProgressBar.tsx — Step-based progress indicator for showing a user’s position in a Wavelength flow.
import type { HTMLAttributes } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const progressBarVariants = cva(
  "flex w-full flex-col gap-[var(--space-2)] font-[var(--font-body)]"
);

export interface ProgressBarProps
  extends HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof progressBarVariants> {
  currentStep: number;
  totalSteps: number;
}

export default function ProgressBar({
  className,
  currentStep,
  totalSteps,
  ...props
}: ProgressBarProps) {
  const safeTotalSteps = Math.max(1, totalSteps);
  const safeCurrentStep = Math.min(
    Math.max(1, currentStep),
    safeTotalSteps
  );
  const progressPercentage = (safeCurrentStep / safeTotalSteps) * 100;

  return (
    <div
      className={cn(progressBarVariants(), className)}
      role="progressbar"
      aria-label={`Step ${safeCurrentStep} of ${safeTotalSteps}`}
      aria-valuemin={1}
      aria-valuemax={safeTotalSteps}
      aria-valuenow={safeCurrentStep}
      {...props}
    >
      <div className="flex items-center justify-between gap-[var(--space-3)]">
        <span className="font-[var(--font-body)] text-[var(--text-sm)] font-[var(--weight-medium)] text-[var(--color-text-primary)]">
          Step {safeCurrentStep} of {safeTotalSteps}
        </span>
      </div>

      <div className="h-[var(--space-2)] w-full overflow-hidden rounded-[var(--radius-full)] bg-[var(--color-neutral-200)]">
        <div
          className="h-full rounded-[var(--radius-full)] bg-[var(--color-accent-500)] transition-[width] duration-[var(--duration-base)] ease-[var(--easing-standard)]"
          style={{ width: `${progressPercentage}%` }}
        />
      </div>
    </div>
  );
}