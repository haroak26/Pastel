// CompletedGoalsList.tsx — Shows finished Wavelength savings goals with achievement details and optional goal navigation.
import React from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const completedGoalsListVariants = cva(
  "w-full overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] shadow-[var(--shadow-sm)]"
);

export interface CompletedGoal {
  id: string;
  name: string;
  completedDate: Date;
  finalAmount: number;
}

export interface CompletedGoalsListProps {
  goals: CompletedGoal[];
  onGoalClick?: (goalId: string) => void;
  isLoading?: boolean;
  emptyMessage?: string;
  className?: string;
}

function formatCompletionDate(date: Date) {
  return new Intl.DateTimeFormat(undefined, {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);
}

function formatAmount(amount: number) {
  return new Intl.NumberFormat(undefined, {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(amount);
}

export default function CompletedGoalsList({
  goals,
  onGoalClick,
  isLoading = false,
  emptyMessage = "No completed goals yet.",
  className,
}: CompletedGoalsListProps) {
  return (
    <section
      className={cn(completedGoalsListVariants(), className)}
      aria-busy={isLoading}
      aria-label="Completed savings goals"
    >
      {isLoading ? (
        <div className="divide-y divide-[var(--color-border-subtle)]" aria-live="polite">
          <div className="flex items-center gap-[var(--space-4)] px-[var(--space-4)] py-[var(--space-4)]">
            <span
              className="h-[var(--control-md)] w-[var(--control-md)] animate-pulse rounded-[var(--radius-full)] bg-[var(--color-neutral-100)]"
              aria-hidden="true"
            />
            <span className="h-[var(--space-4)] flex-1 animate-pulse rounded-[var(--radius-sm)] bg-[var(--color-neutral-100)]" />
            <span
              className="h-[var(--space-4)] w-[var(--space-12)] animate-pulse rounded-[var(--radius-sm)] bg-[var(--color-neutral-100)]"
              aria-hidden="true"
            />
          </div>
          <div className="flex items-center gap-[var(--space-4)] px-[var(--space-4)] py-[var(--space-4)]">
            <span
              className="h-[var(--control-md)] w-[var(--control-md)] animate-pulse rounded-[var(--radius-full)] bg-[var(--color-neutral-100)]"
              aria-hidden="true"
            />
            <span className="h-[var(--space-4)] flex-1 animate-pulse rounded-[var(--radius-sm)] bg-[var(--color-neutral-100)]" />
            <span
              className="h-[var(--space-4)] w-[var(--space-12)] animate-pulse rounded-[var(--radius-sm)] bg-[var(--color-neutral-100)]"
              aria-hidden="true"
            />
          </div>
          <div className="flex items-center gap-[var(--space-4)] px-[var(--space-4)] py-[var(--space-4)]">
            <span
              className="h-[var(--control-md)] w-[var(--control-md)] animate-pulse rounded-[var(--radius-full)] bg-[var(--color-neutral-100)]"
              aria-hidden="true"
            />
            <span className="h-[var(--space-4)] flex-1 animate-pulse rounded-[var(--radius-sm)] bg-[var(--color-neutral-100)]" />
            <span
              className="h-[var(--space-4)] w-[var(--space-12)] animate-pulse rounded-[var(--radius-sm)] bg-[var(--color-neutral-100)]"
              aria-hidden="true"
            />
          </div>
          <div className="flex items-center justify-center gap-[var(--space-2)] px-[var(--space-4)] py-[var(--space-4)] text-[var(--color-text-muted)]">
            <svg
              className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                className="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                strokeWidth="4"
              />
              <path
                className="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
              />
            </svg>
            <span className="text-sm">Loading completed goals</span>
          </div>
        </div>
      ) : goals.length === 0 ? (
        <div className="flex min-h-[var(--control-lg)] items-center gap-[var(--space-3)] px-[var(--space-4)] py-[var(--space-6)] text-[var(--color-text-secondary)]">
          <span
            className="flex h-[var(--control-md)] w-[var(--control-md)] shrink-0 items-center justify-center rounded-[var(--radius-full)] bg-[var(--color-success-50)] text-[var(--color-success-500)]"
            aria-hidden="true"
          >
            ✓
          </span>
          <p className="text-base font-[var(--weight-regular)]">{emptyMessage}</p>
        </div>
      ) : (
        <ul className="divide-y divide-[var(--color-border-subtle)]">
          {goals.map((goal) => {
            const content = (
              <>
                <span
                  className="flex h-[var(--control-md)] w-[var(--control-md)] shrink-0 items-center justify-center rounded-[var(--radius-full)] bg-[var(--color-success-50)] text-[var(--color-success-500)]"
                  aria-hidden="true"
                >
                  ✓
                </span>

                <span className="min-w-0 flex-1 text-left">
                  <span className="block truncate text-base font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
                    {goal.name}
                  </span>
                  <span className="mt-[var(--space-1)] block text-sm font-[var(--weight-regular)] text-[var(--color-text-muted)]">
                    Completed {formatCompletionDate(goal.completedDate)}
                  </span>
                </span>

                <span className="shrink-0 text-right">
                  <span className="block font-[var(--font-mono)] text-base font-[var(--weight-semibold)] tabular-nums text-[var(--color-text-primary)]">
                    {formatAmount(goal.finalAmount)}
                  </span>
                  <span className="mt-[var(--space-1)] block text-xs font-[var(--weight-medium)] text-[var(--color-success-500)]">
                    Completed
                  </span>
                </span>
              </>
            );

            return (
              <li key={goal.id}>
                {onGoalClick ? (
                  <button
                    type="button"
                    className="flex min-h-[var(--control-lg)] w-full items-center gap-[var(--space-4)] px-[var(--space-4)] py-[var(--space-4)] text-left transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-50)] active:bg-[var(--color-neutral-100)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-inset disabled:pointer-events-none disabled:opacity-50"
                    onClick={() => onGoalClick(goal.id)}
                    aria-label={`View completed goal ${goal.name}`}
                  >
                    {content}
                  </button>
                ) : (
                  <div className="flex min-h-[var(--control-lg)] items-center gap-[var(--space-4)] px-[var(--space-4)] py-[var(--space-4)]">
                    {content}
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      )}
    </section>
  );
}