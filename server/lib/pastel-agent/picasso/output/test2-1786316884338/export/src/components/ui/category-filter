// CategoryFilter.tsx — Multi-select spending-category filter for dashboard breakdowns and budget views.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import * as Select from "@radix-ui/react-select";
import { cn } from "../lib/cn";

const categoryFilterVariants = cva(
  "font-[var(--font-body)] text-[var(--color-text-primary)]",
  {
    variants: {
      displayMode: {
        dropdown: "w-full",
        checkboxes:
          "rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] px-[var(--space-4)] py-[var(--space-3)]",
      },
    },
    defaultVariants: {
      displayMode: "dropdown",
    },
  }
);

export interface CategoryFilterProps
  extends VariantProps<typeof categoryFilterVariants> {
  categories: string[];
  selectedCategories?: string[];
  onCategoryChange: (categories: string[]) => void;
  disabled?: boolean;
  loading?: boolean;
  className?: string;
}

export default function CategoryFilter({
  categories,
  selectedCategories = [],
  onCategoryChange,
  displayMode,
  disabled = false,
  loading = false,
  className,
}: CategoryFilterProps) {
  const [open, setOpen] = React.useState(false);
  const isDisabled = disabled || loading;

  const toggleCategory = React.useCallback(
    (category: string) => {
      const nextCategories = selectedCategories.includes(category)
        ? selectedCategories.filter((item) => item !== category)
        : [...selectedCategories, category];

      onCategoryChange(nextCategories);
    },
    [onCategoryChange, selectedCategories]
  );

  if (displayMode === "checkboxes") {
    return (
      <fieldset
        className={cn(categoryFilterVariants({ displayMode }), className)}
        disabled={isDisabled}
        aria-busy={loading}
      >
        <legend
          className="mb-[var(--space-2)] font-[var(--weight-semibold)] text-[var(--color-text-primary)]"
          style={{ font: "var(--text-sm) var(--font-body)" }}
        >
          Spending categories
        </legend>

        <div className="divide-y divide-[var(--color-border-subtle)]">
          {categories.map((category) => {
            const checked = selectedCategories.includes(category);

            return (
              <label
                key={category}
                className={cn(
                  "flex min-h-[var(--control-md)] cursor-pointer items-center gap-[var(--space-3)] py-[var(--space-2)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-50)] active:bg-[var(--color-neutral-100)]",
                  "disabled:pointer-events-none disabled:opacity-50"
                )}
              >
                <input
                  type="checkbox"
                  value={category}
                  checked={checked}
                  onChange={() => toggleCategory(category)}
                  aria-label={`Filter by ${category}`}
                  className="h-[var(--space-4)] w-[var(--space-4)] cursor-pointer rounded-[var(--radius-sm)] border border-[var(--color-border-default)] text-[var(--color-accent-500)] accent-[var(--color-accent-500)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2"
                />
                <span
                  className="flex-1"
                  style={{ font: "var(--text-base) var(--font-body)" }}
                >
                  {category}
                </span>
                {checked && (
                  <span
                    className="rounded-[var(--radius-full)] bg-[var(--color-accent-50)] px-[var(--space-2)] py-[var(--space-1)] font-[var(--weight-medium)] text-[var(--color-accent-600)]"
                    style={{ font: "var(--text-xs) var(--font-body)" }}
                  >
                    Included
                  </span>
                )}
              </label>
            );
          })}
        </div>

        {loading && (
          <svg
            className="mt-[var(--space-3)] h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}
      </fieldset>
    );
  }

  return (
    <Select.Root
      open={open}
      onOpenChange={setOpen}
      value={selectedCategories[0] ?? ""}
      onValueChange={toggleCategory}
      disabled={isDisabled}
    >
      <Select.Trigger
        className={cn(
          categoryFilterVariants({ displayMode }),
          "flex h-[var(--control-md)] w-full items-center justify-between gap-[var(--space-3)] rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] px-[var(--space-3)] text-left transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-accent-500)] hover:bg-[var(--color-neutral-50)] active:bg-[var(--color-neutral-100)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
          className
        )}
        aria-label="Filter spending categories"
        aria-busy={loading}
      >
        <Select.Value>
          <span
            className="truncate"
            style={{ font: "var(--text-base) var(--font-body)" }}
          >
            {selectedCategories.length > 0
              ? selectedCategories.join(", ")
              : "All spending"}
          </span>
        </Select.Value>

        {loading ? (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] shrink-0 animate-spin text-[var(--color-accent-500)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        ) : (
          <Select.Icon className="shrink-0 text-[var(--color-text-muted)]">
            <svg
              className="h-[var(--space-4)] w-[var(--space-4)]"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              aria-hidden="true"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </Select.Icon>
        )}
      </Select.Trigger>

      <Select.Portal>
        <Select.Content
          position="popper"
          sideOffset={4}
          className="z-50 w-[calc(var(--control-lg)*4)] overflow-hidden rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] p-[var(--space-1)] shadow-[var(--shadow-md)]"
        >
          <Select.Viewport className="max-h-[calc(var(--control-lg)*6)] overflow-y-auto">
            {categories.map((category) => {
              const checked = selectedCategories.includes(category);

              return (
                <Select.Item
                  key={category}
                  value={category}
                  onSelect={(event) => {
                    event.preventDefault();
                    toggleCategory(category);
                  }}
                  className="flex min-h-[var(--control-md)] cursor-pointer items-center gap-[var(--space-3)] rounded-[var(--radius-sm)] px-[var(--space-3)] py-[var(--space-2)] outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] focus-visible:bg-[var(--color-neutral-100)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:bg-[var(--color-neutral-200)] data-[disabled]:pointer-events-none data-[disabled]:opacity-50"
                >
                  <span
                    className={cn(
                      "flex h-[var(--space-4)] w-[var(--space-4)] items-center justify-center rounded-[var(--radius-sm)] border",
                      checked
                        ? "border-[var(--color-accent-500)] bg-[var(--color-accent-500)] text-[var(--color-text-inverse)]"
                        : "border-[var(--color-border-default)] bg-[var(--color-surface-raised)]"
                    )}
                    aria-hidden="true"
                  >
                    {checked && (
                      <svg
                        className="h-[var(--space-3)] w-[var(--space-3)]"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        strokeWidth="3"
                      >
                        <path d="m5 12 4 4L19 6" />
                      </svg>
                    )}
                  </span>
                  <Select.ItemText
                    className="flex-1"
                    style={{ font: "var(--text-base) var(--font-body)" }}
                  >
                    {category}
                  </Select.ItemText>
                </Select.Item>
              );
            })}
          </Select.Viewport>
        </Select.Content>
      </Select.Portal>
    </Select.Root>
  );
}