// FeatureRow.tsx — Three concise Wavelength money habits displayed as an aligned feature row. Use on dashboard and goals surfaces to explain core behaviors.
import React from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const featureRowVariants = cva(
  "grid grid-cols-1 overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] md:grid-cols-3"
);

export interface FeatureRowProps
  extends React.HTMLAttributes<HTMLElement> {
  features: Array<{
    title: string;
    description: string;
    icon: string;
  }>;
}

function FeatureIcon({ icon }: { icon: string }) {
  const iconPath =
    icon === "target" ? (
      <>
        <circle cx="12" cy="12" r="8" />
        <circle cx="12" cy="12" r="4" />
        <path d="M12 4V2M20 12h2M12 20v2M4 12H2" />
      </>
    ) : icon === "flame" ? (
      <path d="M12 21c4.2 0 7-2.7 7-6.5 0-3.1-1.7-5.4-4.4-7.4.1 2.1-.7 3.4-1.8 4.2.1-3.3-1.2-6.1-4.4-8.3.2 3.5-2.4 5.3-3.1 8.1C4.4 16.3 7.4 21 12 21Z" />
    ) : (
      <>
        <path d="M4 19V11M10 19V5M16 19v-8M22 19V8" />
        <path d="m4 7 6-4 6 3 6-4" />
      </>
    );

  return (
    <span
      className="inline-flex h-[var(--control-lg)] w-[var(--control-lg)] shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-accent-50)] text-[var(--color-accent-600)]"
      aria-hidden="true"
    >
      <svg
        className="h-[var(--space-6)] w-[var(--space-6)]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        strokeWidth="1.8"
        strokeLinecap="round"
        strokeLinejoin="round"
      >
        {iconPath}
      </svg>
    </span>
  );
}

export default function FeatureRow({
  className,
  features,
  ...props
}: FeatureRowProps) {
  return (
    <section
      className={cn(featureRowVariants(), className)}
      {...props}
    >
      {features.map((feature, index) => (
        <article
          key={`${feature.title}-${index}`}
          className="group flex min-w-0 gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] p-[var(--space-6)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] last:border-b-0 hover:bg-[var(--color-neutral-50)] active:bg-[var(--color-neutral-100)] md:border-b-0 md:border-r md:last:border-r-0"
        >
          <FeatureIcon icon={feature.icon} />
          <div className="min-w-0">
            <h3 className="font-[var(--font-display)] text-[length:var(--text-base)] font-[var(--weight-semibold)] leading-[var(--text-base)] text-[var(--color-text-primary)]">
              {feature.title}
            </h3>
            <p className="mt-[var(--space-2)] font-[var(--font-body)] text-[length:var(--text-base)] font-[var(--weight-regular)] leading-[var(--text-base)] text-[var(--color-text-secondary)]">
              {feature.description}
            </p>
          </div>
        </article>
      ))}
    </section>
  );
}