// NotificationPreferences.tsx — Manage Wavelength alerts for budgets, goals, streaks, and weekly spending recaps.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const notificationPreferencesVariants = cva(
  "w-full rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] font-[var(--font-body)] shadow-[var(--shadow-sm)]",
  {
    variants: {},
  }
);

const preferenceRowVariants = cva(
  "flex min-h-[var(--control-lg)] items-center justify-between gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] py-[var(--space-4)] last:border-b-0",
  {
    variants: {},
  }
);

export interface NotificationPreferencesProps
  extends React.HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof notificationPreferencesVariants> {
  preferences: {
    budgetAlerts: boolean;
    goalMilestones: boolean;
    streakReminders: boolean;
    weeklySummaries: boolean;
  };
  onPreferenceChange: (key: string, value: boolean) => Promise<void>;
  isLoading?: boolean;
}

export default function NotificationPreferences({
  preferences,
  onPreferenceChange,
  isLoading = false,
  className,
  ...props
}: NotificationPreferencesProps) {
  const preferenceItems = [
    {
      key: "budgetAlerts",
      label: "Budget alerts",
      description: "Know when a spending category is getting close to its limit.",
    },
    {
      key: "goalMilestones",
      label: "Goal milestones",
      description: "Get a nudge when your savings progress hits a new milestone.",
    },
    {
      key: "streakReminders",
      label: "Streak reminders",
      description: "Keep your budget streak going with timely reminders.",
    },
    {
      key: "weeklySummaries",
      label: "Weekly summaries",
      description: "See a quick recap of where your money went each week.",
    },
  ] as const;

  const handlePreferenceChange = async (
    key: (typeof preferenceItems)[number]["key"],
    value: boolean
  ) => {
    await onPreferenceChange(key, value);
  };

  return (
    <section
      className={cn(notificationPreferencesVariants(), className)}
      aria-busy={isLoading}
      {...props}
    >
      <div className="border-b border-[var(--color-border-subtle)] px-[var(--space-6)] py-[var(--space-4)]">
        <h2 className="font-[var(--font-display)] text-[length:var(--text-lg)] font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
          Notification preferences
        </h2>
        <p className="mt-[var(--space-1)] font-[var(--font-body)] text-[length:var(--text-sm)] text-[var(--color-text-secondary)]">
          Choose which money moments should reach you.
        </p>
      </div>

      <div className="px-[var(--space-6)]">
        {preferenceItems.map(({ key, label, description }) => {
          const enabled = preferences[key];

          return (
            <div className={cn(preferenceRowVariants())} key={key}>
              <div className="min-w-0">
                <p className="font-[var(--font-body)] text-[length:var(--text-base)] font-[var(--weight-medium)] text-[var(--color-text-primary)]">
                  {label}
                </p>
                <p className="mt-[var(--space-1)] max-w-2xl font-[var(--font-body)] text-[length:var(--text-sm)] text-[var(--color-text-muted)]">
                  {description}
                </p>
              </div>

              <button
                type="button"
                role="switch"
                aria-checked={enabled}
                aria-label={`${label}: ${enabled ? "on" : "off"}`}
                aria-busy={isLoading}
                disabled={isLoading}
                onClick={() => void handlePreferenceChange(key, !enabled)}
                className={cn(
                  "relative inline-flex h-[var(--control-sm)] w-[var(--control-lg)] shrink-0 items-center rounded-[var(--radius-full)] border transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:scale-[0.98] disabled:pointer-events-none disabled:opacity-50",
                  enabled
                    ? "border-[var(--color-accent-500)] bg-[var(--color-accent-500)] hover:border-[var(--color-accent-600)] hover:bg-[var(--color-accent-600)] active:border-[var(--color-accent-700)] active:bg-[var(--color-accent-700)]"
                    : "border-[var(--color-border-default)] bg-[var(--color-neutral-100)] hover:bg-[var(--color-neutral-200)] active:bg-[var(--color-neutral-300)]"
                )}
              >
                {isLoading ? (
                  <svg
                    className="absolute left-1/2 h-[var(--space-4)] w-[var(--space-4)] -translate-x-1/2 animate-spin text-[var(--color-text-secondary)]"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <circle
                      className="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      strokeWidth="4"
                    />
                    <path
                      className="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                    />
                  </svg>
                ) : (
                  <span
                    aria-hidden="true"
                    className={cn(
                      "block h-[var(--space-4)] w-[var(--space-4)] rounded-[var(--radius-full)] bg-[var(--color-surface-raised)] transition-transform duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
                      enabled
                        ? "translate-x-[var(--space-4)]"
                        : "translate-x-[var(--space-1)]"
                    )}
                  />
                )}
              </button>
            </div>
          );
        })}
      </div>
    </section>
  );
}