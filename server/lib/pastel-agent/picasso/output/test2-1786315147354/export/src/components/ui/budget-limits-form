// BudgetLimitsForm.tsx — Monthly category budget editor for updating Wavelength spending limits. Use in dashboard budget settings.
import { useEffect, useState, type FormEvent, type ReactNode } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const budgetLimitsFormVariants = cva(
  "w-full rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] shadow-[var(--shadow-md)]",
  {
    variants: {},
  }
);

const saveButtonVariants = cva(
  "inline-flex h-[var(--control-md)] items-center justify-center gap-[var(--space-2)] rounded-[var(--radius-md)] px-[var(--space-4)] font-[var(--font-body)] text-base font-[var(--weight-medium)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      variant: {
        primary:
          "bg-[var(--color-accent-500)] text-[var(--color-text-inverse)] hover:bg-[var(--color-accent-600)] active:bg-[var(--color-accent-700)]",
      },
    },
    defaultVariants: {
      variant: "primary",
    },
  }
);

export interface BudgetCategory {
  id: string;
  name: string;
  currentLimit: number;
  icon?: ReactNode;
}

export interface BudgetLimitsFormProps
  extends Omit<React.FormHTMLAttributes<HTMLFormElement>, "onSubmit">,
    VariantProps<typeof budgetLimitsFormVariants> {
  categories: BudgetCategory[];
  onSave: (budgets: Record<string, number>) => Promise<void>;
  isLoading?: boolean;
  error?: string;
}

export default function BudgetLimitsForm({
  categories,
  onSave,
  isLoading = false,
  error,
  className,
  ...props
}: BudgetLimitsFormProps) {
  const [budgets, setBudgets] = useState<Record<string, string>>(() =>
    Object.fromEntries(
      categories.map((category) => [category.id, String(category.currentLimit)])
    )
  );

  useEffect(() => {
    setBudgets(
      Object.fromEntries(
        categories.map((category) => [
          category.id,
          String(category.currentLimit),
        ])
      )
    );
  }, [categories]);

  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();

    const parsedBudgets = Object.fromEntries(
      categories.map((category) => [
        category.id,
        Number.parseFloat(budgets[category.id] || "0"),
      ])
    );

    await onSave(parsedBudgets);
  };

  return (
    <form
      className={cn(budgetLimitsFormVariants(), className)}
      onSubmit={handleSubmit}
      aria-busy={isLoading}
      {...props}
    >
      <div className="mb-[var(--space-6)]">
        <p className="font-[var(--font-display)] text-[var(--text-xl)] font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
          Monthly limits
        </p>
        <p className="mt-[var(--space-1)] font-[var(--font-body)] text-[var(--text-base)] text-[var(--color-text-secondary)]">
          Keep each spending lane on track before the month gets away from
          you.
        </p>
      </div>

      <div className="border-t border-[var(--color-border-subtle)]">
        {categories.map((category) => {
          const inputId = `budget-limit-${category.id}`;

          return (
            <div
              key={category.id}
              className="flex min-h-[var(--control-lg)] items-center justify-between gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] py-[var(--space-4)] last:border-b-0"
            >
              <label
                htmlFor={inputId}
                className="flex min-w-0 items-center gap-[var(--space-3)] font-[var(--font-body)] text-[var(--text-base)] font-[var(--weight-medium)] text-[var(--color-text-primary)]"
              >
                {category.icon && (
                  <span
                    className="flex h-[var(--control-sm)] w-[var(--control-sm)] shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-accent-50)] text-[var(--color-accent-600)]"
                    aria-hidden="true"
                  >
                    {category.icon}
                  </span>
                )}
                <span className="truncate">{category.name}</span>
              </label>

              <div className="relative shrink-0">
                <span
                  className="pointer-events-none absolute inset-y-0 left-[var(--space-3)] flex items-center font-[var(--font-body)] text-[var(--text-base)] text-[var(--color-text-muted)]"
                  aria-hidden="true"
                >
                  $
                </span>
                <input
                  id={inputId}
                  name={category.id}
                  type="number"
                  min="0"
                  step="0.01"
                  inputMode="decimal"
                  value={budgets[category.id] ?? ""}
                  onChange={(event) =>
                    setBudgets((current) => ({
                      ...current,
                      [category.id]: event.target.value,
                    }))
                  }
                  disabled={isLoading}
                  aria-describedby={error ? "budget-limits-error" : undefined}
                  className="h-[var(--control-md)] w-[var(--space-24)] rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-background)] pl-[var(--space-6)] pr-[var(--space-3)] text-right font-[var(--font-mono)] text-[var(--text-base)] tabular-nums text-[var(--color-text-primary)] outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-neutral-500)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:border-[var(--color-accent-500)] disabled:pointer-events-none disabled:cursor-not-allowed disabled:opacity-50"
                />
              </div>
            </div>
          );
        })}
      </div>

      {error && (
        <p
          id="budget-limits-error"
          role="alert"
          className="mt-[var(--space-4)] rounded-[var(--radius-md)] border border-[var(--color-danger-500)] bg-[var(--color-danger-50)] px-[var(--space-3)] py-[var(--space-2)] font-[var(--font-body)] text-[var(--text-sm)] text-[var(--color-danger-900)]"
        >
          {error}
        </p>
      )}

      <div className="mt-[var(--space-6)] flex justify-end">
        <button
          type="submit"
          className={cn(saveButtonVariants({ variant: "primary" }))}
          disabled={isLoading}
          aria-busy={isLoading}
        >
          {isLoading && (
            <svg
              className="animate-spin [height:var(--space-4)] [width:var(--space-4)]"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                className="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                strokeWidth="4"
              />
              <path
                className="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
              />
            </svg>
          )}
          Save budget limits
        </button>
      </div>
    </form>
  );
}