// Pagination.tsx — Page navigation controls for moving through Wavelength spending and budget tables. Use at the bottom of paginated data views.
import type { HTMLAttributes } from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const paginationVariants = cva(
  "flex items-center justify-between gap-[var(--space-4)] border-t border-[var(--color-border-subtle)] py-[var(--space-3)] font-[var(--font-body)] text-sm text-[var(--color-text-secondary)]"
);

export interface PaginationProps extends HTMLAttributes<HTMLElement> {
  currentPage: number;
  totalPages: number;
  onPageChange: (page: number) => void;
  pageSize?: number;
  loading?: boolean;
  disabled?: boolean;
}

export default function Pagination({
  className,
  currentPage,
  totalPages,
  onPageChange,
  pageSize,
  loading = false,
  disabled = false,
  ...props
}: PaginationProps) {
  const safeTotalPages = Math.max(1, totalPages);
  const safeCurrentPage = Math.min(
    Math.max(1, currentPage),
    safeTotalPages
  );
  const isPreviousDisabled = disabled || loading || safeCurrentPage <= 1;
  const isNextDisabled =
    disabled || loading || safeCurrentPage >= safeTotalPages;

  return (
    <nav
      className={cn(paginationVariants(), className)}
      aria-label={
        pageSize
          ? `Page navigation, ${pageSize} items per page`
          : "Page navigation"
      }
      aria-busy={loading}
      {...props}
    >
      <div className="flex items-center gap-[var(--space-2)]">
        {loading && (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}
        <span aria-live="polite">
          Page {safeCurrentPage} of {safeTotalPages}
        </span>
      </div>

      <div className="flex items-center gap-[var(--space-1)]">
        <button
          type="button"
          className="inline-flex h-[var(--control-sm)] items-center justify-center rounded-[var(--radius-md)] border border-[var(--color-border-default)] px-[var(--space-3)] font-[var(--weight-medium)] text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
          onClick={() => onPageChange(safeCurrentPage - 1)}
          disabled={isPreviousDisabled}
          aria-label="Go to previous page"
        >
          Previous
        </button>

        {Array.from({ length: safeTotalPages }, (_, index) => {
          const page = index + 1;
          const isCurrent = page === safeCurrentPage;

          return (
            <button
              key={page}
              type="button"
              className={cn(
                "inline-flex h-[var(--control-sm)] min-w-[var(--control-sm)] items-center justify-center rounded-[var(--radius-md)] px-[var(--space-2)] font-[var(--weight-medium)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
                isCurrent
                  ? "bg-[var(--color-accent-500)] text-[var(--color-text-inverse)] hover:bg-[var(--color-accent-600)] active:bg-[var(--color-accent-700)]"
                  : "text-[var(--color-text-secondary)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)]"
              )}
              onClick={() => onPageChange(page)}
              disabled={disabled || loading || isCurrent}
              aria-current={isCurrent ? "page" : undefined}
              aria-label={`Go to page ${page}`}
            >
              {page}
            </button>
          );
        })}

        <button
          type="button"
          className="inline-flex h-[var(--control-sm)] items-center justify-center rounded-[var(--radius-md)] border border-[var(--color-border-default)] px-[var(--space-3)] font-[var(--weight-medium)] text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
          onClick={() => onPageChange(safeCurrentPage + 1)}
          disabled={isNextDisabled}
          aria-label="Go to next page"
        >
          Next
        </button>
      </div>
    </nav>
  );
}