// ProfileSection.tsx — Displays a Wavelength user's identity and profile editing action. Use in account settings and dashboard account areas.
import { cva, type VariantProps } from "class-variance-authority";
import type { HTMLAttributes } from "react";
import { cn } from "../lib/cn";

const profileSectionVariants = cva(
  "flex items-center justify-between gap-[var(--space-4)] rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] font-[var(--font-body)] shadow-[var(--shadow-sm)] transition-colors duration-[var(--duration-base)] ease-[var(--easing-standard)]",
  {
    variants: {},
  }
);

const editProfileButtonVariants = cva(
  "inline-flex h-[var(--control-md)] shrink-0 items-center justify-center gap-[var(--space-2)] rounded-[var(--radius-md)] border border-[var(--color-border-default)] px-[var(--space-4)] font-[var(--font-body)] text-base font-[var(--weight-medium)] text-[var(--color-text-primary)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {},
  }
);

export interface ProfileSectionProps
  extends HTMLAttributes<HTMLElement>,
    VariantProps<typeof profileSectionVariants> {
  user: {
    name: string;
    email: string;
    avatarUrl?: string;
  };
  onEditClick?: () => void;
  isLoading?: boolean;
}

function getInitials(name: string) {
  return name
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((part) => part.charAt(0).toUpperCase())
    .join("");
}

export default function ProfileSection({
  className,
  user,
  onEditClick,
  isLoading = false,
  ...props
}: ProfileSectionProps) {
  const initials = getInitials(user.name);

  return (
    <section
      className={cn(profileSectionVariants(), className)}
      aria-busy={isLoading}
      aria-label={`${user.name} profile`}
      {...props}
    >
      <div className="flex min-w-0 items-center gap-[var(--space-4)]">
        <div
          className="flex h-[var(--control-lg)] w-[var(--control-lg)] shrink-0 items-center justify-center overflow-hidden rounded-[var(--radius-full)] bg-[var(--color-accent-50)] font-[var(--font-display)] text-lg font-[var(--weight-semibold)] text-[var(--color-accent-500)]"
          aria-hidden={isLoading}
        >
          {isLoading ? (
            <span className="h-[var(--space-6)] w-[var(--space-6)] rounded-[var(--radius-full)] bg-[var(--color-neutral-200)] opacity-60" />
          ) : user.avatarUrl ? (
            <img
              src={user.avatarUrl}
              alt={`${user.name} avatar`}
              className="h-full w-full object-cover"
            />
          ) : (
            initials
          )}
        </div>

        <div className="min-w-0">
          {isLoading ? (
            <div className="flex flex-col gap-[var(--space-2)]" aria-hidden="true">
              <span className="block h-[var(--space-4)] w-[var(--space-16)] rounded-[var(--radius-sm)] bg-[var(--color-neutral-200)] opacity-60" />
              <span className="block h-[var(--space-4)] w-[var(--space-24)] rounded-[var(--radius-sm)] bg-[var(--color-neutral-200)] opacity-60" />
            </div>
          ) : (
            <>
              <p className="truncate font-[var(--font-display)] text-lg font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
                {user.name}
              </p>
              <p className="truncate text-base font-[var(--weight-regular)] text-[var(--color-text-secondary)]">
                {user.email}
              </p>
            </>
          )}
        </div>
      </div>

      <button
        type="button"
        className={cn(editProfileButtonVariants())}
        onClick={onEditClick}
        disabled={isLoading || !onEditClick}
        aria-busy={isLoading}
        aria-label={`Edit ${user.name} profile`}
      >
        {isLoading && (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        )}
        Edit profile
      </button>
    </section>
  );
}