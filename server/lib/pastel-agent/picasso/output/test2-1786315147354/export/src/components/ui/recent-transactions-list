// RecentTransactionsList.tsx — Displays the latest money activity in a compact table for quick transaction review.
import * as React from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const recentTransactionsListVariants = cva(
  "overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] font-[var(--font-body)] text-[var(--color-text-primary)]"
);

export interface RecentTransaction {
  id: string;
  date: string;
  merchant: string;
  category: string;
  amount: number;
  type: "expense" | "income";
}

export interface RecentTransactionsListProps
  extends React.HTMLAttributes<HTMLDivElement> {
  transactions: RecentTransaction[];
  onTransactionClick?: (transactionId: string) => void;
  isLoading?: boolean;
}

export default function RecentTransactionsList({
  transactions,
  onTransactionClick,
  isLoading = false,
  className,
  ...props
}: RecentTransactionsListProps) {
  const handleTransactionKeyDown = (
    event: React.KeyboardEvent<HTMLTableRowElement>,
    transactionId: string
  ) => {
    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      onTransactionClick?.(transactionId);
    }
  };

  const formatAmount = (transaction: RecentTransaction) => {
    const formattedAmount = new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: "USD",
    }).format(Math.abs(transaction.amount));

    return transaction.type === "income"
      ? `+${formattedAmount}`
      : `-${formattedAmount}`;
  };

  return (
    <div
      className={cn(recentTransactionsListVariants(), className)}
      aria-busy={isLoading}
      {...props}
    >
      <table className="w-full border-collapse" aria-label="Recent transactions">
        <thead className="border-b border-[var(--color-border-subtle)] bg-[var(--color-neutral-50)]">
          <tr className="text-left text-xs font-[var(--weight-medium)] text-[var(--color-text-muted)]">
            <th scope="col" className="px-[var(--space-4)] py-[var(--space-3)]">
              Date
            </th>
            <th scope="col" className="px-[var(--space-4)] py-[var(--space-3)]">
              Merchant
            </th>
            <th scope="col" className="px-[var(--space-4)] py-[var(--space-3)]">
              Category
            </th>
            <th
              scope="col"
              className="px-[var(--space-4)] py-[var(--space-3)] text-right"
            >
              Amount
            </th>
          </tr>
        </thead>

        <tbody className="divide-y divide-[var(--color-border-subtle)]">
          {isLoading ? (
            <tr>
              <td
                colSpan={4}
                className="px-[var(--space-4)] py-[var(--space-8)] text-center text-sm text-[var(--color-text-muted)]"
              >
                <span className="inline-flex items-center gap-[var(--space-2)]">
                  <svg
                    className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <circle
                      className="opacity-25"
                      cx="12"
                      cy="12"
                      r="10"
                      stroke="currentColor"
                      strokeWidth="4"
                    />
                    <path
                      className="opacity-75"
                      fill="currentColor"
                      d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                    />
                  </svg>
                  Loading transactions
                </span>
              </td>
            </tr>
          ) : transactions.length === 0 ? (
            <tr>
              <td
                colSpan={4}
                className="px-[var(--space-4)] py-[var(--space-8)] text-center text-sm text-[var(--color-text-muted)]"
              >
                No recent transactions
              </td>
            </tr>
          ) : (
            transactions.map((transaction) => {
              const isInteractive = Boolean(onTransactionClick);

              return (
                <tr
                  key={transaction.id}
                  tabIndex={isInteractive ? 0 : undefined}
                  role={isInteractive ? "button" : undefined}
                  aria-label={
                    isInteractive
                      ? `View transaction from ${transaction.merchant}`
                      : undefined
                  }
                  aria-disabled={isLoading ? true : undefined}
                  onClick={
                    isInteractive
                      ? () => onTransactionClick(transaction.id)
                      : undefined
                  }
                  onKeyDown={
                    isInteractive
                      ? (event) =>
                          handleTransactionKeyDown(event, transaction.id)
                      : undefined
                  }
                  className={cn(
                    "transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
                    isInteractive &&
                      "cursor-pointer hover:bg-[var(--color-neutral-50)] active:bg-[var(--color-neutral-100)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-inset",
                    isLoading && "pointer-events-none opacity-50"
                  )}
                >
                  <td className="whitespace-nowrap px-[var(--space-4)] py-[var(--space-4)] text-sm text-[var(--color-text-secondary)]">
                    {transaction.date}
                  </td>
                  <td className="px-[var(--space-4)] py-[var(--space-4)]">
                    <span className="font-[var(--weight-medium)]">
                      {transaction.merchant}
                    </span>
                  </td>
                  <td className="px-[var(--space-4)] py-[var(--space-4)] text-sm text-[var(--color-text-muted)]">
                    {transaction.category}
                  </td>
                  <td
                    className={cn(
                      "whitespace-nowrap px-[var(--space-4)] py-[var(--space-4)] text-right font-[var(--font-mono)] text-sm font-[var(--weight-medium)] tabular-nums",
                      transaction.type === "income"
                        ? "text-[var(--color-success-500)]"
                        : "text-[var(--color-text-primary)]"
                    )}
                  >
                    {formatAmount(transaction)}
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
  );
}