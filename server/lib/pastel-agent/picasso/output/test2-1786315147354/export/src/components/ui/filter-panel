// FilterPanel.tsx — Collapsible transaction filters for narrowing Wavelength spending activity by date, category, amount, and transaction type.
import { useEffect, useId, useState } from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const filterPanelVariants = cva(
  "w-full rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] font-[var(--font-body)] text-[var(--color-text-primary)]"
);

export interface FilterPanelProps {
  onFilterChange: (filters: {
    dateRange?: [string, string];
    categories?: string[];
    amountRange?: [number, number];
    type?: "income" | "expense" | "all";
  }) => void;
  availableCategories: string[];
  isExpanded?: boolean;
  amountBounds?: [number, number];
  loading?: boolean;
  disabled?: boolean;
  className?: string;
}

export default function FilterPanel({
  onFilterChange,
  availableCategories,
  isExpanded = true,
  amountBounds = [0, 10000],
  loading = false,
  disabled = false,
  className,
}: FilterPanelProps) {
  const panelId = useId();
  const [expanded, setExpanded] = useState(isExpanded);
  const [startDate, setStartDate] = useState("");
  const [endDate, setEndDate] = useState("");
  const [categories, setCategories] = useState<string[]>([]);
  const [amountRange, setAmountRange] = useState<[number, number]>(amountBounds);
  const [type, setType] = useState<"income" | "expense" | "all">("all");

  useEffect(() => {
    setExpanded(isExpanded);
  }, [isExpanded]);

  useEffect(() => {
    setAmountRange(amountBounds);
  }, [amountBounds]);

  const emitFilters = (next: {
    dateRange?: [string, string];
    categories?: string[];
    amountRange?: [number, number];
    type?: "income" | "expense" | "all";
  }) => {
    onFilterChange(next);
  };

  const handleStartDateChange = (value: string) => {
    setStartDate(value);
    emitFilters({
      dateRange: [value, endDate],
      categories: categories.length ? categories : undefined,
      amountRange,
      type,
    });
  };

  const handleEndDateChange = (value: string) => {
    setEndDate(value);
    emitFilters({
      dateRange: [startDate, value],
      categories: categories.length ? categories : undefined,
      amountRange,
      type,
    });
  };

  const handleCategoryChange = (category: string, checked: boolean) => {
    const nextCategories = checked
      ? [...categories, category]
      : categories.filter((item) => item !== category);

    setCategories(nextCategories);
    emitFilters({
      dateRange: startDate || endDate ? [startDate, endDate] : undefined,
      categories: nextCategories.length ? nextCategories : undefined,
      amountRange,
      type,
    });
  };

  const handleAmountChange = (index: 0 | 1, value: number) => {
    const nextRange: [number, number] =
      index === 0
        ? [Math.min(value, amountRange[1]), amountRange[1]]
        : [amountRange[0], Math.max(value, amountRange[0])];

    setAmountRange(nextRange);
    emitFilters({
      dateRange: startDate || endDate ? [startDate, endDate] : undefined,
      categories: categories.length ? categories : undefined,
      amountRange: nextRange,
      type,
    });
  };

  const handleTypeChange = (value: "income" | "expense" | "all") => {
    setType(value);
    emitFilters({
      dateRange: startDate || endDate ? [startDate, endDate] : undefined,
      categories: categories.length ? categories : undefined,
      amountRange,
      type: value,
    });
  };

  const controlClasses =
    "h-[var(--control-md)] rounded-[var(--radius-sm)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] px-[var(--space-3)] font-[var(--font-body)] text-[length:var(--text-base)] text-[var(--color-text-primary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-color-accent-500)] active:border-[var(--color-accent-600)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50";

  return (
    <section
      className={cn(filterPanelVariants(), className)}
      aria-busy={loading}
      aria-labelledby={`${panelId}-title`}
    >
      <button
        type="button"
        className="flex h-[var(--control-lg)] w-full items-center justify-between rounded-[var(--radius-lg)] px-[var(--space-4)] text-left font-[var(--weight-semibold)] text-[var(--color-text-primary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
        aria-expanded={expanded}
        aria-controls={panelId}
        disabled={disabled || loading}
        onClick={() => setExpanded((value) => !value)}
      >
        <span id={`${panelId}-title`}>Filter transactions</span>
        <span className="flex items-center gap-[var(--space-2)] text-[length:var(--text-sm)] font-[var(--weight-medium)] text-[var(--color-text-muted)]">
          {loading && (
            <svg
              className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
            >
              <circle
                cx="12"
                cy="12"
                r="9"
                stroke="currentColor"
                strokeWidth="3"
                className="opacity-25"
              />
              <path
                d="M21 12a9 9 0 0 0-9-9"
                stroke="currentColor"
                strokeWidth="3"
                strokeLinecap="round"
              />
            </svg>
          )}
          <span aria-hidden="true">{expanded ? "Hide" : "Show"}</span>
          <svg
            className={cn(
              "h-[var(--space-4)] w-[var(--space-4)] transition-transform duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
              expanded && "rotate-180"
            )}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="2"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </span>
      </button>

      {expanded && (
        <fieldset
          id={panelId}
          disabled={disabled || loading}
          className="border-0 border-t border-[var(--color-border-subtle)] p-[var(--space-4)] disabled:pointer-events-none disabled:opacity-50"
        >
          <legend className="sr-only">Transaction filters</legend>

          <div className="grid gap-[var(--space-6)]">
            <div>
              <h3 className="mb-[var(--space-3)] font-[var(--weight-semibold)] text-[length:var(--text-sm)] text-[var(--color-text-primary)]">
                Date range
              </h3>
              <div className="grid grid-cols-1 gap-[var(--space-3)] sm:grid-cols-2">
                <label
                  className="grid gap-[var(--space-1)] text-[length:var(--text-sm)] font-[var(--weight-medium)] text-[var(--color-text-secondary)]"
                  htmlFor={`${panelId}-start-date`}
                >
                  From
                  <input
                    id={`${panelId}-start-date`}
                    type="date"
                    value={startDate}
                    onChange={(event) => handleStartDateChange(event.target.value)}
                    className={controlClasses}
                  />
                </label>
                <label
                  className="grid gap-[var(--space-1)] text-[length:var(--text-sm)] font-[var(--weight-medium)] text-[var(--color-text-secondary)]"
                  htmlFor={`${panelId}-end-date`}
                >
                  To
                  <input
                    id={`${panelId}-end-date`}
                    type="date"
                    value={endDate}
                    onChange={(event) => handleEndDateChange(event.target.value)}
                    className={controlClasses}
                  />
                </label>
              </div>
            </div>

            <div>
              <h3 className="mb-[var(--space-3)] font-[var(--weight-semibold)] text-[length:var(--text-sm)] text-[var(--color-text-primary)]">
                Categories
              </h3>
              <div className="grid grid-cols-1 divide-y divide-[var(--color-border-subtle)]">
                {availableCategories.map((category) => {
                  const categoryId = `${panelId}-${category
                    .toLowerCase()
                    .replace(/[^a-z0-9]+/g, "-")}`;

                  return (
                    <label
                      key={category}
                      htmlFor={categoryId}
                      className="flex min-h-[var(--control-md)] cursor-pointer items-center gap-[var(--space-3)] py-[var(--space-2)] text-[length:var(--text-base)] text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:text-[var(--color-text-primary)] active:text-[var(--color-accent-600)]"
                    >
                      <input
                        id={categoryId}
                        type="checkbox"
                        checked={categories.includes(category)}
                        onChange={(event) =>
                          handleCategoryChange(category, event.target.checked)
                        }
                        className="h-[var(--space-4)] w-[var(--space-4)] accent-[var(--color-accent-500)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2"
                      />
                      <span>{category}</span>
                    </label>
                  );
                })}
              </div>
            </div>

            <div>
              <div className="mb-[var(--space-3)] flex items-baseline justify-between gap-[var(--space-3)]">
                <h3 className="font-[var(--weight-semibold)] text-[length:var(--text-sm)] text-[var(--color-text-primary)]">
                  Amount range
                </h3>
                <span className="font-[var(--font-mono)] text-[length:var(--text-sm)] tabular-nums text-[var(--color-text-muted)]">
                  ${amountRange[0]} – ${amountRange[1]}
                </span>
              </div>
              <div className="grid gap-[var(--space-3)]">
                {[0, 1].map((index) => (
                  <label
                    key={index}
                    className="grid gap-[var(--space-1)] text-[length:var(--text-sm)] font-[var(--weight-medium)] text-[var(--color-text-secondary)]"
                    htmlFor={`${panelId}-amount-${index}`}
                  >
                    {index === 0 ? "Minimum" : "Maximum"}
                    <input
                      id={`${panelId}-amount-${index}`}
                      type="range"
                      min={amountBounds[0]}
                      max={amountBounds[1]}
                      step={1}
                      value={amountRange[index as 0 | 1]}
                      onChange={(event) =>
                        handleAmountChange(
                          index as 0 | 1,
                          Number(event.target.value)
                        )
                      }
                      className="h-[var(--control-sm)] w-full cursor-pointer accent-[var(--color-accent-500)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
                    />
                  </label>
                ))}
              </div>
            </div>

            <div>
              <h3 className="mb-[var(--space-3)] font-[var(--weight-semibold)] text-[length:var(--text-sm)] text-[var(--color-text-primary)]">
                Transaction type
              </h3>
              <div className="grid gap-[var(--space-2)] sm:grid-cols-3">
                {(["all", "income", "expense"] as const).map((option) => {
                  const optionId = `${panelId}-type-${option}`;

                  return (
                    <label
                      key={option}
                      htmlFor={optionId}
                      className="flex h-[var(--control-md)] cursor-pointer items-center gap-[var(--space-2)] rounded-[var(--radius-sm)] border border-[var(--color-border-default)] px-[var(--space-3)] text-[length:var(--text-sm)] font-[var(--weight-medium)] capitalize text-[var(--color-text-secondary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-accent-500)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)] focus-within:ring-2 focus-within:ring-[var(--color-border-focus)] focus-within:ring-offset-2"
                    >
                      <input
                        id={optionId}
                        type="radio"
                        name={`${panelId}-type`}
                        value={option}
                        checked={type === option}
                        onChange={() => handleTypeChange(option)}
                        className="accent-[var(--color-accent-500)] focus-visible:outline-none"
                      />
                      <span>{option}</span>
                    </label>
                  );
                })}
              </div>
            </div>
          </div>
        </fieldset>
      )}
    </section>
  );
}