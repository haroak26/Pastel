// TransactionHeader.tsx — Displays a transaction’s merchant, amount, date, and return action. Use at the top of a transaction detail view.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const transactionHeaderVariants = cva(
  "rounded-[var(--radius-xl)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] shadow-[var(--shadow-sm)]",
  {
    variants: {},
  }
);

export interface TransactionHeaderProps
  extends React.HTMLAttributes<HTMLElement>,
    VariantProps<typeof transactionHeaderVariants> {
  transaction: {
    merchant: string;
    amount: number;
    date: string;
    type: "expense" | "income";
  };
  onBack: () => void;
  currencyCode?: string;
  loading?: boolean;
}

export default function TransactionHeader({
  className,
  transaction,
  onBack,
  currencyCode = "USD",
  loading = false,
  ...props
}: TransactionHeaderProps) {
  const formattedAmount = new Intl.NumberFormat(undefined, {
    style: "currency",
    currency: currencyCode,
    minimumFractionDigits: 2,
  }).format(Math.abs(transaction.amount));

  const isIncome = transaction.type === "income";
  const amountPrefix = isIncome ? "+" : "−";

  return (
    <header
      className={cn(transactionHeaderVariants(), className)}
      {...props}
    >
      <div className="flex items-start justify-between gap-[var(--space-4)]">
        <button
          type="button"
          className={cn(
            "inline-flex h-[var(--control-md)] w-[var(--control-md)] shrink-0 items-center justify-center rounded-[var(--radius-md)] border border-[var(--color-border-default)] text-[var(--color-text-secondary)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
            loading && "pointer-events-none"
          )}
          onClick={onBack}
          disabled={loading}
          aria-label="Back to transactions"
          aria-busy={loading}
        >
          {loading ? (
            <svg
              className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                className="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                strokeWidth="4"
              />
              <path
                className="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
              />
            </svg>
          ) : (
            <svg
              className="h-[var(--space-4)] w-[var(--space-4)]"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
              strokeLinecap="round"
              strokeLinejoin="round"
              aria-hidden="true"
            >
              <path d="m15 18-6-6 6-6" />
            </svg>
          )}
        </button>

        <div className="min-w-0 flex-1 text-right">
          <p className="font-[var(--font-body)] text-[length:var(--text-xs)] font-[var(--weight-medium)] uppercase tracking-[0.08em] text-[var(--color-text-muted)]">
            {isIncome ? "Income" : "Expense"}
          </p>
          <h1 className="mt-[var(--space-1)] truncate font-[var(--font-display)] text-[length:var(--text-xl)] font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
            {transaction.merchant}
          </h1>
        </div>
      </div>

      <div className="mt-[var(--space-8)]">
        <p
          className={cn(
            "font-[var(--font-display)] text-[length:var(--text-4xl)] font-[var(--weight-bold)] tabular-nums tracking-[-0.04em]",
            isIncome
              ? "text-[var(--color-success-500)]"
              : "text-[var(--color-text-primary)]"
          )}
          aria-label={`${isIncome ? "Income" : "Expense"} ${formattedAmount}`}
        >
          {amountPrefix}
          {formattedAmount}
        </p>
        <time className="mt-[var(--space-2)] block font-[var(--font-body)] text-[length:var(--text-base)] text-[var(--color-text-secondary)]">
          {transaction.date}
        </time>
      </div>
    </header>
  );
}