// TransactionDetails.tsx — Displays the category, type, payment method, description, and tags for a Wavelength transaction.
import type { HTMLAttributes } from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const transactionDetailsVariants = cva(
  "rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] font-[var(--font-body)]"
);

const transactionTypeVariants = cva(
  "inline-flex items-center rounded-[var(--radius-full)] px-[var(--space-3)] py-[var(--space-1)] text-[var(--text-xs)] font-[var(--weight-semibold)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
  {
    variants: {
      type: {
        expense:
          "bg-[var(--color-warning-50)] text-[var(--color-warning-900)]",
        income:
          "bg-[var(--color-accent-50)] text-[var(--color-accent-900)]",
      },
    },
  }
);

export interface TransactionDetailsProps
  extends HTMLAttributes<HTMLElement> {
  transaction: {
    category: string;
    type: "expense" | "income";
    paymentMethod: string;
    description?: string;
    tags?: string[];
  };
}

export default function TransactionDetails({
  className,
  transaction,
  ...props
}: TransactionDetailsProps) {
  const rows = [
    {
      label: "Category",
      value: (
        <span className="text-[var(--text-base)] text-[var(--color-text-primary)]">
          {transaction.category}
        </span>
      ),
    },
    {
      label: "Type",
      value: (
        <span className={cn(transactionTypeVariants({ type: transaction.type }))}>
          {transaction.type}
        </span>
      ),
    },
    {
      label: "Payment method",
      value: (
        <span className="text-[var(--text-base)] text-[var(--color-text-primary)]">
          {transaction.paymentMethod}
        </span>
      ),
    },
    ...(transaction.description
      ? [
          {
            label: "Description",
            value: (
              <span className="text-[var(--text-base)] leading-[1.5] text-[var(--color-text-primary)]">
                {transaction.description}
              </span>
            ),
          },
        ]
      : []),
    ...(transaction.tags && transaction.tags.length > 0
      ? [
          {
            label: "Tags",
            value: (
              <ul
                className="flex flex-wrap gap-[var(--space-2)]"
                aria-label="Transaction tags"
              >
                {transaction.tags.map((tag) => (
                  <li
                    key={tag}
                    className="rounded-[var(--radius-sm)] bg-[var(--color-neutral-100)] px-[var(--space-2)] py-[var(--space-1)] text-[var(--text-sm)] text-[var(--color-text-secondary)]"
                  >
                    {tag}
                  </li>
                ))}
              </ul>
            ),
          },
        ]
      : []),
  ];

  return (
    <section
      className={cn(transactionDetailsVariants(), className)}
      aria-label="Transaction details"
      {...props}
    >
      <dl>
        {rows.map((row) => (
          <div
            key={row.label}
            className="grid grid-cols-[minmax(0,1fr)_minmax(0,2fr)] items-start gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] py-[var(--space-4)] first:pt-[var(--space-0)] last:border-b-0 last:pb-[var(--space-0)]"
          >
            <dt className="text-[var(--text-sm)] font-[var(--weight-medium)] text-[var(--color-text-muted)]">
              {row.label}
            </dt>
            <dd className="min-w-0">{row.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  );
}