// ContributionHistory.tsx — Displays a goal’s contribution timeline with dates, amounts, and saving sources.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const contributionHistoryVariants = cva(
  "overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] shadow-[var(--shadow-sm)]",
  {
    variants: {},
    defaultVariants: {},
  }
);

export interface ContributionHistoryProps
  extends React.HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof contributionHistoryVariants> {
  contributions: Array<{
    id: string;
    date: string;
    amount: number;
    source: "manual" | "auto-save";
    description?: string;
  }>;
  isLoading?: boolean;
}

const currencyFormatter = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
});

export default function ContributionHistory({
  contributions,
  isLoading = false,
  className,
  ...props
}: ContributionHistoryProps) {
  return (
    <section
      className={cn(contributionHistoryVariants(), className)}
      aria-busy={isLoading}
      {...props}
    >
      <div className="border-b border-[var(--color-border-subtle)] px-[var(--space-6)] py-[var(--space-4)]">
        <h2
          className="font-[var(--font-display)] text-[var(--color-text-primary)]"
          style={{
            fontSize: "var(--text-lg)",
            fontWeight: "var(--weight-semibold)",
            lineHeight: "28px",
          }}
        >
          Contribution history
        </h2>
      </div>

      <div className="overflow-x-auto">
        <table className="w-full border-collapse text-left font-[var(--font-body)]">
          <caption className="sr-only">
            Contributions made toward this savings goal
          </caption>
          <thead className="bg-[var(--color-neutral-50)]">
            <tr className="border-b border-[var(--color-border-subtle)]">
              <th
                scope="col"
                className="px-[var(--space-6)] py-[var(--space-3)] text-[var(--color-text-muted)]"
                style={{
                  fontSize: "var(--text-sm)",
                  fontWeight: "var(--weight-medium)",
                  lineHeight: "20px",
                }}
              >
                Date
              </th>
              <th
                scope="col"
                className="px-[var(--space-6)] py-[var(--space-3)] text-right text-[var(--color-text-muted)]"
                style={{
                  fontSize: "var(--text-sm)",
                  fontWeight: "var(--weight-medium)",
                  lineHeight: "20px",
                }}
              >
                Amount
              </th>
              <th
                scope="col"
                className="px-[var(--space-6)] py-[var(--space-3)] text-[var(--color-text-muted)]"
                style={{
                  fontSize: "var(--text-sm)",
                  fontWeight: "var(--weight-medium)",
                  lineHeight: "20px",
                }}
              >
                Source
              </th>
              <th
                scope="col"
                className="px-[var(--space-6)] py-[var(--space-3)] text-[var(--color-text-muted)]"
                style={{
                  fontSize: "var(--text-sm)",
                  fontWeight: "var(--weight-medium)",
                  lineHeight: "20px",
                }}
              >
                Note
              </th>
            </tr>
          </thead>

          <tbody>
            {isLoading ? (
              <tr>
                <td
                  colSpan={4}
                  className="px-[var(--space-6)] py-[var(--space-8)] text-center text-[var(--color-text-secondary)]"
                  style={{
                    fontSize: "var(--text-base)",
                    lineHeight: "24px",
                  }}
                >
                  <span className="inline-flex items-center gap-[var(--space-2)]">
                    <svg
                      className="h-[var(--space-4)] w-[var(--space-4)] animate-[spin_var(--duration-slow)_var(--easing-standard)_infinite]"
                      xmlns="http://www.w3.org/2000/svg"
                      fill="none"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <circle
                        className="opacity-25"
                        cx="12"
                        cy="12"
                        r="10"
                        stroke="currentColor"
                        strokeWidth="4"
                      />
                      <path
                        className="opacity-75"
                        fill="currentColor"
                        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                      />
                    </svg>
                    Loading contributions
                  </span>
                </td>
              </tr>
            ) : contributions.length === 0 ? (
              <tr>
                <td
                  colSpan={4}
                  className="px-[var(--space-6)] py-[var(--space-8)] text-center text-[var(--color-text-secondary)]"
                  style={{
                    fontSize: "var(--text-base)",
                    lineHeight: "24px",
                  }}
                >
                  No contributions have been recorded for this goal.
                </td>
              </tr>
            ) : (
              contributions.map((contribution) => (
                <tr
                  key={contribution.id}
                  className="border-b border-[var(--color-border-subtle)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] last:border-b-0 hover:bg-[var(--color-neutral-50)] active:bg-[var(--color-neutral-100)]"
                >
                  <td
                    className="px-[var(--space-6)] py-[var(--space-4)] text-[var(--color-text-primary)]"
                    style={{
                      fontSize: "var(--text-base)",
                      lineHeight: "24px",
                    }}
                  >
                    <time dateTime={contribution.date}>
                      {contribution.date}
                    </time>
                  </td>
                  <td
                    className="px-[var(--space-6)] py-[var(--space-4)] text-right font-[var(--font-mono)] tabular-nums text-[var(--color-text-primary)]"
                    style={{
                      fontSize: "var(--text-base)",
                      fontWeight: "var(--weight-semibold)",
                      lineHeight: "24px",
                    }}
                  >
                    {currencyFormatter.format(contribution.amount)}
                  </td>
                  <td className="px-[var(--space-6)] py-[var(--space-4)]">
                    <span
                      className={cn(
                        "inline-flex rounded-[var(--radius-full)] px-[var(--space-2)] py-[var(--space-1)]",
                        contribution.source === "auto-save"
                          ? "bg-[var(--color-success-50)] text-[var(--color-success-900)]"
                          : "bg-[var(--color-accent-50)] text-[var(--color-accent-900)]"
                      )}
                      style={{
                        fontSize: "var(--text-sm)",
                        fontWeight: "var(--weight-medium)",
                        lineHeight: "20px",
                      }}
                    >
                      {contribution.source === "auto-save"
                        ? "Auto-save"
                        : "Manual"}
                    </span>
                  </td>
                  <td
                    className="px-[var(--space-6)] py-[var(--space-4)] text-[var(--color-text-secondary)]"
                    style={{
                      fontSize: "var(--text-base)",
                      lineHeight: "24px",
                    }}
                  >
                    {contribution.description || "Personal contribution"}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </section>
  );
}