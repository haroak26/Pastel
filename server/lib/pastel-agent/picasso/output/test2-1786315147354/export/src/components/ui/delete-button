import React, { useState } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const deleteButtonVariants = cva(
  "inline-flex items-center justify-center gap-2 rounded-[var(--radius-md)] font-[var(--weight-medium)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      variant: {
        solid:
          "bg-[var(--color-danger-500)] text-[var(--color-text-inverse)] hover:bg-[var(--color-danger-900)] active:bg-[var(--color-danger-900)]",
        outline:
          "border border-[var(--color-danger-500)] text-[var(--color-danger-500)] hover:bg-[var(--color-danger-50)] active:bg-[var(--color-danger-50)]",
      },
      size: {
        sm: "h-[var(--control-sm)] px-3 text-sm",
        md: "h-[var(--control-md)] px-4 text-base",
        lg: "h-[var(--control-lg)] px-6 text-lg",
      },
    },
    defaultVariants: {
      variant: "solid",
      size: "md",
    },
  }
);

export interface DeleteButtonProps
  extends React.ButtonHTMLAttributes<HTMLButtonElement>,
    VariantProps<typeof deleteButtonVariants> {
  onClick: () => void;
  disabled?: boolean;
  label?: string;
  confirmMessage?: string;
  loading?: boolean;
}

export default function DeleteButton({
  className,
  variant,
  size,
  onClick,
  disabled = false,
  label = "Delete",
  confirmMessage,
  loading = false,
  ...props
}: DeleteButtonProps) {
  const [showConfirm, setShowConfirm] = useState(false);

  const handleClick = () => {
    if (confirmMessage && !showConfirm) {
      setShowConfirm(true);
      return;
    }
    onClick();
    setShowConfirm(false);
  };

  return (
    <button
      className={cn(deleteButtonVariants({ variant, size }), className)}
      disabled={disabled || loading}
      aria-busy={loading}
      onClick={handleClick}
      {...props}
    >
      {loading && (
        <svg
          className="animate-spin h-4 w-4"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle
            className="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            strokeWidth="4"
          />
          <path
            className="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
          />
        </svg>
      )}
      {showConfirm ? confirmMessage : label}
    </button>
  );
}