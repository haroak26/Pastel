// UserProfileMenu.tsx — Account switcher with profile actions and sign-out controls. Use in the Wavelength app shell for authenticated users.
import * as DropdownMenu from "@radix-ui/react-dropdown-menu";
import { cva, type VariantProps } from "class-variance-authority";
import { useState } from "react";
import { cn } from "../lib/cn";

const profileMenuTriggerVariants = cva(
  "inline-flex h-[var(--control-lg)] items-center gap-[var(--space-3)] rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] px-[var(--space-2)] pr-[var(--space-3)] font-[var(--font-body)] text-[var(--text-base)] text-[var(--color-text-primary)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=open]:bg-[var(--color-neutral-100)]",
  {
    variants: {},
  }
);

const profileMenuItemVariants = cva(
  "flex h-[var(--control-md)] w-full items-center rounded-[var(--radius-sm)] px-[var(--space-3)] text-left font-[var(--font-body)] text-[var(--text-base)] font-[var(--weight-medium)] outline-none transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] data-[highlighted]:bg-[var(--color-neutral-100)] data-[highlighted]:text-[var(--color-text-primary)] data-[disabled]:pointer-events-none data-[disabled]:opacity-50",
  {
    variants: {
      tone: {
        default: "text-[var(--color-text-secondary)] active:bg-[var(--color-neutral-200)]",
        danger:
          "text-[var(--color-danger-500)] active:bg-[var(--color-danger-50)] data-[highlighted]:bg-[var(--color-danger-50)] data-[highlighted]:text-[var(--color-danger-900)]",
      },
    },
    defaultVariants: {
      tone: "default",
    },
  }
);

export interface UserProfileMenuProps {
  user: {
    name: string;
    email: string;
    avatarUrl?: string;
  };
  menuItems: Array<{
    label: string;
    action: () => void;
    isDangerous?: boolean;
  }>;
  onMenuOpen?: () => void;
  loading?: boolean;
}

export default function UserProfileMenu({
  user,
  menuItems,
  onMenuOpen,
  loading = false,
}: UserProfileMenuProps) {
  const [open, setOpen] = useState(false);
  const initials = user.name
    .trim()
    .split(/\s+/)
    .map((part) => part[0])
    .join("")
    .slice(0, 2)
    .toUpperCase();

  function handleOpenChange(nextOpen: boolean) {
    setOpen(nextOpen);

    if (nextOpen) {
      onMenuOpen?.();
    }
  }

  return (
    <DropdownMenu.Root open={open} onOpenChange={handleOpenChange}>
      <DropdownMenu.Trigger
        className={cn(profileMenuTriggerVariants())}
        disabled={loading}
        aria-label={`Open account menu for ${user.name}`}
        aria-expanded={open}
        aria-busy={loading}
      >
        {loading ? (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        ) : user.avatarUrl ? (
          <img
            src={user.avatarUrl}
            alt=""
            className="h-[var(--control-md)] w-[var(--control-md)] rounded-[var(--radius-full)] object-cover"
          />
        ) : (
          <span
            className="inline-flex h-[var(--control-md)] w-[var(--control-md)] items-center justify-center rounded-[var(--radius-full)] bg-[var(--color-accent-50)] font-[var(--font-display)] text-[var(--text-sm)] font-[var(--weight-semibold)] text-[var(--color-accent-900)]"
            aria-hidden="true"
          >
            {initials}
          </span>
        )}

        <span className="hidden min-w-0 text-left sm:block">
          <span className="block truncate font-[var(--weight-semibold)]">
            {user.name}
          </span>
          <span className="block max-w-[calc(var(--space-24)*2)] truncate text-[var(--text-xs)] font-[var(--weight-regular)] text-[var(--color-text-muted)]">
            {user.email}
          </span>
        </span>

        <svg
          className="h-[var(--space-4)] w-[var(--space-4)] text-[var(--color-text-muted)]"
          viewBox="0 0 20 20"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            fillRule="evenodd"
            d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.51a.75.75 0 01-1.08 0l-4.25-4.51a.75.75 0 01.02-1.06z"
            clipRule="evenodd"
          />
        </svg>
      </DropdownMenu.Trigger>

      <DropdownMenu.Portal>
        <DropdownMenu.Content
          align="end"
          className="z-50 w-[calc(var(--space-24)*2)] rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] p-[var(--space-2)] shadow-[var(--shadow-md)] outline-none"
        >
          <div className="border-b border-[var(--color-border-subtle)] px-[var(--space-3)] py-[var(--space-3)]">
            <p className="truncate font-[var(--font-display)] text-[var(--text-sm)] font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
              {user.name}
            </p>
            <p className="mt-[var(--space-1)] truncate font-[var(--font-body)] text-[var(--text-xs)] text-[var(--color-text-muted)]">
              {user.email}
            </p>
          </div>

          <div className="pt-[var(--space-2)]">
            {menuItems.map((item) => (
              <DropdownMenu.Item
                key={item.label}
                className={cn(
                  profileMenuItemVariants({
                    tone: item.isDangerous ? "danger" : "default",
                  })
                )}
                onSelect={item.action}
              >
                {item.label}
              </DropdownMenu.Item>
            ))}
          </div>
        </DropdownMenu.Content>
      </DropdownMenu.Portal>
    </DropdownMenu.Root>
  );
}