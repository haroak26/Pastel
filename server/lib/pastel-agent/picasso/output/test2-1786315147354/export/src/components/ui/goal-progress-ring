// GoalProgressRing.tsx — Circular savings-goal progress indicator with current and target amounts. Use in goals summaries and dashboard progress moments.
import type { HTMLAttributes } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const goalProgressRingVariants = cva(
  "relative inline-flex shrink-0 items-center justify-center rounded-[var(--radius-xl)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-4)] font-[var(--font-body)] transition-all duration-[var(--duration-base)] ease-[var(--easing-standard)]",
  {
    variants: {
      size: {
        md: "h-[var(--space-12)] w-[var(--space-12)]",
        lg: "h-[var(--space-16)] w-[var(--space-16)]",
        xl: "h-[var(--space-24)] w-[var(--space-24)]",
      },
    },
    defaultVariants: {
      size: "lg",
    },
  }
);

export interface GoalProgressRingProps
  extends Omit<HTMLAttributes<HTMLDivElement>, "children">,
    VariantProps<typeof goalProgressRingVariants> {
  currentAmount: number;
  targetAmount: number;
  currencyCode?: string;
  loading?: boolean;
}

export default function GoalProgressRing({
  className,
  size,
  currentAmount,
  targetAmount,
  currencyCode,
  loading = false,
  ...props
}: GoalProgressRingProps) {
  const percentage =
    targetAmount > 0
      ? Math.min(100, Math.max(0, (currentAmount / targetAmount) * 100))
      : 0;
  const radius = 48;
  const circumference = 2 * Math.PI * radius;
  const dashOffset = circumference - (percentage / 100) * circumference;

  const formatAmount = (amount: number) => {
    if (currencyCode) {
      try {
        return new Intl.NumberFormat(undefined, {
          style: "currency",
          currency: currencyCode,
          maximumFractionDigits: 0,
        }).format(amount);
      } catch {
        return new Intl.NumberFormat(undefined, {
          maximumFractionDigits: 0,
        }).format(amount);
      }
    }

    return new Intl.NumberFormat(undefined, {
      maximumFractionDigits: 0,
    }).format(amount);
  };

  return (
    <div
      className={cn(goalProgressRingVariants({ size }), className)}
      role="progressbar"
      aria-busy={loading}
      aria-valuemin={0}
      aria-valuemax={100}
      aria-valuenow={loading ? undefined : percentage}
      aria-valuetext={
        loading
          ? undefined
          : `${Math.round(percentage)}% complete, ${formatAmount(
              currentAmount
            )} of ${formatAmount(targetAmount)}`
      }
      {...props}
    >
      <svg
        className="absolute inset-[var(--space-4)] h-[calc(100%-var(--space-8))] w-[calc(100%-var(--space-8))] -rotate-90"
        viewBox="0 0 120 120"
        fill="none"
        aria-hidden="true"
      >
        <circle
          cx="60"
          cy="60"
          r={radius}
          stroke="var(--color-neutral-200)"
          style={{ strokeWidth: "var(--space-1)" }}
        />
        <circle
          cx="60"
          cy="60"
          r={radius}
          stroke="var(--color-accent-500)"
          strokeDasharray={circumference}
          strokeDashoffset={loading ? circumference : dashOffset}
          strokeLinecap="round"
          style={{
            strokeWidth: "var(--space-1)",
            transition:
              "stroke-dashoffset var(--duration-slow) var(--easing-standard)",
          }}
        />
      </svg>

      <div className="relative flex flex-col items-center justify-center text-center">
        {loading ? (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              style={{ strokeWidth: "var(--space-1)" }}
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        ) : (
          <>
            <span className="font-[var(--font-display)] text-[length:var(--text-3xl)] font-[var(--weight-bold)] tabular-nums leading-none text-[var(--color-text-primary)]">
              {Math.round(percentage)}%
            </span>
            <span className="mt-[var(--space-2)] font-[var(--font-mono)] text-[length:var(--text-xs)] font-[var(--weight-medium)] tabular-nums text-[var(--color-text-muted)]">
              {formatAmount(currentAmount)} / {formatAmount(targetAmount)}
            </span>
          </>
        )}
      </div>
    </div>
  );
}