// EditTransactionForm.tsx — Form for updating a Wavelength transaction’s details. Use in transaction detail and review flows.
import { useEffect, useState, type FormEvent } from "react";
import { cva } from "class-variance-authority";
import { cn } from "../lib/cn";

const formVariants = cva(
  "rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] shadow-[var(--shadow-sm)]",
  {
    variants: {},
  }
);

const buttonVariants = cva(
  "inline-flex items-center justify-center gap-[var(--space-2)] rounded-[var(--radius-md)] font-[var(--weight-medium)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      variant: {
        primary:
          "bg-[var(--color-accent-500)] text-[var(--color-text-inverse)] hover:bg-[var(--color-accent-600)] active:bg-[var(--color-accent-700)]",
        secondary:
          "border border-[var(--color-border-default)] bg-[var(--color-neutral-100)] text-[var(--color-text-primary)] hover:bg-[var(--color-neutral-200)] active:bg-[var(--color-neutral-300)]",
      },
      size: {
        md: "h-[var(--control-md)] px-[var(--space-4)] text-[var(--text-base)]",
      },
    },
    defaultVariants: {
      variant: "primary",
      size: "md",
    },
  }
);

type Transaction = {
  id: string;
  category: string;
  amount: number;
  date: string;
  description?: string;
  tags?: string[];
};

export interface EditTransactionFormProps {
  transaction: Transaction;
  availableCategories: string[];
  onSave: (updates: Partial<Transaction>) => Promise<void>;
  onCancel: () => void;
  isLoading?: boolean;
  error?: string;
}

export default function EditTransactionForm({
  transaction,
  availableCategories,
  onSave,
  onCancel,
  isLoading = false,
  error,
}: EditTransactionFormProps) {
  const [category, setCategory] = useState(transaction.category);
  const [amount, setAmount] = useState(String(transaction.amount));
  const [date, setDate] = useState(transaction.date);
  const [description, setDescription] = useState(transaction.description ?? "");
  const [tags, setTags] = useState((transaction.tags ?? []).join(", "));

  useEffect(() => {
    setCategory(transaction.category);
    setAmount(String(transaction.amount));
    setDate(transaction.date);
    setDescription(transaction.description ?? "");
    setTags((transaction.tags ?? []).join(", "));
  }, [transaction]);

  async function handleSubmit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();

    await onSave({
      category,
      amount: Number(amount),
      date,
      description: description.trim() || undefined,
      tags: tags
        .split(",")
        .map((tag) => tag.trim())
        .filter(Boolean),
    });
  }

  const inputClassName =
    "w-full rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-background)] px-[var(--space-3)] text-[var(--text-base)] font-[var(--font-body)] text-[var(--color-text-primary)] outline-none transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] placeholder:text-[var(--color-text-muted)] hover:border-[var(--color-neutral-500)] focus-visible:border-[var(--color-border-focus)] focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:border-[var(--color-accent-500)] disabled:pointer-events-none disabled:opacity-50";

  const labelClassName =
    "mb-[var(--space-2)] block text-[var(--text-sm)] font-[var(--weight-medium)] text-[var(--color-text-primary)]";

  return (
    <form
      className={cn(formVariants())}
      onSubmit={handleSubmit}
      aria-busy={isLoading}
      noValidate
    >
      <div className="mb-[var(--space-6)] border-b border-[var(--color-border-subtle)] pb-[var(--space-4)]">
        <h2 className="font-[var(--font-display)] text-[var(--text-xl)] font-[var(--weight-semibold)] text-[var(--color-text-primary)]">
          Edit transaction
        </h2>
        <p className="mt-[var(--space-1)] font-[var(--font-body)] text-[var(--text-base)] text-[var(--color-text-secondary)]">
          Keep this spending entry accurate so your budget stays useful.
        </p>
      </div>

      <div className="grid grid-cols-1 gap-[var(--space-4)] md:grid-cols-2">
        <div>
          <label className={labelClassName} htmlFor="transaction-category">
            Category
          </label>
          <select
            id="transaction-category"
            className={cn(inputClassName, "h-[var(--control-md)]")}
            value={category}
            onChange={(event) => setCategory(event.target.value)}
            disabled={isLoading}
            required
          >
            {availableCategories.map((option) => (
              <option key={option} value={option}>
                {option}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label className={labelClassName} htmlFor="transaction-amount">
            Amount
          </label>
          <input
            id="transaction-amount"
            className={cn(
              inputClassName,
              "h-[var(--control-md)] font-[var(--font-mono)] tabular-nums"
            )}
            type="number"
            inputMode="decimal"
            min="0"
            step="0.01"
            value={amount}
            onChange={(event) => setAmount(event.target.value)}
            disabled={isLoading}
            required
          />
        </div>

        <div>
          <label className={labelClassName} htmlFor="transaction-date">
            Date
          </label>
          <input
            id="transaction-date"
            className={cn(inputClassName, "h-[var(--control-md)]")}
            type="date"
            value={date}
            onChange={(event) => setDate(event.target.value)}
            disabled={isLoading}
            required
          />
        </div>

        <div>
          <label className={labelClassName} htmlFor="transaction-tags">
            Tags
          </label>
          <input
            id="transaction-tags"
            className={cn(inputClassName, "h-[var(--control-md)]")}
            type="text"
            value={tags}
            onChange={(event) => setTags(event.target.value)}
            placeholder="commute, weekly"
            disabled={isLoading}
          />
        </div>

        <div className="md:col-span-2">
          <label className={labelClassName} htmlFor="transaction-description">
            Description
          </label>
          <textarea
            id="transaction-description"
            className={cn(inputClassName, "min-h-[var(--space-24)] py-[var(--space-2)]")}
            value={description}
            onChange={(event) => setDescription(event.target.value)}
            disabled={isLoading}
            rows={4}
          />
        </div>
      </div>

      {error && (
        <p
          className="mt-[var(--space-4)] rounded-[var(--radius-sm)] border border-[var(--color-danger-500)] bg-[var(--color-danger-50)] px-[var(--space-3)] py-[var(--space-2)] font-[var(--font-body)] text-[var(--text-sm)] text-[var(--color-danger-900)]"
          role="alert"
        >
          {error}
        </p>
      )}

      <div className="mt-[var(--space-6)] flex flex-col-reverse gap-[var(--space-3)] border-t border-[var(--color-border-subtle)] pt-[var(--space-4)] sm:flex-row sm:justify-end">
        <button
          type="button"
          className={cn(buttonVariants({ variant: "secondary", size: "md" }))}
          onClick={onCancel}
          disabled={isLoading}
        >
          Cancel
        </button>

        <button
          type="submit"
          className={cn(buttonVariants({ variant: "primary", size: "md" }))}
          disabled={isLoading}
          aria-busy={isLoading}
        >
          {isLoading && (
            <svg
              className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <circle
                className="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                strokeWidth="4"
              />
              <path
                className="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
              />
            </svg>
          )}
          {isLoading ? "Saving changes" : "Save changes"}
        </button>
      </div>
    </form>
  );
}