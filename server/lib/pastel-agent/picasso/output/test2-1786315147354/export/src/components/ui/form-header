// FormHeader.tsx — Page heading with a focused back action for goal creation and other Wavelength form flows.
import { cva } from "class-variance-authority";
import type { ButtonHTMLAttributes } from "react";
import { cn } from "../lib/cn";

const formHeaderVariants = cva(
  "inline-flex items-center justify-center gap-[var(--space-2)] rounded-[var(--radius-md)] font-[var(--weight-medium)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {},
  }
);

export interface FormHeaderProps {
  title: string;
  subtitle?: string;
  onBack: () => void;
  loading?: boolean;
  backButtonProps?: Omit<
    ButtonHTMLAttributes<HTMLButtonElement>,
    "onClick" | "children" | "disabled"
  >;
}

export default function FormHeader({
  title,
  subtitle,
  onBack,
  loading = false,
  backButtonProps,
}: FormHeaderProps) {
  return (
    <header className="flex flex-col gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] pb-[var(--space-6)]">
      <button
        type="button"
        className={cn(
          formHeaderVariants(),
          "h-[var(--control-sm)] self-start px-[var(--space-2)] text-[var(--color-text-secondary)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)]",
          backButtonProps?.className
        )}
        onClick={onBack}
        disabled={loading || backButtonProps?.disabled}
        aria-label="Go back"
        aria-busy={loading}
        {...backButtonProps}
      >
        {loading ? (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        ) : (
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)]"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="2"
            strokeLinecap="round"
            strokeLinejoin="round"
            aria-hidden="true"
          >
            <path d="m15 18-6-6 6-6" />
          </svg>
        )}
        <span className="text-[var(--text-sm)]">Back</span>
      </button>

      <div className="flex max-w-[var(--space-24)] flex-col gap-[var(--space-2)]">
        <h1 className="font-[var(--font-display)] text-[var(--text-3xl)] font-[var(--weight-semibold)] leading-[1.2] text-[var(--color-text-primary)]">
          {title}
        </h1>
        {subtitle && (
          <p className="font-[var(--font-body)] text-[var(--text-base)] font-[var(--weight-regular)] text-[var(--color-text-secondary)]">
            {subtitle}
          </p>
        )}
      </div>
    </header>
  );
}