// MainNavigation.tsx — Wavelength’s vertical route navigation for moving between core budgeting areas.
import { cva, type VariantProps } from "class-variance-authority";
import type { MouseEvent, ReactNode } from "react";
import { cn } from "../lib/cn";

const navigationVariants = cva(
  "flex min-h-full flex-col rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] font-[var(--font-body)] shadow-[var(--shadow-sm)] transition-[width] duration-[var(--duration-base)] ease-[var(--easing-standard)]",
  {
    variants: {
      width: {
        collapsed:
          "w-[calc(var(--space-16)+var(--space-4))] items-center px-[var(--space-2)] py-[var(--space-4)]",
        expanded:
          "w-[calc(var(--space-16)+var(--space-12)+var(--space-8))] px-[var(--space-3)] py-[var(--space-4)]",
      },
    },
    defaultVariants: {
      width: "expanded",
    },
  }
);

export interface MainNavigationItem {
  id: string;
  label: string;
  icon: ReactNode;
  href: string;
}

export interface MainNavigationProps
  extends VariantProps<typeof navigationVariants> {
  items: MainNavigationItem[];
  activeItemId: string;
  onNavigate: (itemId: string) => void;
  loading?: boolean;
}

export default function MainNavigation({
  className,
  width,
  items,
  activeItemId,
  onNavigate,
  loading = false,
}: MainNavigationProps) {
  const isCollapsed = width === "collapsed";

  const handleNavigate = (
    event: MouseEvent<HTMLAnchorElement>,
    itemId: string
  ) => {
    if (loading) {
      event.preventDefault();
      return;
    }

    event.preventDefault();
    onNavigate(itemId);
  };

  return (
    <aside
      className={cn(navigationVariants({ width }), className)}
      aria-label="Wavelength navigation"
      aria-busy={loading}
    >
      <nav className="flex flex-1 flex-col gap-[var(--space-2)]" aria-label="Main">
        {items.map((item) => {
          const isActive = item.id === activeItemId;

          return (
            <a
              key={item.id}
              href={item.href}
              onClick={(event) => handleNavigate(event, item.id)}
              aria-current={isActive ? "page" : undefined}
              aria-label={isCollapsed ? item.label : undefined}
              aria-disabled={loading}
              className={cn(
                "group flex min-h-[var(--control-lg)] items-center rounded-[var(--radius-md)] border border-transparent transition-[background-color,color,border-color] duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:translate-y-[var(--space-1)] aria-disabled:pointer-events-none aria-disabled:opacity-50",
                isCollapsed
                  ? "w-[var(--control-lg)] justify-center"
                  : "gap-[var(--space-3)] px-[var(--space-3)]",
                isActive
                  ? "border-[var(--color-accent-100)] bg-[var(--color-accent-50)] text-[var(--color-accent-900)]"
                  : "text-[var(--color-text-secondary)] hover:border-[var(--color-border-subtle)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)]"
              )}
            >
              {loading && isActive ? (
                <svg
                  className="h-[var(--space-4)] w-[var(--space-4)] animate-[spin_var(--duration-slow)_var(--easing-standard)_infinite]"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <circle
                    className="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    strokeWidth="4"
                  />
                  <path
                    className="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
                  />
                </svg>
              ) : (
                <span
                  className="flex h-[var(--space-6)] w-[var(--space-6)] shrink-0 items-center justify-center"
                  aria-hidden="true"
                >
                  {item.icon}
                </span>
              )}

              {!isCollapsed && (
                <span className="[font:var(--text-base)_var(--font-body)] font-[var(--weight-medium)]">
                  {item.label}
                </span>
              )}
            </a>
          );
        })}
      </nav>
    </aside>
  );
}