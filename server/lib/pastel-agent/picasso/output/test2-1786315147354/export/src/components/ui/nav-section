// NavSection.tsx — Group related Wavelength navigation items with an optional collapsible section header.
import type { ReactNode } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const navItemVariants = cva(
  "group inline-flex min-h-[var(--control-md)] w-full items-center gap-[var(--space-3)] rounded-[var(--radius-md)] px-[var(--space-3)] font-[var(--font-body)] text-[var(--text-sm)] font-[var(--weight-medium)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:scale-[0.98] disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      active: {
        true: "bg-[var(--color-accent-50)] text-[var(--color-accent-900)]",
        false:
          "text-[var(--color-text-secondary)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)]",
      },
    },
    defaultVariants: {
      active: false,
    },
  }
);

const sectionToggleVariants = cva(
  "inline-flex min-h-[var(--control-md)] w-full items-center justify-between gap-[var(--space-3)] rounded-[var(--radius-md)] px-[var(--space-3)] font-[var(--font-body)] text-[var(--text-xs)] font-[var(--weight-semibold)] tracking-wide text-[var(--color-text-muted)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)] disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      expanded: {
        true: "text-[var(--color-text-primary)]",
        false: "text-[var(--color-text-muted)]",
      },
    },
    defaultVariants: {
      expanded: true,
    },
  }
);

export interface NavSectionItem {
  id: string;
  label: string;
  icon: ReactNode;
  href: string;
  isActive?: boolean;
}

export interface NavSectionProps
  extends Omit<React.HTMLAttributes<HTMLElement>, "title">,
    VariantProps<typeof navItemVariants> {
  title?: string;
  items: NavSectionItem[];
  isCollapsible?: boolean;
  isExpanded?: boolean;
  onToggle?: () => void;
  loading?: boolean;
}

export default function NavSection({
  className,
  title,
  items,
  isCollapsible = false,
  isExpanded = true,
  onToggle,
  loading = false,
  ...props
}: NavSectionProps) {
  const visibleItems = !isCollapsible || isExpanded;

  return (
    <nav
      className={cn(
        "flex w-full flex-col gap-[var(--space-1)] font-[var(--font-body)]",
        loading && "pointer-events-none opacity-50",
        className
      )}
      aria-busy={loading}
      {...props}
    >
      {title &&
        (isCollapsible ? (
          <button
            type="button"
            className={cn(
              sectionToggleVariants({ expanded: isExpanded }),
              loading && "pointer-events-none opacity-50"
            )}
            aria-expanded={isExpanded}
            aria-controls={`${title.toLowerCase().replace(/\s+/g, "-")}-navigation`}
            disabled={loading}
            onClick={onToggle}
          >
            <span>{title}</span>
            <svg
              className={cn(
                "h-[var(--space-4)] w-[var(--space-4)] transition-transform duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
                isExpanded && "rotate-180"
              )}
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="m5 7.5 5 5 5-5"
                stroke="currentColor"
                strokeWidth="1.75"
                strokeLinecap="round"
                strokeLinejoin="round"
              />
            </svg>
          </button>
        ) : (
          <div className="px-[var(--space-3)] py-[var(--space-2)] text-[var(--text-xs)] font-[var(--weight-semibold)] tracking-wide text-[var(--color-text-muted)]">
            {title}
          </div>
        ))}

      {loading ? (
        <div
          className="flex min-h-[var(--control-md)] items-center gap-[var(--space-3)] px-[var(--space-3)] text-[var(--text-sm)] text-[var(--color-text-muted)]"
          role="status"
          aria-label="Loading navigation"
        >
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="12"
              cy="12"
              r="9"
              stroke="currentColor"
              strokeOpacity="0.25"
              strokeWidth="3"
            />
            <path
              d="M21 12a9 9 0 0 0-9-9"
              stroke="currentColor"
              strokeWidth="3"
              strokeLinecap="round"
            />
          </svg>
        </div>
      ) : (
        visibleItems && (
          <div
            id={
              title
                ? `${title.toLowerCase().replace(/\s+/g, "-")}-navigation`
                : undefined
            }
            className="flex flex-col gap-[var(--space-1)]"
          >
            {items.map((item) => (
              <a
                key={item.id}
                href={item.href}
                aria-current={item.isActive ? "page" : undefined}
                className={cn(
                  navItemVariants({ active: item.isActive }),
                  item.isActive &&
                    "border-l-2 border-[var(--color-accent-500)] pl-[calc(var(--space-3)-2px)]"
                )}
              >
                <span
                  className={cn(
                    "flex h-[var(--space-4)] w-[var(--space-4)] shrink-0 items-center justify-center",
                    item.isActive
                      ? "text-[var(--color-accent-500)]"
                      : "text-[var(--color-text-muted)] group-hover:text-[var(--color-text-primary)]"
                  )}
                  aria-hidden="true"
                >
                  {item.icon}
                </span>
                <span className="min-w-0 truncate">{item.label}</span>
              </a>
            ))}
          </div>
        )
      )}
    </nav>
  );
}