// AccountSection.tsx — Account controls for password changes, connected money accounts, data export, and sign out.
import React, { useState } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const accountSectionVariants = cva(
  "w-full rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] p-[var(--space-6)] font-[var(--font-body)] text-[var(--color-text-primary)] shadow-[var(--shadow-sm)]"
);

const actionVariants = cva(
  "inline-flex items-center justify-center gap-[var(--space-2)] rounded-[var(--radius-md)] px-[var(--space-4)] font-[var(--weight-medium)] text-[var(--text-sm)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--color-surface-raised)] disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      tone: {
        neutral:
          "border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] text-[var(--color-text-primary)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)]",
        danger:
          "border border-[var(--color-danger-500)] bg-[var(--color-danger-500)] text-[var(--color-text-inverse)] hover:bg-[var(--color-danger-900)] active:bg-[var(--color-danger-900)]",
      },
      size: {
        sm: "h-[var(--control-sm)]",
        md: "h-[var(--control-md)]",
      },
    },
    defaultVariants: {
      tone: "neutral",
      size: "md",
    },
  }
);

interface ActionButtonProps
  extends React.ButtonHTMLAttributes<HTMLButtonElement>,
    VariantProps<typeof actionVariants> {
  loading?: boolean;
}

export interface AccountSectionProps
  extends React.HTMLAttributes<HTMLElement>,
    VariantProps<typeof accountSectionVariants> {
  onChangePassword?: () => void;
  onExportData?: () => Promise<void>;
  onLogout: () => void;
  linkedAccounts?: Array<{
    id: string;
    name: string;
    connected: boolean;
  }>;
}

function ActionButton({
  className,
  tone,
  size,
  loading = false,
  disabled,
  children,
  ...props
}: ActionButtonProps) {
  return (
    <button
      className={cn(actionVariants({ tone, size }), className)}
      disabled={disabled || loading}
      aria-busy={loading}
      {...props}
    >
      {loading && (
        <svg
          className="h-[var(--space-4)] w-[var(--space-4)] animate-[spin_var(--duration-slow)_linear_infinite]"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle
            className="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            strokeWidth="4"
          />
          <path
            className="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
          />
        </svg>
      )}
      {children}
    </button>
  );
}

export default function AccountSection({
  className,
  onChangePassword,
  onExportData,
  onLogout,
  linkedAccounts = [],
  ...props
}: AccountSectionProps) {
  const [exporting, setExporting] = useState(false);

  const handleExportData = async () => {
    if (!onExportData || exporting) return;

    setExporting(true);
    try {
      await onExportData();
    } finally {
      setExporting(false);
    }
  };

  return (
    <section
      className={cn(accountSectionVariants(), className)}
      aria-labelledby="account-section-heading"
      {...props}
    >
      <div className="flex flex-col gap-[var(--space-2)] border-b border-[var(--color-border-subtle)] pb-[var(--space-6)]">
        <h2
          id="account-section-heading"
          className="font-[var(--font-display)] text-[var(--text-xl)] font-[var(--weight-semibold)] tracking-[-0.02em]"
        >
          Account &amp; connections
        </h2>
        <p className="max-w-2xl text-[var(--text-base)] font-[var(--weight-regular)] text-[var(--color-text-secondary)]">
          Keep your Wavelength account secure and manage the money connections
          behind your budget.
        </p>
      </div>

      <div className="border-b border-[var(--color-border-subtle)] py-[var(--space-6)]">
        <div className="flex flex-col gap-[var(--space-4)] sm:flex-row sm:items-center sm:justify-between">
          <div className="flex flex-col gap-[var(--space-1)]">
            <h3 className="text-[var(--text-base)] font-[var(--weight-semibold)]">
              Password
            </h3>
            <p className="text-[var(--text-sm)] text-[var(--color-text-secondary)]">
              Update your password if it has been a while.
            </p>
          </div>
          {onChangePassword && (
            <ActionButton
              type="button"
              size="sm"
              onClick={onChangePassword}
              aria-label="Change your Wavelength password"
            >
              Change password
            </ActionButton>
          )}
        </div>
      </div>

      <div className="border-b border-[var(--color-border-subtle)] py-[var(--space-6)]">
        <div className="flex flex-col gap-[var(--space-4)]">
          <div className="flex flex-col gap-[var(--space-1)]">
            <h3 className="text-[var(--text-base)] font-[var(--weight-semibold)]">
              Linked accounts
            </h3>
            <p className="text-[var(--text-sm)] text-[var(--color-text-secondary)]">
              Accounts available for spending insights and budget check-ins.
            </p>
          </div>

          <div className="divide-y divide-[var(--color-border-subtle)]">
            {linkedAccounts.map((account) => (
              <div
                key={account.id}
                className="flex items-center justify-between gap-[var(--space-4)] py-[var(--space-3)] first:pt-0 last:pb-0"
              >
                <span className="text-[var(--text-base)] font-[var(--weight-medium)]">
                  {account.name}
                </span>
                <span
                  className={cn(
                    "rounded-[var(--radius-full)] px-[var(--space-3)] py-[var(--space-1)] text-[var(--text-xs)] font-[var(--weight-medium)]",
                    account.connected
                      ? "bg-[var(--color-success-50)] text-[var(--color-success-900)]"
                      : "bg-[var(--color-neutral-100)] text-[var(--color-text-muted)]"
                  )}
                >
                  {account.connected ? "Connected" : "Not connected"}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div className="border-b border-[var(--color-border-subtle)] py-[var(--space-6)]">
        <div className="flex flex-col gap-[var(--space-4)] sm:flex-row sm:items-center sm:justify-between">
          <div className="flex flex-col gap-[var(--space-1)]">
            <h3 className="text-[var(--text-base)] font-[var(--weight-semibold)]">
              Your Wavelength data
            </h3>
            <p className="text-[var(--text-sm)] text-[var(--color-text-secondary)]">
              Download a copy of your budgets, goals, transactions, and streaks.
            </p>
          </div>
          {onExportData && (
            <ActionButton
              type="button"
              size="sm"
              onClick={handleExportData}
              loading={exporting}
              aria-label="Export your Wavelength data"
            >
              {exporting ? "Preparing export" : "Export data"}
            </ActionButton>
          )}
        </div>
      </div>

      <div className="flex flex-col gap-[var(--space-4)] pt-[var(--space-6)] sm:flex-row sm:items-center sm:justify-between">
        <div className="flex flex-col gap-[var(--space-1)]">
          <h3 className="text-[var(--text-base)] font-[var(--weight-semibold)]">
            Sign out
          </h3>
          <p className="text-[var(--text-sm)] text-[var(--color-text-secondary)]">
            End this session on the current device.
          </p>
        </div>
        <ActionButton
          type="button"
          tone="danger"
          size="sm"
          onClick={onLogout}
          aria-label="Sign out of Wavelength"
        >
          Sign out
        </ActionButton>
      </div>
    </section>
  );
}