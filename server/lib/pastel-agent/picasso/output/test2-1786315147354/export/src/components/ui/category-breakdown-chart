// CategoryBreakdownChart.tsx — Horizontal spending breakdown for comparing Wavelength budget categories at a glance.
import type { CSSProperties, HTMLAttributes } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const categoryBreakdownChartVariants = cva(
  "w-full overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] font-[var(--font-body)] text-[var(--color-text-primary)] shadow-[var(--shadow-sm)]"
);

export interface CategoryBreakdownChartProps
  extends HTMLAttributes<HTMLDivElement>,
    VariantProps<typeof categoryBreakdownChartVariants> {
  categories: Array<{
    name: string;
    amount: number;
    percentage: number;
    color: string;
  }>;
  totalSpent: number;
  currencyCode?: string;
  isLoading?: boolean;
}

function formatAmount(amount: number, currencyCode?: string) {
  if (!currencyCode) {
    return new Intl.NumberFormat(undefined, {
      maximumFractionDigits: 2,
    }).format(amount);
  }

  try {
    return new Intl.NumberFormat(undefined, {
      style: "currency",
      currency: currencyCode,
      maximumFractionDigits: 2,
    }).format(amount);
  } catch {
    return `${currencyCode.toUpperCase()} ${new Intl.NumberFormat(undefined, {
      maximumFractionDigits: 2,
    }).format(amount)}`;
  }
}

export default function CategoryBreakdownChart({
  className,
  categories,
  totalSpent,
  currencyCode,
  isLoading = false,
  ...props
}: CategoryBreakdownChartProps) {
  const isEmpty = !isLoading && categories.length === 0;

  return (
    <figure
      className={cn(categoryBreakdownChartVariants(), className)}
      aria-busy={isLoading}
      {...props}
    >
      <figcaption className="mb-[var(--space-6)] flex items-end justify-between gap-[var(--space-4)] border-b border-[var(--color-border-subtle)] pb-[var(--space-4)]">
        <div>
          <p className="font-[var(--font-body)] text-sm font-[var(--weight-medium)] text-[var(--color-text-muted)]">
            Spending by category
          </p>
          <p className="mt-[var(--space-1)] font-[var(--font-display)] text-2xl font-[var(--weight-semibold)] tabular-nums text-[var(--color-text-primary)]">
            {formatAmount(totalSpent, currencyCode)}
          </p>
        </div>
        <span className="rounded-[var(--radius-full)] bg-[var(--color-accent-50)] px-[var(--space-3)] py-[var(--space-1)] font-[var(--font-mono)] text-xs font-[var(--weight-medium)] text-[var(--color-accent-600)]">
          {currencyCode ? currencyCode.toUpperCase() : "Total"}
        </span>
      </figcaption>

      {isLoading && (
        <div
          className="space-y-[var(--space-4)]"
          aria-label="Loading spending categories"
        >
          <div className="flex items-center gap-[var(--space-3)]">
            <span className="h-[var(--space-4)] w-[var(--space-12)] animate-pulse rounded-[var(--radius-sm)] bg-[var(--color-neutral-200)]" />
            <span className="h-[var(--space-2)] flex-1 animate-pulse rounded-[var(--radius-full)] bg-[var(--color-neutral-200)]" />
          </div>
          <div className="flex items-center gap-[var(--space-3)]">
            <span className="h-[var(--space-4)] w-[var(--space-8)] animate-pulse rounded-[var(--radius-sm)] bg-[var(--color-neutral-200)]" />
            <span className="h-[var(--space-2)] flex-[0.72] animate-pulse rounded-[var(--radius-full)] bg-[var(--color-neutral-200)]" />
          </div>
          <div className="flex items-center gap-[var(--space-3)]">
            <span className="h-[var(--space-4)] w-[var(--space-6)] animate-pulse rounded-[var(--radius-sm)] bg-[var(--color-neutral-200)]" />
            <span className="h-[var(--space-2)] flex-[0.48] animate-pulse rounded-[var(--radius-full)] bg-[var(--color-neutral-200)]" />
          </div>
        </div>
      )}

      {isEmpty && (
        <div className="border-l-2 border-[var(--color-border-default)] py-[var(--space-4)] pl-[var(--space-4)]">
          <p className="font-[var(--font-body)] text-base text-[var(--color-text-secondary)]">
            No spending categories yet.
          </p>
        </div>
      )}

      {!isLoading && !isEmpty && (
        <div className="divide-y divide-[var(--color-border-subtle)]">
          {categories.map((category) => {
            const percentage = Math.min(
              100,
              Math.max(0, Number.isFinite(category.percentage) ? category.percentage : 0)
            );
            const fillStyle = {
              "--category-color": category.color,
              width: `${percentage}%`,
            } as CSSProperties;

            return (
              <div
                key={category.name}
                className="grid grid-cols-[minmax(0,1fr)_auto] gap-[var(--space-4)] py-[var(--space-4)] first:pt-0 last:pb-0"
              >
                <div className="min-w-0">
                  <div className="mb-[var(--space-2)] flex items-baseline justify-between gap-[var(--space-3)]">
                    <span className="truncate text-base font-[var(--weight-medium)] text-[var(--color-text-primary)]">
                      {category.name}
                    </span>
                    <span className="shrink-0 font-[var(--font-mono)] text-sm tabular-nums text-[var(--color-text-muted)]">
                      {percentage}%
                    </span>
                  </div>
                  <div
                    className="h-[var(--space-2)] overflow-hidden rounded-[var(--radius-full)] bg-[var(--color-neutral-100)]"
                    role="progressbar"
                    aria-label={`${category.name} spending share`}
                    aria-valuemin={0}
                    aria-valuemax={100}
                    aria-valuenow={percentage}
                  >
                    <div
                      className="h-full rounded-[var(--radius-full)] bg-[var(--category-color)] transition-[width] duration-[var(--duration-base)] ease-[var(--easing-standard)]"
                      style={fillStyle}
                    />
                  </div>
                </div>
                <span className="self-end font-[var(--font-mono)] text-sm font-[var(--weight-medium)] tabular-nums text-[var(--color-text-primary)]">
                  {formatAmount(category.amount, currencyCode)}
                </span>
              </div>
            );
          })}
        </div>
      )}
    </figure>
  );
}