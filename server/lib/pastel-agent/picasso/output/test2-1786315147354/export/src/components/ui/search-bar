// SearchBar.tsx — Transaction search input for filtering merchant names and descriptions. Use in dashboard transaction lists and activity views.
import type { InputHTMLAttributes } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const searchBarVariants = cva(
  "flex h-[var(--control-md)] items-center gap-[var(--space-3)] rounded-[var(--radius-md)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] px-[var(--space-4)] font-[var(--font-body)] font-[var(--weight-regular)] transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:border-[var(--color-neutral-500)] focus-within:border-[var(--color-border-focus)] focus-within:ring-2 focus-within:ring-[var(--color-border-focus)] focus-within:ring-offset-2 active:border-[var(--color-accent-600)] disabled:pointer-events-none disabled:opacity-50"
);

export interface SearchBarProps
  extends Omit<
      InputHTMLAttributes<HTMLInputElement>,
      "value" | "onChange" | "disabled"
    >,
    VariantProps<typeof searchBarVariants> {
  placeholder?: string;
  value?: string;
  onChange: (query: string) => void;
  onClear?: () => void;
  disabled?: boolean;
  loading?: boolean;
}

export default function SearchBar({
  className,
  placeholder,
  value,
  onChange,
  onClear,
  disabled = false,
  loading = false,
  id,
  ...props
}: SearchBarProps) {
  const inputId = id ?? "transaction-search";
  const canClear = Boolean(value) && Boolean(onClear);

  return (
    <div
      className={cn(searchBarVariants(), className)}
      aria-busy={loading}
    >
      {loading ? (
        <svg
          className="h-[var(--space-4)] w-[var(--space-4)] shrink-0 animate-spin text-[var(--color-accent-500)]"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle
            className="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            strokeWidth="4"
          />
          <path
            className="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
          />
        </svg>
      ) : (
        <svg
          className="h-[var(--space-4)] w-[var(--space-4)] shrink-0 text-[var(--color-text-muted)]"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          strokeWidth="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7" />
          <path strokeLinecap="round" d="m20 20-4-4" />
        </svg>
      )}

      <input
        id={inputId}
        className="min-w-0 flex-1 bg-transparent font-[var(--font-body)] text-[var(--color-text-primary)] outline-none placeholder:text-[var(--color-text-muted)] disabled:pointer-events-none disabled:opacity-50"
        type="search"
        placeholder={placeholder}
        value={value}
        onChange={(event) => onChange(event.target.value)}
        disabled={disabled || loading}
        aria-label="Search transactions by merchant or description"
        aria-busy={loading}
        {...props}
      />

      {canClear && (
        <button
          type="button"
          className="inline-flex h-[var(--control-sm)] w-[var(--control-sm)] shrink-0 items-center justify-center rounded-[var(--radius-sm)] text-[var(--color-text-muted)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 active:bg-[var(--color-neutral-200)] disabled:pointer-events-none disabled:opacity-50"
          onClick={onClear}
          disabled={disabled || loading}
          aria-label="Clear transaction search"
        >
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)]"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            strokeWidth="2"
            aria-hidden="true"
          >
            <path strokeLinecap="round" d="M6 6l12 12M18 6 6 18" />
          </svg>
        </button>
      )}
    </div>
  );
}