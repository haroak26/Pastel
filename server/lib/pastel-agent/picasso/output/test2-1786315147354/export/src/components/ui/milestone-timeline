// MilestoneTimeline.tsx — Progress timeline for showing earned savings milestones and unlock dates in Wavelength.
import type { ReactNode } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const timelineVariants = cva(
  "relative w-full overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border-subtle)] bg-[var(--color-surface-raised)] p-[var(--space-6)] text-[var(--color-text-primary)]",
  {
    variants: {},
  }
);

const milestoneVariants = cva(
  "relative z-10 flex min-w-0 flex-col items-center gap-[var(--space-2)] text-center transition-all duration-[var(--duration-base)] ease-[var(--easing-standard)]",
  {
    variants: {
      status: {
        earned:
          "text-[var(--color-success-900)] hover:text-[var(--color-accent-600)] active:text-[var(--color-accent-700)]",
        pending:
          "text-[var(--color-text-muted)] hover:text-[var(--color-text-secondary)] active:text-[var(--color-text-primary)]",
      },
    },
    defaultVariants: {
      status: "pending",
    },
  }
);

export interface MilestoneTimelineProps
  extends VariantProps<typeof timelineVariants> {
  milestones: Array<{
    percentage: number;
    label: string;
    earned: boolean;
    earnedDate?: string;
    icon: ReactNode;
  }>;
  currentProgress: number;
  loading?: boolean;
  className?: string;
}

export default function MilestoneTimeline({
  milestones,
  currentProgress,
  loading = false,
  className,
}: MilestoneTimelineProps) {
  const progress = Math.min(100, Math.max(0, currentProgress));

  return (
    <section
      className={cn(timelineVariants(), className)}
      aria-busy={loading}
      aria-label={`Milestone timeline at ${progress}% progress`}
    >
      {loading ? (
        <div className="flex items-center justify-center py-[var(--space-8)]">
          <svg
            className="size-[var(--space-4)] animate-spin text-[var(--color-accent-500)]"
            style={{ animationDuration: "var(--duration-slow)" }}
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
        </div>
      ) : (
        <div
          className="relative min-h-[var(--control-lg)]"
          role="progressbar"
          aria-valuemin={0}
          aria-valuemax={100}
          aria-valuenow={progress}
          aria-label={`${progress}% progress`}
        >
          <div
            className="absolute left-[var(--space-2)] right-[var(--space-2)] top-[var(--space-4)] h-[var(--space-1)] rounded-[var(--radius-full)] bg-[var(--color-neutral-200)]"
            aria-hidden="true"
          >
            <div
              className="h-full rounded-[var(--radius-full)] bg-[var(--color-accent-500)] transition-[width] duration-[var(--duration-slow)] ease-[var(--easing-standard)]"
              style={{ width: `${progress}%` }}
            />
          </div>

          <ol className="relative flex items-start justify-between gap-[var(--space-3)]">
            {milestones.map((milestone) => {
              const percentage = Math.min(
                100,
                Math.max(0, milestone.percentage)
              );

              return (
                <li
                  key={`${milestone.percentage}-${milestone.label}`}
                  className={cn(
                    milestoneVariants({
                      status: milestone.earned ? "earned" : "pending",
                    })
                  )}
                  style={{ flex: "1 1 0%" }}
                  aria-label={`${milestone.label}, ${percentage}%${
                    milestone.earnedDate
                      ? `, earned ${milestone.earnedDate}`
                      : ""
                  }`}
                >
                  <span
                    className={cn(
                      "flex size-[var(--control-md)] items-center justify-center rounded-[var(--radius-full)] border transition-all duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
                      "focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2",
                      milestone.earned
                        ? "border-[var(--color-success-500)] bg-[var(--color-success-50)] text-[var(--color-success-500)]"
                        : "border-[var(--color-border-default)] bg-[var(--color-surface-raised)] text-[var(--color-text-muted)]"
                    )}
                    aria-hidden="true"
                  >
                    {milestone.icon}
                  </span>

                  <span
                    className="max-w-[var(--space-16)] font-[var(--weight-semibold)]"
                    style={{
                      font: "var(--text-sm) var(--font-body)",
                      fontWeight: "var(--weight-semibold)",
                    }}
                  >
                    {milestone.label}
                  </span>

                  <span
                    className="font-[var(--weight-medium)] tabular-nums text-[var(--color-text-muted)]"
                    style={{
                      font: "var(--text-xs) var(--font-mono)",
                      fontWeight: "var(--weight-medium)",
                    }}
                  >
                    {milestone.earnedDate ?? `${percentage}%`}
                  </span>
                </li>
              );
            })}
          </ol>
        </div>
      )}
    </section>
  );
}