// NotificationIcon.tsx — Bell control with an unread count badge for alert access. Use in Wavelength app headers and dashboard navigation.
import * as React from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const notificationIconVariants = cva(
  "relative inline-flex h-[var(--control-md)] aspect-square items-center justify-center rounded-[var(--radius-full)] font-[var(--font-body)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] text-[var(--color-text-secondary)] hover:bg-[var(--color-neutral-100)] hover:text-[var(--color-text-primary)] active:bg-[var(--color-neutral-200)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50"
);

export interface NotificationIconProps
  extends Omit<
      React.ButtonHTMLAttributes<HTMLButtonElement>,
      "onClick" | "children"
    >,
    VariantProps<typeof notificationIconVariants> {
  count?: number;
  onClick?: () => void;
  loading?: boolean;
}

export default function NotificationIcon({
  className,
  count = 0,
  onClick,
  loading = false,
  disabled,
  "aria-label": ariaLabel,
  ...props
}: NotificationIconProps) {
  const accessibleLabel =
    ariaLabel ??
    (count > 0
      ? `View ${count} unread notification${count === 1 ? "" : "s"}`
      : "View notifications");

  return (
    <button
      type="button"
      className={cn(notificationIconVariants(), className)}
      onClick={onClick}
      disabled={disabled || loading}
      aria-label={accessibleLabel}
      aria-busy={loading}
      {...props}
    >
      {loading ? (
        <svg
          className="h-[var(--space-6)] w-[var(--space-6)] animate-spin"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <circle
            className="opacity-25"
            cx="12"
            cy="12"
            r="10"
            stroke="currentColor"
            strokeWidth="2"
          />
          <path
            className="opacity-75"
            fill="currentColor"
            d="M4 12a8 8 0 018-8v2.5A5.5 5.5 0 006.5 12H4z"
          />
        </svg>
      ) : (
        <svg
          className="h-[var(--space-6)] w-[var(--space-6)]"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          strokeWidth="1.8"
          strokeLinecap="round"
          strokeLinejoin="round"
          aria-hidden="true"
        >
          <path d="M18 8a6 6 0 00-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
          <path d="M10 21h4" />
        </svg>
      )}

      {!loading && count > 0 && (
        <span
          className="absolute -right-[var(--space-1)] -top-[var(--space-1)] flex min-h-[var(--control-sm)] min-w-[var(--control-sm)] items-center justify-center rounded-[var(--radius-full)] border-2 border-[var(--color-surface-raised)] bg-[var(--color-accent-500)] px-[var(--space-1)] font-[var(--font-mono)] text-[length:var(--text-xs)] leading-[var(--space-4)] font-[var(--weight-semibold)] tabular-nums text-[var(--color-text-inverse)]"
          aria-hidden="true"
        >
          {count > 99 ? "99+" : count}
        </span>
      )}
    </button>
  );
}