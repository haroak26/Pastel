// GoalsList.tsx — Displays active and completed savings goals with progress, deadlines, and goal actions.
import type { ButtonHTMLAttributes } from "react";
import { cva, type VariantProps } from "class-variance-authority";
import { cn } from "../lib/cn";

const goalsListVariants = cva(
  "w-full rounded-[var(--radius-lg)] border border-[var(--color-border-default)] bg-[var(--color-surface-raised)] font-[var(--font-body)] text-[var(--color-text-primary)]",
  {
    variants: {
      layout: {
        list: "divide-y divide-[var(--color-border-subtle)]",
        grid:
          "grid grid-cols-1 gap-[var(--space-3)] p-[var(--space-3)] md:grid-cols-2",
      },
      filter: {
        all: "",
        active: "",
        completed: "",
      },
    },
    defaultVariants: {
      layout: "list",
      filter: "all",
    },
  }
);

export interface Goal {
  id: string;
  name: string;
  targetAmount: number;
  currentAmount: number;
  deadline: string;
  status: "active" | "completed";
  category?: string;
}

export interface GoalsListProps
  extends VariantProps<typeof goalsListVariants> {
  goals: Goal[];
  onGoalClick?: (goalId: string) => void;
  onEdit?: (goalId: string) => void;
  onDelete?: (goalId: string) => void;
  isLoading?: boolean;
  className?: string;
}

const actionButtonVariants = cva(
  "inline-flex h-[var(--control-sm)] items-center justify-center rounded-[var(--radius-sm)] border border-transparent px-[var(--space-2)] text-[var(--text-sm)] font-[var(--weight-medium)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50",
  {
    variants: {
      tone: {
        neutral:
          "text-[var(--color-text-secondary)] hover:border-[var(--color-border-default)] hover:bg-[var(--color-neutral-100)] active:bg-[var(--color-neutral-200)]",
        danger:
          "text-[var(--color-danger-500)] hover:border-[var(--color-danger-500)] hover:bg-[var(--color-danger-50)] active:bg-[var(--color-danger-50)]",
      },
    },
    defaultVariants: {
      tone: "neutral",
    },
  }
);

function formatCurrency(amount: number) {
  return new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 0,
  }).format(amount);
}

function formatDeadline(deadline: string) {
  const date = new Date(deadline);

  if (Number.isNaN(date.getTime())) {
    return deadline;
  }

  return new Intl.DateTimeFormat("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  }).format(date);
}

function getProgress(goal: Goal) {
  if (goal.targetAmount <= 0) {
    return goal.status === "completed" ? 100 : 0;
  }

  return Math.min(
    100,
    Math.max(0, (goal.currentAmount / goal.targetAmount) * 100)
  );
}

export default function GoalsList({
  goals,
  layout,
  filter,
  onGoalClick,
  onEdit,
  onDelete,
  isLoading = false,
  className,
}: GoalsListProps) {
  const visibleGoals = goals.filter((goal) => {
    if (filter === "active") {
      return goal.status === "active";
    }

    if (filter === "completed") {
      return goal.status === "completed";
    }

    return true;
  });

  if (isLoading) {
    return (
      <section
        className={cn(
          goalsListVariants({ layout, filter }),
          "flex min-h-[var(--control-lg)] items-center justify-center p-[var(--space-6)]",
          className
        )}
        aria-busy="true"
        aria-live="polite"
        aria-label="Loading goals"
      >
        <div className="flex items-center gap-[var(--space-2)] text-[var(--text-sm)] text-[var(--color-text-secondary)]">
          <svg
            className="h-[var(--space-4)] w-[var(--space-4)] animate-spin"
            style={{ animationDuration: "var(--duration-slow)" }}
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              className="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              strokeWidth="4"
            />
            <path
              className="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"
            />
          </svg>
          <span>Loading your goals</span>
        </div>
      </section>
    );
  }

  if (visibleGoals.length === 0) {
    return (
      <section
        className={cn(
          goalsListVariants({ layout, filter }),
          "p-[var(--space-6)]",
          className
        )}
        aria-live="polite"
      >
        <div className="border-l-4 border-[var(--color-accent-500)] pl-[var(--space-4)]">
          <p className="font-[var(--font-display)] text-[var(--text-lg)] font-[var(--weight-semibold)]">
            No goals match this filter
          </p>
          <p className="mt-[var(--space-1)] text-[var(--text-base)] text-[var(--color-text-secondary)]">
            Try another view to see more of your savings plan.
          </p>
        </div>
      </section>
    );
  }

  return (
    <section
      className={cn(goalsListVariants({ layout, filter }), className)}
      aria-busy="false"
      aria-label="Savings goals"
    >
      {visibleGoals.map((goal) => {
        const progress = getProgress(goal);
        const isCompleted = goal.status === "completed";

        return (
          <article
            key={goal.id}
            className={cn(
              "group flex min-w-0 flex-col gap-[var(--space-4)] p-[var(--space-4)] transition-colors duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
              layout === "list" &&
                "sm:flex-row sm:items-center sm:justify-between",
              layout === "grid" &&
                "rounded-[var(--radius-md)] border border-[var(--color-border-subtle)] hover:bg-[var(--color-neutral-50)]"
            )}
          >
            <button
              type="button"
              className={cn(
                "min-w-0 flex-1 text-left focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-border-focus)] focus-visible:ring-offset-2",
                !onGoalClick && "cursor-default"
              )}
              onClick={() => onGoalClick?.(goal.id)}
              disabled={!onGoalClick}
              aria-label={`View ${goal.name} goal`}
            >
              <div className="flex min-w-0 items-start justify-between gap-[var(--space-3)]">
                <div className="min-w-0">
                  <div className="flex flex-wrap items-center gap-[var(--space-2)]">
                    <h3 className="truncate font-[var(--font-display)] text-[var(--text-lg)] font-[var(--weight-semibold)]">
                      {goal.name}
                    </h3>
                    <span
                      className={cn(
                        "rounded-[var(--radius-full)] px-[var(--space-2)] py-[var(--space-1)] text-[var(--text-xs)] font-[var(--weight-medium)]",
                        isCompleted
                          ? "bg-[var(--color-success-50)] text-[var(--color-success-900)]"
                          : "bg-[var(--color-accent-50)] text-[var(--color-accent-900)]"
                      )}
                    >
                      {isCompleted ? "Completed" : "Active"}
                    </span>
                  </div>

                  <div className="mt-[var(--space-1)] flex flex-wrap items-center gap-x-[var(--space-3)] gap-y-[var(--space-1)] text-[var(--text-sm)] text-[var(--color-text-secondary)]">
                    {goal.category && <span>{goal.category}</span>}
                    <span>Due {formatDeadline(goal.deadline)}</span>
                  </div>
                </div>

                <span className="shrink-0 font-[var(--font-mono)] text-[var(--text-sm)] tabular-nums text-[var(--color-text-secondary)]">
                  {Math.round(progress)}%
                </span>
              </div>

              <div className="mt-[var(--space-4)] h-[var(--space-2)] overflow-hidden rounded-[var(--radius-full)] bg-[var(--color-neutral-200)]">
                <div
                  className={cn(
                    "h-full rounded-[var(--radius-full)] transition-[width] duration-[var(--duration-slow)] ease-[var(--easing-standard)]",
                    isCompleted
                      ? "bg-[var(--color-success-500)]"
                      : "bg-[var(--color-accent-500)]"
                  )}
                  style={{ width: `${progress}%` }}
                  role="progressbar"
                  aria-valuemin={0}
                  aria-valuemax={100}
                  aria-valuenow={Math.round(progress)}
                  aria-label={`${goal.name} progress`}
                />
              </div>

              <div className="mt-[var(--space-2)] flex items-center justify-between gap-[var(--space-3)] text-[var(--text-sm)]">
                <span className="font-[var(--font-mono)] tabular-nums text-[var(--color-text-primary)]">
                  {formatCurrency(goal.currentAmount)} saved
                </span>
                <span className="font-[var(--font-mono)] tabular-nums text-[var(--color-text-muted)]">
                  {formatCurrency(goal.targetAmount)} target
                </span>
              </div>
            </button>

            <div
              className="flex shrink-0 items-center gap-[var(--space-1)] sm:self-center"
              role="group"
              aria-label={`Actions for ${goal.name}`}
            >
              <button
                type="button"
                className={cn(actionButtonVariants({ tone: "neutral" }))}
                onClick={() => onEdit?.(goal.id)}
                disabled={!onEdit}
                aria-label={`Edit ${goal.name}`}
              >
                Edit
              </button>
              <button
                type="button"
                className={cn(actionButtonVariants({ tone: "danger" }))}
                onClick={() => onDelete?.(goal.id)}
                disabled={!onDelete}
                aria-label={`Delete ${goal.name}`}
              >
                Delete
              </button>
            </div>
          </article>
        );
      })}
    </section>
  );
}